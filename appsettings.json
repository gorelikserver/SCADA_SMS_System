{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.\\PULSESQLEXPRESS;Database=bat_yam;User Id=sa;Password=pulse;TrustServerCertificate=true;MultipleActiveResultSets=true;Connect Timeout=5;",
    "BackupConnection": "Server=localhost;Database=SCADA_SMS;Integrated Security=true;TrustServerCertificate=true;"
  },
  "SmsSettings": {
    "RateLimit": 10,
    "RateWindow": 60,
    "DuplicateWindow": 5,
    "TimeoutSeconds": 30,
    "RetryAttempts": 3,
    "ScadaPcimObjectId": 198,
    "TestMode": false,
    "LogSoapXml": false
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Information",
        "SCADASMSSystem.Web.Services": "Verbose",
        "SCADASMSSystem.Web.Services.SmsService": "Verbose",
        "SCADASMSSystem.Web.Services.AuditService": "Debug",
        "System.Net.Http.HttpClient": "Verbose",
        "System.Net.Http.HttpClient.Default.LogicalHandler": "Verbose",
        "System.Net.Http.HttpClient.Default.ClientHandler": "Verbose"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information",
      "SCADASMSSystem.Web.Services": "Debug"
    },
    "File": {
      "Path": "C:\\SCADA\\Logs\\scada-sms-.log",
      "FileSizeLimitBytes": 10485760,
      "RetainedFileCountLimit": 31,
      "RollingInterval": "Day"
    },
    "EventLog": {
      "SourceName": "SCADA SMS System",
      "LogName": "Application"
    }
  },
  "HealthChecks": {
    "QueueSizeThreshold": 100,
    "MemoryThresholdMB": 500,
    "ResponseTimeThresholdMs": 1000,
    "DatabaseTimeoutSeconds": 30,
    "SmsApiTimeoutSeconds": 30
  },
  "Features": {
    "EnableTestEndpoints": true,
    "EnableDetailedLogging": true,
    "EnableMetrics": true,
    "EnableHealthChecks": true,
    "EnableAuditCleanup": true
  },
  "Database": {
    "CommandTimeoutSeconds": 30,
    "ConnectionPoolSize": 100,
    "EnableSensitiveDataLogging": false,
    "EnableRetryOnFailure": true,
    "MaxRetryCount": 3,
    "MaxRetryDelay": "00:00:30"
  },
  "BackgroundService": {
    "ProcessingIntervalMs": 100,
    "StatisticsIntervalMs": 5000,
    "CleanupIntervalHours": 24,
    "QueueWarningThreshold": 50,
    "QueueCriticalThreshold": 100
  },
  "ScadaSpool": {
    "Root": "",
    "PollSeconds": 30,
    "MinAgeSeconds": 150,
    "MaxAgeMinutes": 60
  },
  "Security": {
    "EnableHttpsRedirection": false,
    "RequireHttps": false,
    "EnableCors": false,
    "AllowedHosts": "*",
    "EnableRequestLogging": true
  },
  "Performance": {
    "EnableResponseCaching": true,
    "CacheDurationMinutes": 5,
    "EnableResponseCompression": true,
    "MaxConcurrentRequests": 100
  },
  "Maintenance": {
    "AuditRetentionDays": 90,
    "LogRetentionDays": 30,
    "EnableAutomaticCleanup": true,
    "CleanupSchedule": "02:00",
    "BackupSchedule": "03:00"
  }
}
