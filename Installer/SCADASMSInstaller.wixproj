<Project Sdk="WixToolset.Sdk/4.0.5">
  <PropertyGroup>
    <OutputName>SCADA_SMS_v2.4.3_Setup</OutputName>
    <ProductVersion>2.4.3</ProductVersion>
    <Platform>x64</Platform>
    <Cultures>en-US</Cultures>
    <SuppressIces>ICE91</SuppressIces>
  </PropertyGroup>

  <!-- curl.exe is optional: ship it in [INSTALLDIR]Tools only when the build staged it.
       Scada_sms.bat falls back to the Windows built-in curl.exe otherwise. -->
  <PropertyGroup>
    <BundleCurl>false</BundleCurl>
    <BundleCurl Condition="Exists('$(MSBuildProjectDirectory)\..\deployment_package\InstallerSrc\Tools\curl.exe')">true</BundleCurl>
    <DefineConstants>$(DefineConstants);BundleCurl=$(BundleCurl)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext"       Version="4.0.5" />
    <PackageReference Include="WixToolset.Util.wixext"     Version="4.0.5" />
    <PackageReference Include="WixToolset.Firewall.wixext" Version="4.0.5" />
  </ItemGroup>

  <!-- Pre-generated harvest file (created by build.bat before dotnet build) -->
  <ItemGroup>
    <Compile Include="obj\$(Configuration)\HarvestedFiles.wxs"
             Condition="Exists('obj\$(Configuration)\HarvestedFiles.wxs')" />
  </ItemGroup>

</Project>






































