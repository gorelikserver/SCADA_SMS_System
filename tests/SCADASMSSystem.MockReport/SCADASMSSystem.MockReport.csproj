<Project Sdk="Microsoft.NET.Sdk">

  <!-- Builds the offline HTML + Markdown report of the mock integration suite from the evidence
       JSON the tests write. Usage: SCADASMSSystem.MockReport.exe (results folder) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
