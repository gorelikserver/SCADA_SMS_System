@page
@model IndexModel
@{
    ViewData["Title"] = "Operations overview";
}

@if (Model.TestModeActive)
{
    <div class="environment-banner" role="status">
        <i class="fas fa-flask"></i><strong>Test mode</strong>
        Provider calls are routed to the configured test path. No production delivery should be assumed.
    </div>
}

<div class="operations-overview">
    <header class="overview-heading">
        <div>
            <p class="overview-kicker">Operations</p>
            <h1>Alarm delivery overview</h1>
            <p>Monitor the SCADA-to-provider pipeline and act on delivery exceptions.</p>
        </div>
        <div class="overview-actions">
            <span class="last-sync">Updated <strong id="lastUpdated">@DateTime.Now.ToString("HH:mm:ss")</strong></span>
            <button class="btn btn-outline-primary" type="button" onclick="refreshHealthStatus()"><i class="fas fa-rotate me-1"></i>Refresh</button>
            <a class="btn btn-primary" href="/Alerts"><i class="fas fa-triangle-exclamation me-1"></i>Review alerts</a>
        </div>
    </header>

    <section class="operations-metrics" aria-label="Delivery status">
        <article class="operation-metric metric-health" id="smsHealthCard">
            <div class="metric-topline"><span>Delivery worker</span><i class="fas fa-wave-square" id="smsHealthIcon"></i></div>
            <div class="metric-primary" id="smsHealthStatus">
                @if (Model.Dashboard.SmsServiceStatus.IsHealthy) { <span class="state-pill state-good"><i class="fas fa-circle-check"></i>Healthy</span> }
                else { <span class="state-pill state-warning"><i class="fas fa-triangle-exclamation"></i>Attention</span> }
            </div>
            <p id="smsHealthDetails">Queue <strong id="smsQueueSize">@Model.Dashboard.SmsServiceStatus.QueueSize</strong> · Uptime <strong id="smsUptime">@Model.Dashboard.SmsServiceStatus.ServiceUptime.ToString(@"d\.hh\:mm\:ss")</strong></p>
        </article>
        <article class="operation-metric metric-danger">
            <div class="metric-topline"><span>Failed deliveries</span><i class="fas fa-circle-xmark"></i></div>
            <div class="metric-number" id="messagesFailed">@Model.Dashboard.SmsServiceStatus.MessagesFailed</div>
            <p>Since the delivery worker started</p>
        </article>
        <article class="operation-metric">
            <div class="metric-topline"><span>Queued messages</span><i class="fas fa-list-check"></i></div>
            <div class="metric-number" id="detailedQueueSize">@Model.Dashboard.SmsServiceStatus.QueueSize</div>
            <p>Waiting for provider processing</p>
        </article>
        <article class="operation-metric">
            <div class="metric-topline"><span>Accepted by provider</span><i class="fas fa-paper-plane"></i></div>
            <div class="metric-number" id="messagesToday">@Model.Dashboard.SmsServiceStatus.MessagesSent</div>
            <p>Since the delivery worker started</p>
        </article>
    </section>

    <div class="overview-grid">
        <section class="overview-panel activity-panel">
            <div class="panel-heading">
                <div><p class="panel-eyebrow">Live delivery log</p><h2>Recent activity</h2></div>
                <a href="/Audit">View delivery history <i class="fas fa-arrow-right"></i></a>
            </div>
            <div class="table-responsive">
                <table class="table activity-table align-middle mb-0">
                    <thead><tr><th>Time</th><th>Delivery</th><th>Recipient</th><th>Status</th></tr></thead>
                    <tbody id="recentActivityTable"><tr><td colspan="4" class="empty-row"><i class="fas fa-spinner fa-spin me-2"></i>Loading recent activity…</td></tr></tbody>
                </table>
            </div>
        </section>

        <aside class="overview-panel pipeline-panel">
            <div class="panel-heading"><div><p class="panel-eyebrow">Pipeline</p><h2>Runtime details</h2></div></div>
            <dl class="runtime-list">
                <div><dt>Rate limit</dt><dd id="rateLimit">@Model.Dashboard.SmsServiceStatus.RateLimit/min</dd></div>
                <div><dt>Deduplication</dt><dd id="deduplication">@(Model.Dashboard.SmsServiceStatus.DeduplicationEnabled ? "Enabled" : "Disabled")</dd></div>
                <div><dt>Last message</dt><dd id="lastMessage">@(Model.Dashboard.SmsServiceStatus.LastMessageTime?.ToString("HH:mm:ss") ?? "Never")</dd></div>
                <div><dt>Server time</dt><dd id="serverTime">@DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")</dd></div>
            </dl>
            @if (User.IsInRole(SCADASMSSystem.Web.Models.AccountRoles.Admin))
            {
                <div class="pipeline-actions">
                    <a href="/Settings"><i class="fas fa-plug"></i><span><strong>Integration settings</strong><small>Provider, SCADA and delivery policy</small></span><i class="fas fa-chevron-right"></i></a>
                    <a href="/Test/Sms"><i class="fas fa-vial"></i><span><strong>Run delivery test</strong><small>Exercise the configured route safely</small></span><i class="fas fa-chevron-right"></i></a>
                </div>
            }
        </aside>
    </div>

    <section class="routing-summary" aria-label="Routing readiness">
        <div><p class="panel-eyebrow">Routing readiness</p><h2>People and teams</h2><p>Recipients and notification teams available to routing rules.</p></div>
        <div class="routing-stat"><span id="activeUsersCount">@Model.Dashboard.ActiveUsers</span><small>Active recipients</small></div>
        <div class="routing-stat"><span id="activeGroupsCount">@Model.Dashboard.ActiveGroups</span><small>Notification teams</small></div>
        @if (User.IsInRole(SCADASMSSystem.Web.Models.AccountRoles.Admin))
        {
            <a class="btn btn-outline-primary" href="/Alarms/ManageGroups">Manage routing rules</a>
        }
    </section>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Update server time every second
            setInterval(function() {
                const now = new Date();
                document.getElementById('serverTime').textContent = now.toLocaleString();
                document.getElementById('lastUpdated').textContent = now.toLocaleTimeString();
            }, 1000);

            // Load real dashboard data
            loadDashboardData();
            loadRecentActivity();
            
            // Auto-refresh dashboard data every 30 seconds
            setInterval(loadDashboardData, 30000);
            setInterval(loadRecentActivity, 60000); // Refresh activity every minute
        });

        function loadDashboardData() {
            fetch('/?handler=RefreshData')
                .then(response => response.json())
                .then(data => {
                    updateSmsHealthStatus(data.smsService);
                    updateStatistics(data.stats);
                })
                .catch(error => {
                    console.error('Error loading dashboard data:', error);
                });
        }

        function loadRecentActivity() {
            fetch('/?handler=RecentActivity')
                .then(response => response.json())
                .then(data => {
                    updateRecentActivity(data.activities);
                })
                .catch(error => {
                    console.error('Error loading recent activity:', error);
                    document.getElementById('recentActivityTable').innerHTML = 
                        '<tr><td colspan="4" class="text-center text-muted">Error loading recent activity</td></tr>';
                });
        }

        function updateRecentActivity(activities) {
            const tbody = document.getElementById('recentActivityTable');
            
            if (!activities || activities.length === 0) {
                tbody.innerHTML = '<tr><td colspan="4" class="text-center text-muted">No recent activity</td></tr>';
                return;
            }

            tbody.innerHTML = activities.map(activity => `
                <tr>
                    <td class="text-nowrap">${activity.time}</td>
                    <td>${activity.action}</td>
                    <td>${activity.user}</td>
                    <td><span class="${activity.statusClass}">${activity.status}</span></td>
                </tr>
            `).join('');
        }

        function updateSmsHealthStatus(smsService) {
            // Update main health status
            const healthCard = document.getElementById('smsHealthCard');
            const healthStatus = document.getElementById('smsHealthStatus');
            const healthIcon = document.getElementById('smsHealthIcon');
            
            let statusHtml, stateClass, iconClass;
            
            if (smsService.isHealthy) {
                statusHtml = '<span class="state-pill state-good"><i class="fas fa-circle-check"></i>Healthy</span>';
                stateClass = 'is-healthy';
                iconClass = 'fas fa-wave-square';
            } else if (smsService.queueSize < 100) {
                statusHtml = '<span class="state-pill state-warning"><i class="fas fa-clock"></i>Busy</span>';
                stateClass = 'is-warning';
                iconClass = 'fas fa-wave-square';
            } else {
                statusHtml = '<span class="state-pill state-danger"><i class="fas fa-triangle-exclamation"></i>Overloaded</span>';
                stateClass = 'is-danger';
                iconClass = 'fas fa-wave-square';
            }
            
            healthStatus.innerHTML = statusHtml;
            healthCard.classList.remove('is-healthy', 'is-warning', 'is-danger');
            healthCard.classList.add(stateClass);
            healthIcon.className = iconClass;
            
            // Update details
            document.getElementById('smsQueueSize').textContent = smsService.queueSize;
            document.getElementById('smsUptime').textContent = smsService.uptime;
            document.getElementById('detailedQueueSize').textContent = smsService.queueSize;
            document.getElementById('rateLimit').textContent = smsService.rateLimit + '/min';
            document.getElementById('deduplication').innerHTML = 
                smsService.deduplicationEnabled ? 
                '<span class="text-success">Enabled</span>' : 
                '<span class="text-warning">Disabled</span>';
            document.getElementById('lastMessage').textContent = smsService.lastMessageTime || 'Never';
            document.getElementById('messagesToday').textContent = smsService.messagesSent;
            document.getElementById('messagesFailed').textContent = smsService.messagesFailed;
        }

        function updateStatistics(stats) {
            document.getElementById('activeUsersCount').textContent = stats.activeUsers;
            document.getElementById('activeGroupsCount').textContent = stats.activeGroups;
        }

        function refreshHealthStatus() {
            const refreshBtn = event.target.closest('button');
            const originalHTML = refreshBtn.innerHTML;
            refreshBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Refreshing...';
            refreshBtn.disabled = true;
            
            loadDashboardData();
            
            setTimeout(() => {
                refreshBtn.innerHTML = originalHTML;
                refreshBtn.disabled = false;
            }, 1000);
        }

        // Health status opens the operational exception queue.
        document.getElementById('smsHealthCard').addEventListener('click', function() {
            window.location.href = '/Alerts';
        });

        // Add hover effect to health card
        document.getElementById('smsHealthCard').style.cursor = 'pointer';
    </script>
}
