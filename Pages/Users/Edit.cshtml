@page "{id:int}"
@model SCADASMSSystem.Web.Pages.Users.EditModel
@{
    ViewData["Title"] = "Edit User";
}

@section Breadcrumb {
<div class="breadcrumb-bar">
    <div class="container-fluid px-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-page="/Index"><i class="fas fa-home me-1"></i>Dashboard</a></li>
                <li class="breadcrumb-item"><a asp-page="/Users/Index">Users</a></li>
                <li class="breadcrumb-item active">Edit</li>
            </ol>
        </nav>
    </div>
</div>
}

<div class="container-fluid">
    <!-- Page Heading -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">
            <i class="fas fa-user-edit me-2"></i>Edit User
        </h1>
        <a href="/Users" class="d-none d-sm-inline-block btn btn-sm btn-secondary shadow-sm">
            <i class="fas fa-arrow-left fa-sm text-white-50"></i> Back to Users
        </a>
    </div>

    <div class="row" x-data="userForm()">
        <div class="col-lg-8">
            <!-- User Edit Form -->
            <div class="card shadow mb-4">
                <div class="card-header card-header-gradient py-3">
                    <h6 class="m-0 fw-bold">
                        <i class="fas fa-user-cog me-2"></i>User Information
                    </h6>
                </div>
                <div class="card-body">
                    <form method="post" @@submit="handleSubmit($event)" id="editUserForm">
                        <input type="hidden" asp-for="UserInput.UserId" />
                        <input type="hidden" asp-for="UserInput.OriginalEmail" />
                        <input type="hidden" asp-for="UserInput.OriginalPhoneNumber" />
                        
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="UserInput.UserName" class="form-label required"></label>
                                <input asp-for="UserInput.UserName" class="form-control" placeholder="Enter full name"
                                       @@change="hasChanges = true">
                                <span asp-validation-for="UserInput.UserName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="UserInput.PhoneNumber" class="form-label required"></label>
                                <input asp-for="UserInput.PhoneNumber" type="tel" class="form-control" placeholder="+1-555-0123"
                                       @@input="validatePhone($el); hasChanges = true"
                                       :class="phoneError ? 'is-invalid' : ''">
                                <div class="invalid-feedback" x-text="phoneError"></div>
                                <span asp-validation-for="UserInput.PhoneNumber" class="text-danger small"></span>
                                @if (Model.UserInput.PhoneNumber != Model.UserInput.OriginalPhoneNumber)
                                {
                                    <div class="form-text text-warning">
                                        <i class="fas fa-exclamation-triangle me-1"></i>
                                        Phone number has been changed
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label asp-for="UserInput.Email" class="form-label"></label>
                                <input asp-for="UserInput.Email" type="email" class="form-control" placeholder="user@company.com (optional)">
                                <span asp-validation-for="UserInput.Email" class="text-danger"></span>
                                @if (!string.IsNullOrWhiteSpace(Model.UserInput.Email) && Model.UserInput.Email != Model.UserInput.OriginalEmail)
                                {
                                    <div class="form-text text-warning">
                                        <i class="fas fa-exclamation-triangle me-1"></i>
                                        Email address has been changed
                                    </div>
                                }
                                else
                                {
                                    <div class="form-text">
                                        <i class="fas fa-envelope me-1"></i>
                                        Email is optional but recommended for notifications
                                    </div>
                                }
                            </div>
                        </div>

                        <hr>

                        <h6 class="font-weight-bold text-primary mb-3">
                            <i class="fas fa-cog me-2"></i>Notification Settings
                        </h6>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <div class="form-check form-switch">
                                    <input asp-for="UserInput.SmsEnabled" class="form-check-input" type="checkbox" role="switch">
                                    <label asp-for="UserInput.SmsEnabled" class="form-check-label">
                                        <strong>Enable SMS Notifications</strong>
                                    </label>
                                </div>
                                <div class="form-text">
                                    <i class="fas fa-mobile-alt me-1"></i>
                                    User will receive SMS alerts during system events and alarms
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <div class="form-check form-switch">
                                    <input asp-for="UserInput.SpecialDaysEnabled" class="form-check-input" type="checkbox" role="switch">
                                    <label asp-for="UserInput.SpecialDaysEnabled" class="form-check-label">
                                        <strong>Available on Special Days/Holidays</strong>
                                    </label>
                                </div>
                                <div class="form-text">
                                    <i class="fas fa-calendar-check me-1"></i>
                                    User is available to work during Jewish holidays and sabbatical days
                                </div>
                            </div>
                        </div>

                        <hr>

                        <!-- Personal Data for SOAP SMS (optional) -->
                        <div class="mb-3">
                            <p class="text-muted mb-2" style="font-size:0.83rem;">
                                <i class="fas fa-id-card me-1 text-info"></i>
                                <strong>Personal Data</strong> — optional, used by SOAP SMS providers (e.g., Sheba Ensemble)
                            </p>
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <label asp-for="UserInput.TZ" class="form-label"></label>
                                    <input asp-for="UserInput.TZ" class="form-control" placeholder="e.g. 012345678" />
                                    <span asp-validation-for="UserInput.TZ" class="text-danger small"></span>
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="UserInput.FirstName" class="form-label"></label>
                                    <input asp-for="UserInput.FirstName" class="form-control" placeholder="First name" />
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="UserInput.LastName" class="form-label"></label>
                                    <input asp-for="UserInput.LastName" class="form-control" placeholder="Last name" />
                                </div>
                            </div>
                        </div>

                        <hr>

                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-2">
                                <a href="/Users" class="btn btn-secondary">
                                    <i class="fas fa-times me-2"></i>Cancel
                                </a>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@Model.UserInput.UserId" id="deleteUserForm" class="mb-0">
                                    <button type="button" class="btn btn-outline-danger"
                                            data-user-name="@Model.UserInput.UserName"
                                            onclick="confirmDeleteUser(this)">
                                        <i class="fas fa-trash me-2"></i>Delete User
                                    </button>
                                </form>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span x-show="hasChanges" class="badge bg-warning text-dark">
                                    <i class="fas fa-exclamation-circle me-1"></i>Unsaved changes
                                </span>
                                <button type="submit" class="btn btn-primary" :disabled="loading">
                                    <span x-show="loading" class="spinner-border spinner-border-sm me-1" role="status"></span>
                                    <i class="fas fa-save me-2" x-show="!loading"></i>
                                    <span x-text="loading ? 'Saving...' : 'Update User'"></span>
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- User Details -->
            <div class="card shadow mb-4">
                <div class="card-header card-header-gradient py-3">
                    <h6 class="m-0 fw-bold">
                        <i class="fas fa-info-circle me-2"></i>User Details
                    </h6>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small font-weight-bold">User ID:</span>
                        <span class="badge bg-secondary text-white">@Model.UserInput.UserId</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small font-weight-bold">SMS Status:</span>
                        <span class="badge @(Model.UserInput.SmsEnabled ? "bg-success text-white" : "bg-secondary text-white")">
                            <i class="fas @(Model.UserInput.SmsEnabled ? "fa-bell" : "fa-bell-slash") me-1"></i>
                            @(Model.UserInput.SmsEnabled ? "Enabled" : "Disabled")
                        </span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small font-weight-bold">Holiday Work:</span>
                        <span class="badge @(Model.UserInput.SpecialDaysEnabled ? "bg-warning text-dark" : "bg-secondary text-white")">
                            <i class="fas @(Model.UserInput.SpecialDaysEnabled ? "fa-calendar-check" : "fa-calendar-times") me-1"></i>
                            @(Model.UserInput.SpecialDaysEnabled ? "Available" : "Not Available")
                        </span>
                    </div>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="card shadow mb-4">
                <div class="card-header card-header-gradient py-3">
                    <h6 class="m-0 fw-bold">
                        <i class="fas fa-bolt me-2"></i>Quick Actions
                    </h6>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="/Audit?userId=@Model.UserInput.UserId" class="btn btn-outline-primary btn-sm">
                            <i class="fas fa-history me-2"></i>View SMS History
                        </a>
                        <a href="/Groups?userId=@Model.UserInput.UserId" class="btn btn-outline-success btn-sm">
                            <i class="fas fa-users me-2"></i>Manage Group Membership
                        </a>
                        <button type="button" class="btn btn-outline-info btn-sm" onclick="testSms()">
                            <i class="fas fa-paper-plane me-2"></i>Send Test SMS
                        </button>
                    </div>
                </div>
            </div>

            <!-- Activity Log -->
            <div class="card shadow">
                <div class="card-header card-header-gradient py-3">
                    <h6 class="m-0 fw-bold">
                        <i class="fas fa-clock me-2"></i>Recent Activity
                    </h6>
                </div>
                <div class="card-body">
                    <div class="timeline">
                        <div class="timeline-item">
                            <div class="timeline-marker bg-primary"></div>
                            <div class="timeline-content">
                                <p class="small mb-0">User accessed</p>
                                <small class="text-muted">Just now</small>
                            </div>
                        </div>
                        <!-- Add more timeline items as needed -->
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/alpine.min.js" defer></script>
    <script>
        function userForm() {
            return {
                loading: false,
                hasChanges: false,
                phoneError: '',
                init() {
                    window.addEventListener('beforeunload', (e) => {
                        if (this.hasChanges) {
                            e.preventDefault();
                            e.returnValue = '';
                        }
                    });
                    document.getElementById('editUserForm').addEventListener('submit', () => {
                        this.hasChanges = false;
                    });
                },
                validatePhone(el) {
                    const val = el.value;
                    if (val && !/^[+\d\s\-()\u200f]+$/.test(val)) {
                        this.phoneError = 'Only digits, +, spaces, and hyphens allowed';
                    } else {
                        this.phoneError = '';
                        el.value = val.replace(/[^+\d\s\-()\u200f]/g, '');
                    }
                },
                handleSubmit(e) {
                    if (this.phoneError) {
                        e.preventDefault();
                        SCADAUtils.showToast('<i class="fas fa-exclamation-circle me-2"></i>Fix validation errors before submitting.', 'danger');
                        return;
                    }
                    this.hasChanges = false;
                    this.loading = true;
                }
            };
        }

        async function confirmDeleteUser(btn) {
            const userName = btn.dataset.userName;
            const confirmed = await SCADAUtils.confirmModal(
                'Delete User',
                `Delete "${userName}"? This removes them from all groups and cannot be undone.`,
                'Delete User'
            );
            if (confirmed) {
                document.getElementById('deleteUserForm').submit();
            }
        }

        async function testSms() {
            const userId = @Model.UserInput.UserId;
            const userName = '@Html.Raw(Model.UserInput.UserName?.Replace("'", "\\'"))';
            const confirmed = await SCADAUtils.confirmModal(
                'Send Test SMS',
                `Send a test SMS to "${userName}"?`,
                'Send SMS',
                'btn-primary'
            );
            if (confirmed) {
                SCADAUtils.showToast(`<i class="fas fa-paper-plane me-2"></i>Test SMS queued for ${userName}`, 'info');
            }
        }
    </script>
}