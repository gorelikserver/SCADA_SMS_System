@page
@model SCADASMSSystem.Web.Pages.Users.IndexModel
@using SCADASMSSystem.Web.Models
@{
    ViewData["Title"] = "Recipients";
}

@section Breadcrumb {
<div class="breadcrumb-bar">
    <div class="container-fluid px-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-page="/Index"><i class="fas fa-gauge-high me-1"></i>Overview</a></li>
                <li class="breadcrumb-item active">Recipients</li>
            </ol>
        </nav>
    </div>
</div>
}

<div class="directory-workspace">
    <!-- Page Heading -->
    <header class="overview-heading">
        <div><p class="overview-kicker">Routing</p><h1>Recipients</h1><p>People who can receive SCADA alarm notifications through configured routing rules.</p></div>
        <a href="/Users/Create" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i>Add recipient
        </a>
    </header>

    <!-- Toast triggers from server messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <span class="d-none" data-toast-success="@TempData["SuccessMessage"]"></span>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <span class="d-none" data-toast-error="@TempData["ErrorMessage"]"></span>
    }

    <!-- Search and Filter Card -->
    <section class="directory-filter-panel">
        <div class="panel-heading">
            <div><p class="panel-eyebrow">Directory</p><h2>Find recipients</h2></div>
            <span class="directory-count">@Model.Users.Count() shown</span>
        </div>
        <div class="directory-filter-body">
            <form method="get" class="row g-3">
                <div class="col-md-4">
                    <label for="searchTerm" class="form-label">Search recipients</label>
                    <input asp-for="SearchTerm" class="form-control" placeholder="Name, email or phone" />
                </div>
                <div class="col-md-3">
                    <label for="smsEnabledFilter" class="form-label">SMS Status</label>
                    <select asp-for="SmsEnabledFilter" class="form-select">
                        <option value="">All recipients</option>
                        <option value="true">SMS Enabled</option>
                        <option value="false">SMS Disabled</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary" id="filterBtn">
                        <i class="fas fa-search me-2"></i>Filter
                    </button>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <a href="/Users" class="btn btn-outline-secondary">
                        Clear
                    </a>
                </div>
            </form>
        </div>
    </section>

    <!-- Users Data Table -->
    <div class="card directory-table-panel mb-4">
        <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
            <h2 class="h6 m-0 fw-bold">Recipient directory</h2>
            <div class="dropdown no-arrow">
                <a class="dropdown-toggle" href="#" role="button" id="dropdownMenuLink"
                   data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="fas fa-ellipsis-v fa-sm fa-fw text-gray-400"></i>
                </a>
                <div class="dropdown-menu dropdown-menu-right shadow animated--fade-in"
                     aria-labelledby="dropdownMenuLink">
                    <div class="dropdown-header">Export Options:</div>
                    <a class="dropdown-item" href="#" onclick="exportTableToCSV()">
                        <i class="fas fa-file-csv me-2"></i>Export to CSV
                    </a>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table directory-table" id="usersTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>Recipient</th><th>Contact</th><th>Delivery eligibility</th><th>Special days</th><th>Teams</th><th><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            var validPhone = PhoneNumberRules.IsValid(user.PhoneNumber);
                            <tr class="@(user.SmsEnabled && !validPhone ? "needs-attention" : "")">
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="recipient-avatar" aria-hidden="true">@(string.IsNullOrWhiteSpace(user.UserName) ? "?" : user.UserName.Trim()[0].ToString().ToUpperInvariant())</div>
                                        <div>
                                            <div class="fw-semibold" dir="auto">@user.UserName</div><small class="text-muted">Recipient #@user.UserId</small>
                                        </div>
                                    </div>
                                </td>
                                <td class="contact-cell">
                                    @if (!string.IsNullOrWhiteSpace(user.Email))
                                    {
                                        <a href="mailto:@user.Email" dir="auto">@user.Email</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">
                                            <i class="fas fa-envelope-open me-1"></i>No email
                                        </span>
                                    }
                                    <a href="tel:@user.PhoneNumber" class="phone-value @(validPhone ? "" : "is-invalid")">@user.PhoneNumber</a>
                                    @if (!validPhone) { <small class="invalid-note"><i class="fas fa-triangle-exclamation"></i>Invalid phone</small> }
                                </td>
                                <td>
                                    <span class="delivery-state @(user.SmsEnabled && validPhone ? "state-good" : user.SmsEnabled ? "state-danger" : "")">
                                        <i class="fas @(user.SmsEnabled ? "fa-bell" : "fa-bell-slash")"></i>@(user.SmsEnabled ? validPhone ? "Eligible" : "Blocked" : "SMS disabled")
                                    </span>
                                </td>
                                <td>
                                    <span class="availability-label @(user.SpecialDaysEnabled ? "is-available" : "")">
                                        <i class="fas @(user.SpecialDaysEnabled ? "fa-calendar-check" : "fa-calendar-times")"></i>
                                        @(user.SpecialDaysEnabled ? "Available" : "Unavailable")
                                    </span>
                                </td>
                                <td>
                                    <span class="team-count">@user.GroupMembers.Count() @(user.GroupMembers.Count() == 1 ? "team" : "teams")</span>
                                </td>
                                <td>
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button"
                                                data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="fas fa-ellipsis-h"></i>
                                        </button>
                                        <ul class="dropdown-menu">
                                            <li>
                                                <a class="dropdown-item" href="/Users/Edit/@user.UserId">
                                                    <i class="fas fa-edit me-2"></i>Edit recipient
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item" href="/Audit?userId=@user.UserId">
                                                    <i class="fas fa-history me-2"></i>Delivery history
                                                </a>
                                            </li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li>
                                                <a class="dropdown-item text-danger" href="#" 
                                                   onclick="confirmDelete(@user.UserId, '@user.UserName')">
                                                    <i class="fas fa-trash me-2"></i>Delete recipient
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (!Model.Users.Any())
                {
                    <div class="text-center py-5">
                        <div class="mb-3">
                            <i class="fas fa-users fa-3x text-gray-300"></i>
                        </div>
                        <h5 class="text-gray-500">No recipients found</h5>
                        <p class="text-gray-400">
                            @if (!string.IsNullOrWhiteSpace(Model.SearchTerm) || Model.SmsEnabledFilter.HasValue)
                            {
                                <text>No recipients match the current filters.</text>
                            }
                            else
                            {
                                <text>Add the first person who should receive routed alarms.</text>
                            }
                        </p>
                        <a href="/Users/Create" class="btn btn-primary">
                            <i class="fas fa-plus me-2"></i>Add first recipient
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Show server-side messages as toasts
            document.querySelectorAll('[data-toast-success]').forEach(el =>
                SCADAUtils.showToast('<i class="fas fa-check-circle me-2"></i>' + el.dataset.toastSuccess, 'success'));
            document.querySelectorAll('[data-toast-error]').forEach(el =>
                SCADAUtils.showToast('<i class="fas fa-exclamation-circle me-2"></i>' + el.dataset.toastError, 'danger'));

            // Filter button loading state
            const filterForm = document.querySelector('form[method="get"]');
            const filterBtn = document.getElementById('filterBtn');
            if (filterForm && filterBtn) {
                filterForm.addEventListener('submit', () =>
                    SCADAUtils.setButtonLoading(filterBtn, true, 'Filtering...'));
            }
        });

        function exportTableToCSV() {
            const table = document.getElementById('usersTable');
            const rows = Array.from(table.querySelectorAll('tr'));
            const csvContent = rows.map(row => {
                const cells = Array.from(row.querySelectorAll('th, td'));
                return cells.map(cell => {
                    const text = cell.textContent.trim().replace(/\s+/g, ' ');
                    return `"${text.replace(/"/g, '""')}"`;
                }).join(',');
            }).join('\n');
            const blob = new Blob([csvContent], { type: 'text/csv' });
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `scada-users-${new Date().toISOString().split('T')[0]}.csv`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            window.URL.revokeObjectURL(url);
        }

        async function confirmDelete(userId, userName) {
            const confirmed = await SCADAUtils.confirmModal(
                'Delete User',
                `Delete "${userName}"? This removes them from all groups and cannot be undone.`,
                'Delete User'
            );
            if (confirmed) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = `/Users/Delete/${userId}`;
                const token = document.querySelector('input[name="__RequestVerificationToken"]');
                if (token) form.appendChild(token.cloneNode());
                document.body.appendChild(form);
                form.submit();
            }
        }
    </script>
}
