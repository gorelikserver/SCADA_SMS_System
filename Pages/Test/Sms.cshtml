@page
@model SCADASMSSystem.Web.Pages.Test.SmsModel
@{
    ViewData["Title"] = "SMS Service Test";
}

<div class="container-fluid">
    <!-- Page Heading -->
    <div class="d-sm-flex align-items-center justify-content-between mb-3">
        <div class="d-flex align-items-center gap-3">
            <h1 class="h3 mb-0 text-gray-800">
                <i class="fas fa-vial me-2"></i>SMS Service Test
            </h1>
            <span class="badge fs-6 @(Model.CurrentProviderType == "SOAP" ? "bg-warning text-dark" : "bg-primary")">
                @Model.CurrentProviderType
            </span>
            @if (Model.TestModeActive)
            {
                <span class="badge fs-6 bg-warning text-dark"><i class="fas fa-flask me-1"></i>TEST MODE</span>
            }
        </div>
        <div class="d-flex gap-2">
            <a href="/Settings" class="d-none d-sm-inline-block btn btn-sm btn-outline-secondary shadow-sm">
                <i class="fas fa-cog fa-sm me-1"></i>Settings
            </a>
            <a href="/" class="d-none d-sm-inline-block btn btn-sm btn-secondary shadow-sm">
                <i class="fas fa-arrow-left fa-sm me-1"></i>Dashboard
            </a>
        </div>
    </div>

    <!-- ═══ Top-level tab bar ═══ -->
    <ul class="nav nav-tabs mb-3" id="testPageTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link @(Model.CurrentProviderType == "SOAP" ? "" : "active")"
                    id="tab-sms-test-btn"
                    data-bs-toggle="tab" data-bs-target="#tab-sms-test"
                    type="button" role="tab">
                <i class="fas fa-paper-plane me-1"></i>SMS Test
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(Model.CurrentProviderType == "SOAP" ? "active" : "")"
                    id="tab-soap-workbench-btn"
                    data-bs-toggle="tab" data-bs-target="#tab-soap-workbench"
                    type="button" role="tab">
                <i class="fas fa-soap me-1"></i>SOAP Workbench
                <span class="badge bg-warning text-dark ms-1" style="font-size:.62rem;">SOAP</span>
            </button>
        </li>
    </ul>

    <div class="tab-content" id="testPageTabsContent">

    <!-- ═══ SMS TEST TAB ═══ -->
    <div class="tab-pane fade @(Model.CurrentProviderType == "SOAP" ? "" : "show active")"
         id="tab-sms-test" role="tabpanel">

    <!-- Toast triggers -->
    @if (TempData["SuccessMessage"] != null)
    {
        <span class="d-none" data-toast-success="@TempData["SuccessMessage"]"></span>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <span class="d-none" data-toast-error="@TempData["ErrorMessage"]"></span>
    }

    <!-- Main grid: left info panel | right action panel -->
    <div class="row g-4">

        <!-- ═══ LEFT: Status, Config, Instructions ═══ -->
        <div class="col-lg-4">

            <!-- Service Status -->
            <div class="card shadow mb-4">
                <div class="card-header card-header-gradient py-3 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 fw-bold">
                        <i class="fas fa-heartbeat me-2"></i>Service Status
                    </h6>
                    <button class="btn btn-sm btn-outline-primary" onclick="refreshStatus()">
                        <i class="fas fa-sync-alt fa-sm"></i>
                    </button>
                </div>
                <div class="card-body p-3" id="statusCard">
                    <div class="row g-2">
                        <div class="col-6">
                            <div class="p-2 rounded" style="background:#f8f9fa;">
                                <div class="text-muted" style="font-size:.72rem;text-transform:uppercase;letter-spacing:.4px;">Queue</div>
                                <div class="fw-bold text-primary fs-5" id="queueSize">@Model.ServiceStatus.QueueSize</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-2 rounded" style="background:#f8f9fa;">
                                <div class="text-muted" style="font-size:.72rem;text-transform:uppercase;letter-spacing:.4px;">Sent</div>
                                <div class="fw-bold text-success fs-5" id="messagesSent">@Model.ServiceStatus.MessagesSent</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-2 rounded" style="background:#f8f9fa;">
                                <div class="text-muted" style="font-size:.72rem;text-transform:uppercase;letter-spacing:.4px;">Failed</div>
                                <div class="fw-bold text-danger fs-5" id="messagesFailed">@Model.ServiceStatus.MessagesFailed</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-2 rounded" style="background:#f8f9fa;">
                                <div class="text-muted" style="font-size:.72rem;text-transform:uppercase;letter-spacing:.4px;">Uptime</div>
                                <div class="fw-bold" style="font-size:.85rem;" id="uptime">@Model.ServiceStatus.ServiceUptime.ToString(@"d\.hh\:mm\:ss")</div>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="text-muted" style="font-size:.75rem;">Last message</div>
                            <div class="fw-semibold" style="font-size:.82rem;" id="lastMessage">
                                @if (Model.ServiceStatus.LastMessageTime.HasValue)
                                {
                                    @Model.ServiceStatus.LastMessageTime.Value.ToString("yyyy-MM-dd HH:mm:ss")
                                }
                                else
                                {
                                    <span class="text-muted">Never</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Service Configuration -->
            <div class="card shadow mb-4">
                <div class="card-header card-header-gradient py-3">
                    <h6 class="m-0 fw-bold">
                        <i class="fas fa-cogs me-2"></i>Configuration
                    </h6>
                </div>
                <div class="card-body p-3">
                    <div class="row g-2">
                        <div class="col-6">
                            <div class="text-muted" style="font-size:.72rem;text-transform:uppercase;">Rate Limit</div>
                            <div class="fw-semibold">@Model.ServiceStatus.RateLimit / min</div>
                        </div>
                        <div class="col-6">
                            <div class="text-muted" style="font-size:.72rem;text-transform:uppercase;">Dedup Window</div>
                            <div class="fw-semibold">@Model.ServiceStatus.DuplicateWindow min</div>
                        </div>
                        <div class="col-12 mt-1">
                            <div class="text-muted" style="font-size:.72rem;text-transform:uppercase;">Deduplication</div>
                            @if (Model.ServiceStatus.DeduplicationEnabled)
                            {
                                <span class="text-success"><i class="fas fa-check-circle me-1"></i>Enabled</span>
                            }
                            else
                            {
                                <span class="text-warning"><i class="fas fa-exclamation-triangle me-1"></i>Disabled</span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Testing Instructions -->
            <div class="card shadow">
                <div class="card-header card-header-gradient py-3">
                    <h6 class="m-0 fw-bold">
                        <i class="fas fa-info-circle me-2"></i>How to Test
                    </h6>
                </div>
                <div class="card-body p-3" style="font-size:.83rem;">
                    <ol class="mb-3 ps-3">
                        <li>Select a group with SMS-enabled members</li>
                        <li>Type your test message</li>
                        <li>Preview updates live on the right</li>
                        <li>Click <strong>Send Test SMS</strong></li>
                        <li>Check <a href="/Audit">Audit page</a> for delivery results</li>
                    </ol>
                    <hr class="my-2">
                    <div class="text-muted" style="font-size:.78rem;">
                        <strong>API direct:</strong>
                        <pre class="mt-1 p-2 rounded" style="background:#f8f9fa;font-size:.72rem;">POST /api/sms/send
{ "message":"...", "groupId":1,
  "alarmId":"TEST-001" }</pre>
                    </div>
                    @if (Model.TestModeActive)
                    {
                        <div class="alert alert-warning py-2 mb-0 mt-2" style="font-size:.78rem;">
                            <i class="fas fa-flask me-1"></i>
                            <strong>Test Mode ON</strong> — no real SMS sent. See Mock Tester below.
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- ═══ RIGHT: Form + Preview ═══ -->
        <div class="col-lg-8" x-data="smsPreviewer()" x-init="initFocusRefresh()">

            <!-- Send Test SMS card -->
            <div class="card shadow mb-4">
                <div class="card-header card-header-gradient py-3">
                    <h6 class="m-0 fw-bold">
                        <i class="fas fa-paper-plane me-2"></i>Send Test SMS
                    </h6>
                </div>
                <div class="card-body">
                    <form method="post" asp-page-handler="SendTest" id="sendTestForm">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        <div class="row g-3">
                            <div class="col-md-7">
                                <label asp-for="TestMessage.Message" class="form-label fw-semibold" style="font-size:.82rem;text-transform:uppercase;letter-spacing:.4px;"></label>
                                <textarea asp-for="TestMessage.Message" class="form-control" rows="3"
                                          placeholder="Enter test message..." id="TestMessage_Message"></textarea>
                                <span asp-validation-for="TestMessage.Message" class="text-danger small"></span>
                            </div>
                            <div class="col-md-5">
                                <label asp-for="TestMessage.GroupId" class="form-label fw-semibold" style="font-size:.82rem;text-transform:uppercase;letter-spacing:.4px;"></label>
                                <select asp-for="TestMessage.GroupId" class="form-select" id="TestMessage_GroupId">
                                    <option value="">Select a group...</option>
                                    @foreach (var group in Model.AvailableGroups)
                                    {
                                        <option value="@group.GroupId">@group.GroupName</option>
                                    }
                                </select>
                                <span asp-validation-for="TestMessage.GroupId" class="text-danger small"></span>

                                @if (!Model.AvailableGroups.Any())
                                {
                                    <div class="alert alert-warning mt-2 py-2" style="font-size:.8rem;">
                                        <i class="fas fa-exclamation-triangle me-1"></i>
                                        No groups. <a href="/Groups/Create">Create one</a> first.
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="d-flex gap-2 mt-3">
                            <button type="submit" class="btn btn-warning flex-grow-1" @(Model.AvailableGroups.Any() ? "" : "disabled")>
                                <i class="fas fa-paper-plane me-2"></i>Send Test SMS
                            </button>
                            <form method="post" asp-page-handler="TestHealth">
                                <button type="submit" class="btn btn-outline-info">
                                    <i class="fas fa-heartbeat me-1"></i>Health
                                </button>
                            </form>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Preview card -->
            <div class="card shadow">
                <div class="card-header card-header-gradient py-2">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <h6 class="m-0 fw-bold">
                            <i class="fas fa-eye me-2"></i>Live Preview
                            <span class="badge bg-info ms-2" x-text="(settings.providerType||'REST').toUpperCase()" style="font-size:.65rem;"></span>
                        </h6>
                        <!-- Message stats -->
                        <div class="d-flex align-items-center gap-3" style="font-size:.78rem;">
                            <button type="button" class="btn btn-sm btn-outline-light py-0 px-2"
                                    @@click="refreshSettings()" :disabled="refreshing"
                                    title="Re-fetch the current saved settings from the server">
                                <i class="fas" :class="refreshing?'fa-spinner fa-spin':'fa-sync-alt'"></i>
                                <span class="ms-1" x-text="refreshing?'Refreshing…':'Refresh'"></span>
                            </button>
                            <span class="text-muted">
                                <span x-text="charCount">0</span> chars
                                &bull;
                                <span x-text="segments">1</span> seg
                            </span>
                            <span class="badge"
                                  :class="encoding==='ASCII'?'bg-success':encoding.includes('Hebrew')?'bg-danger':'bg-warning text-dark'"
                                  x-text="encoding">ASCII</span>
                        </div>
                    </div>
                </div>
                <div class="card-body p-0">
                    <!-- Bootstrap tabs -->
                    <ul class="nav nav-tabs px-3 pt-2" style="border-bottom:1px solid #dee2e6;">
                        <li class="nav-item">
                            <a class="nav-link active" data-bs-toggle="tab" href="#tab-request" style="font-size:.82rem;">
                                <i class="fas fa-code me-1"></i>Request
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" data-bs-toggle="tab" href="#tab-recipients" style="font-size:.82rem;">
                                <i class="fas fa-users me-1"></i>Recipients
                                <span class="badge bg-secondary ms-1" style="font-size:.65rem;"
                                      x-show="recipients.length > 0"
                                      x-text="recipients.filter(r=>r.smsEnabled).length + '/' + recipients.length"></span>
                            </a>
                        </li>
                    </ul>
                    <div class="tab-content">
                        <!-- Request Preview tab -->
                        <div class="tab-pane fade show active" id="tab-request">
                            <pre class="m-0 p-3" style="font-size:.75rem;background:#1e1e1e;color:#d4d4d4;min-height:160px;max-height:320px;overflow-y:auto;white-space:pre-wrap;word-break:break-all;border-radius:0 0 .5rem .5rem;" x-text="requestPreview"></pre>
                        </div>
                        <!-- Recipients tab -->
                        <div class="tab-pane fade" id="tab-recipients">
                            <div class="p-3" style="min-height:160px;">
                                <template x-if="!groupId">
                                    <div class="text-center text-muted py-5" style="font-size:.85rem;">
                                        <i class="fas fa-users fa-2x mb-2 d-block text-secondary"></i>
                                        Select a group above to preview who would receive this SMS
                                    </div>
                                </template>
                                <template x-if="groupId && loadingRecipients">
                                    <div class="text-center py-5">
                                        <span class="spinner-border text-secondary"></span>
                                    </div>
                                </template>
                                <template x-if="groupId && !loadingRecipients && recipients.length === 0">
                                    <div class="text-center text-muted py-5" style="font-size:.85rem;">
                                        <i class="fas fa-user-slash fa-2x mb-2 d-block text-secondary"></i>
                                        No members in this group
                                    </div>
                                </template>
                                <template x-if="groupId && !loadingRecipients && recipients.length > 0">
                                    <div>
                                        <div class="d-flex align-items-center justify-content-between mb-2">
                                            <span style="font-size:.78rem;" class="text-muted">
                                                <span class="text-success fw-bold" x-text="recipients.filter(r=>r.smsEnabled).length"></span>
                                                of <span x-text="recipients.length"></span> members will receive
                                            </span>
                                        </div>
                                        <table class="table table-sm table-hover align-middle mb-0" style="font-size:.82rem;">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Name</th>
                                                    <th>Phone</th>
                                                    <th class="text-center" style="width:60px;">SMS</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <template x-for="(r, i) in recipients" :key="i">
                                                    <tr :class="!r.smsEnabled ? 'table-secondary text-muted' : ''">
                                                        <td x-text="r.name || '—'"></td>
                                                        <td class="font-monospace" x-text="r.maskedPhone"></td>
                                                        <td class="text-center">
                                                            <i :class="r.smsEnabled ? 'fas fa-check-circle text-success' : 'fas fa-times-circle text-danger'"></i>
                                                        </td>
                                                    </tr>
                                                </template>
                                            </tbody>
                                        </table>
                                    </div>
                                </template>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (Model.TestModeActive)
    {
        <!-- ═══ MOCK SERVER TESTER ═══ -->
        <div id="mock-tester" class="mt-4">
            <div class="card shadow">
                <div class="card-header card-header-gradient py-3 d-flex align-items-center justify-content-between">
                    <h6 class="m-0 fw-bold">
                        <i class="fas fa-flask me-2"></i>Mock Server Tester
                        <span class="badge bg-warning text-dark ms-2 fw-normal" style="font-size:.7rem;">TEST MODE</span>
                    </h6>
                    <span class="badge bg-success px-2 py-1" style="font-size:.72rem;">
                        <i class="fas fa-circle me-1" style="font-size:7px;"></i>Active (REST + SOAP)
                    </span>
                </div>
                <div class="card-body" x-data="mockTester('@Model.CurrentProviderType')">

                    <div class="row g-4">
                        <!-- LEFT: Request builder -->
                        <div class="col-lg-5">
                            <div class="d-flex gap-2 mb-3">
                                <button type="button" class="btn btn-sm"
                                        :class="activeTab==='REST'?'btn-primary':'btn-outline-primary'"
                                        @@click="activeTab='REST'">
                                    <i class="fas fa-code me-1"></i>REST Mock
                                </button>
                                <button type="button" class="btn btn-sm"
                                        :class="activeTab==='SOAP'?'btn-warning text-dark':'btn-outline-warning'"
                                        @@click="activeTab='SOAP'">
                                    <i class="fas fa-file-code me-1"></i>SOAP Mock
                                </button>
                            </div>

                            <div x-show="activeTab==='REST'" x-transition>
                                <div class="mb-2">
                                    <label class="form-label" style="font-size:.82rem;">Phone Number</label>
                                    <input type="tel" x-model="restPhone" class="form-control form-control-sm" placeholder="+972501234567" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" style="font-size:.82rem;">Message</label>
                                    <textarea x-model="restMessage" class="form-control form-control-sm" rows="3" placeholder="Test alarm message..."></textarea>
                                </div>
                                <button type="button" class="btn btn-primary w-100" @@click="sendMockRest()" :disabled="sending">
                                    <span x-show="sending" class="spinner-border spinner-border-sm me-1"></span>
                                    <i class="fas fa-paper-plane me-1" x-show="!sending"></i>
                                    <span x-text="sending?'Sending...':'Send to Mock REST'"></span>
                                </button>
                                <div class="info-box mt-2" style="font-size:.75rem;">
                                    <code>GET /mock/sms/rest?phone=...&amp;message=...</code>
                                </div>
                            </div>

                            <div x-show="activeTab==='SOAP'" x-transition>
                                <div class="mb-2">
                                    <label class="form-label" style="font-size:.82rem;">Phone Number</label>
                                    <input type="tel" x-model="soapPhone" class="form-control form-control-sm" placeholder="+972501234567" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" style="font-size:.82rem;">Message</label>
                                    <textarea x-model="soapMessage" class="form-control form-control-sm" rows="3" placeholder="Test alarm message..."></textarea>
                                </div>
                                <button type="button" class="btn btn-warning text-dark w-100" @@click="sendMockSoap()" :disabled="sending">
                                    <span x-show="sending" class="spinner-border spinner-border-sm me-1"></span>
                                    <i class="fas fa-paper-plane me-1" x-show="!sending"></i>
                                    <span x-text="sending?'Sending...':'Send to Mock SOAP'"></span>
                                </button>
                                <div class="info-box mt-2" style="font-size:.75rem;">
                                    <code>POST /mock/sms/soap</code> — XML envelope
                                </div>
                            </div>
                        </div>

                        <!-- RIGHT: Response panel -->
                        <div class="col-lg-7">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span style="font-size:.82rem; font-weight:600; color:#495057;">Response</span>
                                <template x-if="lastStatus">
                                    <span class="badge" :class="lastStatus===200?'bg-success':'bg-danger'"
                                          x-text="lastStatus===200?'200 OK':''+lastStatus+' Error'"></span>
                                </template>
                            </div>
                            <pre class="code-preview" style="min-height:120px;max-height:220px;overflow:auto;font-size:.75rem;white-space:pre-wrap;word-break:break-all;"
                                 x-text="responseText || '— no response yet —'"></pre>

                            <div class="mt-3">
                                <div class="d-flex align-items-center justify-content-between mb-1">
                                    <span style="font-size:.78rem;font-weight:600;color:#6c757d;text-transform:uppercase;letter-spacing:.3px;">
                                        <i class="fas fa-list me-1"></i>Recent Mock Log
                                    </span>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" style="font-size:.72rem;padding:.15rem .5rem;"
                                            @@click="refreshLog()">
                                        <i class="fas fa-sync-alt"></i>
                                    </button>
                                </div>
                                <div class="border rounded" style="max-height:160px;overflow-y:auto;font-size:.74rem;">
                                    <template x-if="mockLog.length===0">
                                        <div class="text-center text-muted py-3">
                                            <i class="fas fa-inbox me-1"></i>No messages yet
                                        </div>
                                    </template>
                                    <template x-for="(entry, i) in mockLog" :key="i">
                                        <div class="d-flex align-items-center gap-2 px-2 py-1 border-bottom" style="font-size:.72rem;">
                                            <span class="badge" :class="entry.success?'bg-success':'bg-danger'" style="font-size:.62rem;" x-text="entry.providerType"></span>
                                            <span class="text-muted font-monospace" x-text="entry.maskedPhone"></span>
                                            <span class="text-truncate flex-grow-1" x-text="entry.message" style="max-width:200px;"></span>
                                            <span class="text-muted" x-text="new Date(entry.timestamp).toLocaleTimeString()"></span>
                                        </div>
                                    </template>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow mt-3">
                <div class="card-header card-header-gradient py-2">
                    <h6 class="m-0 fw-bold" style="font-size:.85rem;">
                        <i class="fas fa-info-circle me-2"></i>How Mock Server Works
                    </h6>
                </div>
                <div class="card-body" style="font-size:.82rem;">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <p class="text-muted mb-2">
                                When <strong>Test Mode is ON</strong>, all SMS sends are intercepted by the built-in mock.
                                <strong>No real SMS is ever sent.</strong>
                            </p>
                            <ul class="mb-0" style="padding-left:1.2rem;">
                                <li><strong>Failure rate:</strong> ~3% simulated — tests retry logic</li>
                                <li><strong>Log:</strong> last 100 messages, in-memory</li>
                                <li><strong>Mock ID:</strong> <code>MOCK-yyyyMMddHHmmssff-XXXX</code></li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <div class="code-preview" style="font-size:.72rem;padding:.6rem .8rem;">
<strong class="placeholder-key">REST mock</strong>  GET/POST /mock/sms/rest
  <span class="placeholder-var">→ JSON:</span> { mock, success, messageId }

<strong class="placeholder-key">SOAP mock</strong>  POST /mock/sms/soap
  <span class="placeholder-var">→ XML:</span>  &lt;Success&gt;true/false&lt;/Success&gt;

<strong class="placeholder-key">Log</strong>        GET /mock/sms/status
<strong class="placeholder-key">Reset</strong>      POST /mock/sms/reset</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    </div><!-- /tab-sms-test -->

    <!-- ═══ SOAP WORKBENCH TAB ═══ -->
    <div class="tab-pane fade @(Model.CurrentProviderType == "SOAP" ? "show active" : "")"
         id="tab-soap-workbench" role="tabpanel">
        <!-- content added in Task 5 -->
    </div><!-- /tab-soap-workbench -->

    </div><!-- /tab-content -->

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('[data-toast-success]').forEach(el =>
                SCADAUtils.showToast('<i class="fas fa-check-circle me-2"></i>' + el.dataset.toastSuccess, 'success'));
            document.querySelectorAll('[data-toast-error]').forEach(el =>
                SCADAUtils.showToast('<i class="fas fa-exclamation-circle me-2"></i>' + el.dataset.toastError, 'danger'));

            const sendForm = document.getElementById('sendTestForm');
            if (sendForm) {
                sendForm.addEventListener('submit', function () {
                    const btn = this.querySelector('button[type="submit"]');
                    if (btn && !btn.disabled) SCADAUtils.setButtonLoading(btn, true, 'Sending...');
                });
            }
        });

        setInterval(refreshStatus, 5000);

        function refreshStatus() {
            fetch('/Test/Sms?handler=RefreshStatus')
                .then(r => r.json())
                .then(data => {
                    document.getElementById('queueSize').textContent = data.queueSize;
                    document.getElementById('messagesSent').textContent = data.messagesSent;
                    document.getElementById('messagesFailed').textContent = data.messagesFailed;
                    document.getElementById('uptime').textContent = data.uptime;
                    document.getElementById('lastMessage').textContent = data.lastMessage || 'Never';
                })
                .catch(() => {});
        }

        function mockTester(defaultProvider) {
            return {
                activeTab: defaultProvider === 'SOAP' ? 'SOAP' : 'REST',
                restPhone: '', restMessage: 'Test alarm from SCADA',
                soapPhone: '', soapMessage: 'Test alarm from SCADA',
                sending: false, lastStatus: null, responseText: '', mockLog: [],

                init() { this.refreshLog(); setInterval(() => this.refreshLog(), 3000); },

                async sendMockRest() {
                    this.sending = true;
                    try {
                        const params = new URLSearchParams({ phone: this.restPhone, message: this.restMessage });
                        const res = await fetch('/mock/sms/rest?' + params);
                        this.lastStatus = res.status;
                        this.responseText = JSON.stringify(await res.json(), null, 2);
                        await this.refreshLog();
                    } catch (e) { this.responseText = 'Error: ' + e.message; this.lastStatus = 0; }
                    finally { this.sending = false; }
                },

                async sendMockSoap() {
                    this.sending = true;
                    const esc = s => String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
                    try {
                        const body = `<?xml version="1.0" encoding="utf-8"?>
<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/">
  <soapenv:Header/>
  <soapenv:Body>
    <SendSMS>
      <Phone>${esc(this.soapPhone)}</Phone>
      <Message>${esc(this.soapMessage)}</Message>
    </SendSMS>
  </soapenv:Body>
</soapenv:Envelope>`;
                        const res = await fetch('/mock/sms/soap', { method: 'POST', headers: { 'Content-Type': 'text/xml; charset=utf-8' }, body });
                        this.lastStatus = res.status;
                        this.responseText = await res.text();
                        await this.refreshLog();
                    } catch (e) { this.responseText = 'Error: ' + e.message; this.lastStatus = 0; }
                    finally { this.sending = false; }
                },

                async refreshLog() {
                    try {
                        const res = await fetch('/mock/sms/status');
                        if (!res.ok) return;
                        const data = await res.json();
                        this.mockLog = (data.recentLog || []).slice(0, 10);
                    } catch { }
                }
            };
        }

        function smsPreviewer() {
            // Inject settings as JSON element to avoid HTML attribute quote-breaking
            const settings = JSON.parse(document.getElementById('sms-preview-settings').textContent);
            return {
                settings,
                message: '',
                groupId: null,
                recipients: [],
                loadingRecipients: false,
                refreshing: false,

                // Re-pull settings whenever the user returns to this tab/window so a Settings
                // change (provider switch, test-mode toggle, auth method) reflects immediately
                // without requiring a manual click on the Refresh button.
                initFocusRefresh() {
                    let last = 0;
                    window.addEventListener('focus', () => {
                        const now = Date.now();
                        if (now - last < 1500) return; // debounce rapid Alt-Tab
                        last = now;
                        this.refreshSettings(true);
                    });
                },

                async refreshSettings(silent) {
                    if (this.refreshing) return;
                    this.refreshing = true;
                    try {
                        const res = await fetch('/Settings?handler=Snapshot', {
                            headers: { 'Accept': 'application/json' },
                            cache: 'no-store'
                        });
                        if (!res.ok) throw new Error('HTTP ' + res.status);
                        const data = await res.json();
                        const before = this.settings.providerType;
                        Object.keys(data).forEach(k => { this.settings[k] = data[k]; });
                        const changed = before !== this.settings.providerType;
                        if (window.SCADAUtils && SCADAUtils.showToast && (!silent || changed)) {
                            SCADAUtils.showToast('Settings refreshed (Provider: ' + (this.settings.providerType || 'REST') + ')', 'success');
                        }
                    } catch (e) {
                        console.error('refreshSettings failed', e);
                        if (!silent && window.SCADAUtils && SCADAUtils.showToast) {
                            SCADAUtils.showToast('Failed to refresh settings', 'danger');
                        }
                    } finally {
                        this.refreshing = false;
                    }
                },

                get charCount() { return this.message.length; },
                get encoding() {
                    if (/[֐-׿]/.test(this.message)) return 'Hebrew/Unicode';
                    if (/[^\x00-\x7F]/.test(this.message)) return 'Unicode';
                    return 'ASCII';
                },
                get segments() {
                    const max1 = this.encoding === 'ASCII' ? 160 : 70;
                    const maxN = this.encoding === 'ASCII' ? 153 : 67;
                    const n = this.charCount;
                    if (n === 0) return 1;
                    return n <= max1 ? 1 : Math.ceil(n / maxN);
                },
                get requestPreview() {
                    const msg = this.message || '(type a message above)';
                    const phone = '+972XXXXXXXXX';
                    return this.settings.providerType === 'SOAP'
                        ? this.buildSoapPreview(msg, phone)
                        : this.buildRestPreview(msg, phone);
                },

                buildRestPreview(msg, phone) {
                    const endpoint = this.settings.apiEndpoint || '(endpoint not configured)';
                    const method = (this.settings.httpMethod || 'POST').toUpperCase();
                    const ct = this.settings.contentType || 'application/x-www-form-urlencoded';
                    let params = [];
                    try {
                        // apiParams is stored as dict {"key": "keyword-or-value"}
                        const raw = JSON.parse(this.settings.apiParams || '{}');
                        params = Object.entries(raw).map(([k, v]) => ({
                            key: k,
                            value: this.resolveValue(v, msg, phone)
                        }));
                    } catch { }
                    if (method === 'GET') {
                        // Break long URLs onto one query-pair per line for readability;
                        // the actual request still goes out as a single line.
                        const pairs = params.map(p => `${encodeURIComponent(p.key)}=${encodeURIComponent(p.value)}`);
                        const url = pairs.length
                            ? `${endpoint}\n  ?${pairs.join('\n  &')}`
                            : endpoint;
                        return `${method} ${url}\n\n(no body)`;
                    }
                    let body = '';
                    if (ct.includes('json')) {
                        body = JSON.stringify(Object.fromEntries(params.map(p => [p.key, p.value])), null, 2);
                    } else if (ct.includes('xml')) {
                        body = this.prettyXml(params.map(p => `<${p.key}>${p.value}</${p.key}>`).join(''));
                    } else {
                        body = params.map(p => `${encodeURIComponent(p.key)}=${encodeURIComponent(p.value)}`).join('&');
                    }
                    const extraHeaders = this.buildHeaderLines();
                    return `${method} ${endpoint}\nContent-Type: ${ct}${extraHeaders}\n\n${body || '(no params configured)'}`;
                },

                buildSoapPreview(msg, phone) {
                    const endpoint = this.settings.apiEndpoint || '(SOAP endpoint not configured)';
                    const action = this.settings.soapAction || '';
                    const authType = this.settings.soapAuthType || 'WSSecurity';
                    const ns = this.settings.soapEnvelopeNamespaces
                        ? ' ' + this.settings.soapEnvelopeNamespaces.trim() : '';

                    let body = this.settings.soapBodyTemplate ||
                        `<Phone>${phone}</Phone>\n<Message>${msg}</Message>`;

                    if (this.settings.soapParams) {
                        try {
                            const map = JSON.parse(this.settings.soapParams);
                            for (const [token, kw] of Object.entries(map))
                                body = body.replaceAll(`{${token}}`, this.resolveValue(kw, msg, phone));
                        } catch { }
                    } else if (this.settings.soapBodyTemplate) {
                        body = body.replace(/{Message}/g, msg).replace(/{Phone}/g, phone)
                            .replace(/{Username}/g, '***').replace(/{Password}/g, '***')
                            .replace(/{SenderName}/g, this.settings.senderName || '');
                    }

                    let header = '  <soapenv:Header/>';
                    if (authType === 'WSSecurity') {
                        header = `  <soapenv:Header>
    <wsse:Security xmlns:wsse="http://schemas.xmlsoap.org/ws/2002/07/secext">
      <wsse:UsernameToken>
        <wsse:Username>***</wsse:Username>
        <wsse:Password>***</wsse:Password>
      </wsse:UsernameToken>
    </wsse:Security>
  </soapenv:Header>`;
                    } else if (authType === 'HttpBasic') {
                        header = '  <soapenv:Header/>';
                    }

                    const envelope = `<?xml version="1.0" encoding="utf-8"?>\n<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/"${ns}>\n${header}\n  <soapenv:Body>\n    ${body}\n  </soapenv:Body>\n</soapenv:Envelope>`;
                    return `POST ${endpoint} HTTP/1.1\nSOAPAction: "${action}"\nContent-Type: text/xml; charset=utf-8\n\n${this.prettyXml(envelope)}`;
                },

                buildHeaderLines() {
                    const lines = [];
                    // Auto-injected auth header from RestAuthType (mirrors SmsService.ApplyRestAuth)
                    const authType = (this.settings.restAuthType || 'None');
                    if (authType === 'Basic') {
                        lines.push('Authorization: Basic ***');
                    } else if (authType === 'Bearer') {
                        if (this.settings.restBearerToken) lines.push('Authorization: Bearer ***');
                    } else if (authType === 'ApiKey') {
                        const name = this.settings.restApiKeyName;
                        const loc  = this.settings.restApiKeyLocation || 'Header';
                        if (name && loc === 'Header') lines.push(`${name}: ***`);
                        // Query-location key is appended to URL; surfaced in REST preview path instead
                    }
                    if (this.settings.apiHeaders) {
                        try {
                            const h = JSON.parse(this.settings.apiHeaders);
                            Object.entries(h).forEach(([k, v]) => {
                                lines.push(`${k}: ${k.toLowerCase().includes('auth') || k.toLowerCase().includes('key') ? '***' : v}`);
                            });
                        } catch { }
                    }
                    return lines.length ? '\n' + lines.join('\n') : '';
                },

                resolveValue(keyword, msg, phone) {
                    switch ((keyword || '').toLowerCase()) {
                        case 'message': return msg;
                        case 'phone': case 'phonenumber': case 'mobile': return phone;
                        case 'username': case 'user': return '***';
                        case 'password': case 'pass': return '***';
                        case 'sender_name': case 'sendername': case 'from': return this.settings.senderName || '';
                        case 'tz': return '{TZ}';
                        case 'firstname': return '{FirstName}';
                        case 'lastname': return '{LastName}';
                        case 'sendingsystem': return this.settings.soapSendingSystem || 'SCADA';
                        case 'messagetype': return this.settings.soapMessageType || 'SmsType1';
                        // SCADA payload-derived dynamic vars (forwarded by Scada_sms.bat at runtime).
                        // Preview substitutes a clearly bracketed placeholder so admins recognise them.
                        case 'group_id': case 'groupid': return '{GroupId}';
                        case 'alarm_id': case 'alarmid': return '{AlarmId}';
                        case 'priority': return '{Priority}';
                        case 'value': return '{Value}';
                        default: return keyword;
                    }
                },

                // Lightweight XML pretty-printer for the request preview.
                // Inserts newlines between adjacent tags and indents 2 spaces per nesting level.
                // Pure-string transform — does NOT validate the XML; safe for preview only.
                prettyXml(xml) {
                    if (!xml || typeof xml !== 'string') return xml;
                    try {
                        const PAD = '  ';
                        // Normalise: put each tag on its own line, then re-indent.
                        let formatted = xml
                            .replace(/>\s*</g, '>\n<')
                            .replace(/(<\?xml[^?]*\?>)/g, '$1\n');
                        let indent = 0;
                        return formatted.split('\n').map(line => {
                            line = line.trim();
                            if (!line) return '';
                            // Closing tag → dedent first
                            if (/^<\//.test(line)) indent = Math.max(0, indent - 1);
                            const padded = PAD.repeat(indent) + line;
                            // Opening tag (not self-closing, not <?xml, not <!--) → indent next
                            if (/^<[^!?\/][^>]*[^\/]>$/.test(line)) indent++;
                            return padded;
                        }).filter(Boolean).join('\n');
                    } catch { return xml; }
                },

                async fetchRecipients(groupId) {
                    if (!groupId) { this.recipients = []; return; }
                    this.loadingRecipients = true;
                    try {
                        const res = await fetch(`/Test/Sms?handler=GroupMembers&groupId=${groupId}`);
                        this.recipients = res.ok ? await res.json() : [];
                    } catch { this.recipients = []; }
                    finally { this.loadingRecipients = false; }
                },

                init() {
                    const msgEl = document.getElementById('TestMessage_Message');
                    if (msgEl) {
                        this.message = msgEl.value;
                        msgEl.addEventListener('input', e => { this.message = e.target.value; });
                    }
                    const grpEl = document.getElementById('TestMessage_GroupId');
                    if (grpEl) {
                        this.groupId = grpEl.value || null;
                        if (this.groupId) this.fetchRecipients(this.groupId);
                        grpEl.addEventListener('change', e => {
                            this.groupId = e.target.value || null;
                            this.fetchRecipients(this.groupId);
                        });
                    }
                }
            };
        }
    </script>

    <!-- Settings JSON injected as data element to avoid HTML attribute quoting issues -->
    <script type="application/json" id="sms-preview-settings">@Html.Raw(Model.SettingsJson)</script>

    <script src="~/js/alpine.min.js" defer></script>
}
