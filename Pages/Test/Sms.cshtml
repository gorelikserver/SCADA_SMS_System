@page
@model SCADASMSSystem.Web.Pages.Test.SmsModel
@{
    ViewData["Title"] = "SMS Service Test";
}

<div class="container-fluid">
    <!-- Page Heading -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">
            <i class="fas fa-vial me-2"></i>SMS Service Test
        </h1>
        <a href="/" class="d-none d-sm-inline-block btn btn-sm btn-secondary shadow-sm">
            <i class="fas fa-arrow-left fa-sm text-white-50"></i> Back to Dashboard
        </a>
    </div>

    <!-- Toast triggers from server messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <span class="d-none" data-toast-success="@TempData["SuccessMessage"]"></span>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <span class="d-none" data-toast-error="@TempData["ErrorMessage"]"></span>
    }

    <div class="row">
        <!-- SMS Service Status -->
        <div class="col-lg-6">
            <div class="card shadow mb-4">
                <div class="card-header card-header-gradient py-3 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 fw-bold">
                        <i class="fas fa-heartbeat me-2"></i>SMS Service Status
                    </h6>
                    <button class="btn btn-sm btn-outline-primary" onclick="refreshStatus()">
                        <i class="fas fa-sync-alt"></i> Refresh
                    </button>
                </div>
                <div class="card-body" id="statusCard">
                    <div class="row">
                        <div class="col-6">
                            <div class="border-bottom py-2">
                                <small class="text-muted">Queue Size</small>
                                <div class="font-weight-bold text-primary" id="queueSize">@Model.ServiceStatus.QueueSize</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="border-bottom py-2">
                                <small class="text-muted">Messages Sent</small>
                                <div class="font-weight-bold text-success" id="messagesSent">@Model.ServiceStatus.MessagesSent</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="border-bottom py-2">
                                <small class="text-muted">Messages Failed</small>
                                <div class="font-weight-bold text-danger" id="messagesFailed">@Model.ServiceStatus.MessagesFailed</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="border-bottom py-2">
                                <small class="text-muted">Service Uptime</small>
                                <div class="font-weight-bold" id="uptime">@Model.ServiceStatus.ServiceUptime.ToString(@"d\.hh\:mm\:ss")</div>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="py-2">
                                <small class="text-muted">Last Message</small>
                                <div class="font-weight-bold" id="lastMessage">
                                    @if (Model.ServiceStatus.LastMessageTime.HasValue)
                                    {
                                        @Model.ServiceStatus.LastMessageTime.Value.ToString("yyyy-MM-dd HH:mm:ss")
                                    }
                                    else
                                    {
                                        <span class="text-muted">Never</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Service Configuration -->
            <div class="card shadow mb-4">
                <div class="card-header card-header-gradient py-3">
                    <h6 class="m-0 fw-bold">
                        <i class="fas fa-cogs me-2"></i>Service Configuration
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-6">
                            <div class="border-bottom py-2">
                                <small class="text-muted">Rate Limit</small>
                                <div class="font-weight-bold">@Model.ServiceStatus.RateLimit / minute</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="border-bottom py-2">
                                <small class="text-muted">Duplicate Window</small>
                                <div class="font-weight-bold">@Model.ServiceStatus.DuplicateWindow minutes</div>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="py-2">
                                <small class="text-muted">Deduplication</small>
                                <div class="font-weight-bold">
                                    @if (Model.ServiceStatus.DeduplicationEnabled)
                                    {
                                        <span class="text-success"><i class="fas fa-check-circle"></i> Enabled</span>
                                    }
                                    else
                                    {
                                        <span class="text-warning"><i class="fas fa-exclamation-triangle"></i> Disabled</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Test SMS Form -->
        <div class="col-lg-6">
            <div class="card shadow mb-4">
                <div class="card-header card-header-gradient py-3">
                    <h6 class="m-0 fw-bold">
                        <i class="fas fa-paper-plane me-2"></i>Send Test SMS
                    </h6>
                </div>
                <div class="card-body">
                    <form method="post" asp-page-handler="SendTest">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        
                        <div class="mb-3">
                            <label asp-for="TestMessage.Message" class="form-label"></label>
                            <textarea asp-for="TestMessage.Message" class="form-control" rows="3" 
                                      placeholder="Enter your test message here..."></textarea>
                            <span asp-validation-for="TestMessage.Message" class="text-danger"></span>
                            <div class="form-text">
                                <i class="fas fa-info-circle me-1"></i>
                                Test message will be sent to all SMS-enabled users in the selected group
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="TestMessage.GroupId" class="form-label"></label>
                            <select asp-for="TestMessage.GroupId" class="form-select">
                                <option value="">Select a group...</option>
                                @foreach (var group in Model.AvailableGroups)
                                {
                                    <option value="@group.GroupId">@group.GroupName</option>
                                }
                            </select>
                            <span asp-validation-for="TestMessage.GroupId" class="text-danger"></span>
                        </div>

                        @if (!Model.AvailableGroups.Any())
                        {
                            <div class="alert alert-warning">
                                <i class="fas fa-exclamation-triangle me-2"></i>
                                No groups available. Please <a href="/Groups/Create">create a group</a> before testing SMS.
                            </div>
                        }

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-warning" @(Model.AvailableGroups.Any() ? "" : "disabled")>
                                <i class="fas fa-paper-plane me-2"></i>Send Test SMS
                            </button>
                        </div>
                    </form>
                    
                    <form method="post" asp-page-handler="TestHealth" class="mt-2">
                        <div class="d-grid">
                            <button type="submit" class="btn btn-outline-info">
                                <i class="fas fa-heartbeat me-2"></i>Test Health Check
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Testing Instructions -->
            <div class="card shadow">
                <div class="card-header card-header-gradient py-3">
                    <h6 class="m-0 fw-bold">
                        <i class="fas fa-info-circle me-2"></i>Testing Instructions
                    </h6>
                </div>
                <div class="card-body">
                    <h6 class="font-weight-bold">How to Test:</h6>
                    <ol class="small">
                        <li>Select a group that has members with SMS enabled</li>
                        <li>Enter a test message (will include timestamp)</li>
                        <li>Click "Send Test SMS" to queue the message</li>
                        <li>Watch the service status update in real-time</li>
                        <li>Check the <a href="/Audit">Audit page</a> for delivery results</li>
                    </ol>

                    <h6 class="font-weight-bold mt-3">API Testing:</h6>
                    <p class="small">You can also test the API directly:</p>
                    <pre class="bg-light p-2 small">
POST /api/sms/send
{
  "message": "Test message",
  "groupId": 1,
  "alarmId": "TEST-123"
}

GET /status</pre>

                    <h6 class="font-weight-bold mt-3">Holiday Filtering:</h6>
                    <p class="small">
                        SMS delivery respects holiday settings. On sabbatical days, only users with 
                        "Available on Special Days" enabled will receive messages.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══ SMS PREVIEW PANEL ═══ -->
    <div class="row mb-4" x-data="smsPreviewer(@Html.Raw(Model.SettingsJson))">
        <!-- Stats bar -->
        <div class="col-12 mb-2">
            <div class="d-flex align-items-center gap-3 px-3 py-2 rounded" style="background:#f8f9fa;border:1px solid #dee2e6;font-size:.82rem;">
                <i class="fas fa-eye text-secondary me-1"></i>
                <span class="text-muted fw-semibold">Message Preview</span>
                <span class="ms-2">Chars: <strong x-text="charCount">0</strong></span>
                <span>Segments: <strong x-text="segments">1</strong></span>
                <span class="badge ms-1" :class="encoding==='ASCII'?'bg-success':encoding.includes('Hebrew')?'bg-danger':'bg-warning text-dark'" x-text="encoding">ASCII</span>
                <span class="ms-auto text-muted" style="font-size:.76rem;">
                    Provider: <strong class="text-dark" x-text="settings.providerType"></strong>
                    <template x-if="settings.testMode">
                        <span class="badge bg-warning text-dark ms-1" style="font-size:.68rem;">TEST MODE</span>
                    </template>
                </span>
            </div>
        </div>

        <!-- Request Preview -->
        <div class="col-lg-6">
            <div class="card shadow mb-4">
                <div class="card-header card-header-gradient py-2">
                    <h6 class="m-0 fw-bold" style="font-size:.85rem;">
                        <i class="fas fa-code me-2"></i>Request Preview
                        <small class="fw-normal text-muted ms-2" style="font-size:.72rem;">live — updates as you type</small>
                    </h6>
                </div>
                <div class="card-body p-0">
                    <pre class="m-0 p-3 rounded-bottom" style="font-size:.75rem;background:#1e1e1e;color:#d4d4d4;min-height:140px;max-height:280px;overflow-y:auto;white-space:pre-wrap;word-break:break-all;" x-text="requestPreview"></pre>
                </div>
            </div>
        </div>

        <!-- Recipients Preview -->
        <div class="col-lg-6">
            <div class="card shadow mb-4">
                <div class="card-header card-header-gradient py-2 d-flex align-items-center justify-content-between">
                    <h6 class="m-0 fw-bold" style="font-size:.85rem;">
                        <i class="fas fa-users me-2"></i>Recipients Preview
                    </h6>
                    <span class="badge bg-secondary" style="font-size:.72rem;" x-show="recipients.length > 0">
                        <span x-text="recipients.filter(r=>r.smsEnabled).length"></span> will receive
                    </span>
                </div>
                <div class="card-body p-2">
                    <template x-if="!groupId">
                        <div class="text-center text-muted py-4" style="font-size:.82rem;">
                            <i class="fas fa-arrow-up me-1"></i>Select a group above to preview recipients
                        </div>
                    </template>
                    <template x-if="groupId && loadingRecipients">
                        <div class="text-center py-4">
                            <span class="spinner-border spinner-border-sm text-secondary"></span>
                        </div>
                    </template>
                    <template x-if="groupId && !loadingRecipients && recipients.length === 0">
                        <div class="text-center text-muted py-4" style="font-size:.82rem;">
                            <i class="fas fa-user-slash me-1"></i>No members in this group
                        </div>
                    </template>
                    <template x-if="groupId && !loadingRecipients && recipients.length > 0">
                        <div>
                            <table class="table table-sm table-hover align-middle mb-0" style="font-size:.78rem;">
                                <thead class="table-light">
                                    <tr>
                                        <th>Name</th>
                                        <th>Phone</th>
                                        <th class="text-center">SMS</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <template x-for="(r, i) in recipients" :key="i">
                                        <tr :class="r.smsEnabled ? '' : 'table-secondary text-muted'">
                                            <td x-text="r.name || '—'"></td>
                                            <td class="font-monospace" x-text="r.maskedPhone"></td>
                                            <td class="text-center">
                                                <template x-if="r.smsEnabled">
                                                    <i class="fas fa-check-circle text-success"></i>
                                                </template>
                                                <template x-if="!r.smsEnabled">
                                                    <i class="fas fa-times-circle text-danger"></i>
                                                </template>
                                            </td>
                                        </tr>
                                    </template>
                                </tbody>
                            </table>
                        </div>
                    </template>
                </div>
            </div>
        </div>
    </div>

    @if (Model.TestModeActive)
    {
        <!-- ═══ MOCK SERVER TESTER ═══ -->
        <div id="mock-tester" class="mt-4">
            <div class="card shadow">
                <div class="card-header card-header-gradient py-3 d-flex align-items-center justify-content-between">
                    <h6 class="m-0 fw-bold">
                        <i class="fas fa-flask me-2"></i>Mock Server Tester
                        <span class="badge bg-warning text-dark ms-2 fw-normal" style="font-size:.7rem;">TEST MODE</span>
                    </h6>
                    <span class="badge bg-success px-2 py-1" style="font-size:.72rem;">
                        <i class="fas fa-circle me-1" style="font-size:7px;"></i>Active (REST + SOAP)
                    </span>
                </div>
                <div class="card-body" x-data="mockTester('@Model.CurrentProviderType')">

                    <div class="row g-4">
                        <!-- LEFT: Request builder -->
                        <div class="col-lg-5">
                            <!-- Tab selector -->
                            <div class="d-flex gap-2 mb-3">
                                <button type="button" class="btn btn-sm"
                                        :class="activeTab==='REST'?'btn-primary':'btn-outline-primary'"
                                        @@click="activeTab='REST'">
                                    <i class="fas fa-code me-1"></i>REST Mock
                                </button>
                                <button type="button" class="btn btn-sm"
                                        :class="activeTab==='SOAP'?'btn-warning text-dark':'btn-outline-warning'"
                                        @@click="activeTab='SOAP'">
                                    <i class="fas fa-file-code me-1"></i>SOAP Mock
                                </button>
                            </div>

                            <!-- REST form -->
                            <div x-show="activeTab==='REST'" x-transition>
                                <div class="mb-2">
                                    <label class="form-label" style="font-size:.82rem;">Phone Number</label>
                                    <input type="tel" x-model="restPhone" class="form-control form-control-sm"
                                           placeholder="+972501234567" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" style="font-size:.82rem;">Message</label>
                                    <textarea x-model="restMessage" class="form-control form-control-sm" rows="3"
                                              placeholder="Test alarm message..."></textarea>
                                </div>
                                <button type="button" class="btn btn-primary w-100"
                                        @@click="sendMockRest()" :disabled="sending">
                                    <span x-show="sending" class="spinner-border spinner-border-sm me-1"></span>
                                    <i class="fas fa-paper-plane me-1" x-show="!sending"></i>
                                    <span x-text="sending?'Sending...':'Send to Mock REST'"></span>
                                </button>
                                <div class="info-box mt-2" style="font-size:.75rem;">
                                    <code>GET /mock/sms/rest?phone=...&amp;message=...</code>
                                </div>
                            </div>

                            <!-- SOAP form -->
                            <div x-show="activeTab==='SOAP'" x-transition>
                                <div class="mb-2">
                                    <label class="form-label" style="font-size:.82rem;">Phone Number</label>
                                    <input type="tel" x-model="soapPhone" class="form-control form-control-sm"
                                           placeholder="+972501234567" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" style="font-size:.82rem;">Message</label>
                                    <textarea x-model="soapMessage" class="form-control form-control-sm" rows="3"
                                              placeholder="Test alarm message..."></textarea>
                                </div>
                                <button type="button" class="btn btn-warning text-dark w-100"
                                        @@click="sendMockSoap()" :disabled="sending">
                                    <span x-show="sending" class="spinner-border spinner-border-sm me-1"></span>
                                    <i class="fas fa-paper-plane me-1" x-show="!sending"></i>
                                    <span x-text="sending?'Sending...':'Send to Mock SOAP'"></span>
                                </button>
                                <div class="info-box mt-2" style="font-size:.75rem;">
                                    <code>POST /mock/sms/soap</code> — XML envelope with &lt;Phone&gt; and &lt;Message&gt;
                                </div>
                            </div>
                        </div>

                        <!-- RIGHT: Response panel -->
                        <div class="col-lg-7">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span style="font-size:.82rem; font-weight:600; color:#495057;">Response</span>
                                <template x-if="lastStatus">
                                    <span class="badge" :class="lastStatus===200?'bg-success':'bg-danger'"
                                          x-text="lastStatus===200?'200 OK':''+lastStatus+' Error'"></span>
                                </template>
                            </div>
                            <pre class="code-preview" style="min-height:120px; max-height:220px; overflow:auto; font-size:.75rem; white-space:pre-wrap; word-break:break-all;"
                                 x-text="responseText || '— no response yet —'"></pre>

                            <!-- Recent log -->
                            <div class="mt-3">
                                <div class="d-flex align-items-center justify-content-between mb-1">
                                    <span style="font-size:.78rem; font-weight:600; color:#6c757d; text-transform:uppercase; letter-spacing:.3px;">
                                        <i class="fas fa-list me-1"></i>Recent Mock Log
                                    </span>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" style="font-size:.72rem; padding:.15rem .5rem;"
                                            @@click="refreshLog()">
                                        <i class="fas fa-sync-alt"></i>
                                    </button>
                                </div>
                                <div class="border rounded" style="max-height:160px; overflow-y:auto; font-size:.74rem;">
                                    <template x-if="mockLog.length===0">
                                        <div class="text-center text-muted py-3">
                                            <i class="fas fa-inbox me-1"></i>No messages yet
                                        </div>
                                    </template>
                                    <template x-for="(entry, i) in mockLog" :key="i">
                                        <div class="d-flex align-items-center gap-2 px-2 py-1 border-bottom" style="font-size:.72rem;">
                                            <span class="badge" :class="entry.success?'bg-success':'bg-danger'" style="font-size:.62rem;" x-text="entry.providerType"></span>
                                            <span class="text-muted font-monospace" x-text="entry.maskedPhone"></span>
                                            <span class="text-truncate flex-grow-1" x-text="entry.message" style="max-width:200px;"></span>
                                            <span class="text-muted" x-text="new Date(entry.timestamp).toLocaleTimeString()"></span>
                                        </div>
                                    </template>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- How Mock Server Works -->
            <div class="card shadow mt-3">
                <div class="card-header card-header-gradient py-2">
                    <h6 class="m-0 fw-bold" style="font-size:.85rem;">
                        <i class="fas fa-info-circle me-2"></i>How Mock Server Works
                    </h6>
                </div>
                <div class="card-body" style="font-size:.82rem;">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <p class="text-muted mb-2">
                                When <strong>Test Mode is ON</strong>, all SMS sends are intercepted and routed to the
                                built-in mock server. <strong>No real SMS is ever sent.</strong>
                            </p>
                            <ul class="mb-0" style="padding-left:1.2rem;">
                                <li><strong>Failure rate:</strong> ~3% (simulated) — tests your retry logic</li>
                                <li><strong>Log:</strong> last 100 messages, in-memory (reset on restart)</li>
                                <li><strong>Mock ID:</strong> <code>MOCK-yyyyMMddHHmmssff-XXXX</code></li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <div class="code-preview" style="font-size:.72rem; padding:.6rem .8rem;">
<strong class="placeholder-key">REST mock</strong>  GET/POST /mock/sms/rest
  <span class="placeholder-var">→ JSON:</span> { mock, success, messageId }

<strong class="placeholder-key">SOAP mock</strong>  POST /mock/sms/soap
  <span class="placeholder-var">→ XML:</span>  &lt;Success&gt;true/false&lt;/Success&gt;

<strong class="placeholder-key">Log</strong>        GET /mock/sms/status
<strong class="placeholder-key">Reset</strong>      POST /mock/sms/reset</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Show server messages as toasts
            document.querySelectorAll('[data-toast-success]').forEach(el =>
                SCADAUtils.showToast('<i class="fas fa-check-circle me-2"></i>' + el.dataset.toastSuccess, 'success'));
            document.querySelectorAll('[data-toast-error]').forEach(el =>
                SCADAUtils.showToast('<i class="fas fa-exclamation-circle me-2"></i>' + el.dataset.toastError, 'danger'));

            // Loading state on send SMS form
            const sendForm = document.querySelector('form[action*="SendTest"], form[method="post"]');
            if (sendForm) {
                sendForm.addEventListener('submit', function (e) {
                    const btn = this.querySelector('button[type="submit"]');
                    if (btn && !btn.disabled) {
                        SCADAUtils.setButtonLoading(btn, true, 'Sending...');
                    }
                });
            }
        });

        // Auto-refresh status every 5 seconds
        setInterval(refreshStatus, 5000);

        function refreshStatus() {
            fetch('/Test/Sms?handler=RefreshStatus')
                .then(response => response.json())
                .then(data => {
                    document.getElementById('queueSize').textContent = data.queueSize;
                    document.getElementById('messagesSent').textContent = data.messagesSent;
                    document.getElementById('messagesFailed').textContent = data.messagesFailed;
                    document.getElementById('uptime').textContent = data.uptime;
                    document.getElementById('lastMessage').textContent = data.lastMessage || 'Never';
                })
                .catch(error => console.error('Error refreshing status:', error));
        }

        function mockTester(defaultProvider) {
            return {
                activeTab: defaultProvider === 'SOAP' ? 'SOAP' : 'REST',
                restPhone: '',
                restMessage: 'Test alarm from SCADA',
                soapPhone: '',
                soapMessage: 'Test alarm from SCADA',
                sending: false,
                lastStatus: null,
                responseText: '',
                mockLog: [],

                init() {
                    this.refreshLog();
                    setInterval(() => this.refreshLog(), 3000);
                },

                async sendMockRest() {
                    this.sending = true;
                    try {
                        const params = new URLSearchParams({ phone: this.restPhone, message: this.restMessage });
                        const res = await fetch('/mock/sms/rest?' + params);
                        this.lastStatus = res.status;
                        const json = await res.json();
                        this.responseText = JSON.stringify(json, null, 2);
                        await this.refreshLog();
                    } catch (e) {
                        this.responseText = 'Error: ' + e.message;
                        this.lastStatus = 0;
                    } finally {
                        this.sending = false;
                    }
                },

                async sendMockSoap() {
                    this.sending = true;
                    const esc = s => String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
                    try {
                        const body = `<?xml version="1.0" encoding="utf-8"?>
<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/">
  <soapenv:Header/>
  <soapenv:Body>
    <SendSMS>
      <Phone>${esc(this.soapPhone)}</Phone>
      <Message>${esc(this.soapMessage)}</Message>
    </SendSMS>
  </soapenv:Body>
</soapenv:Envelope>`;
                        const res = await fetch('/mock/sms/soap', {
                            method: 'POST',
                            headers: { 'Content-Type': 'text/xml; charset=utf-8' },
                            body
                        });
                        this.lastStatus = res.status;
                        this.responseText = await res.text();
                        await this.refreshLog();
                    } catch (e) {
                        this.responseText = 'Error: ' + e.message;
                        this.lastStatus = 0;
                    } finally {
                        this.sending = false;
                    }
                },

                async refreshLog() {
                    try {
                        const res = await fetch('/mock/sms/status');
                        if (!res.ok) return;
                        const data = await res.json();
                        this.mockLog = (data.recentLog || []).slice(0, 10);
                    } catch { /* silently ignore */ }
                }
            };
        }
    </script>
    <script src="~/js/alpine.min.js" defer></script>

    <script>
        function smsPreviewer(settings) {
            return {
                settings,
                message: document.getElementById('TestMessage_Message')?.value ?? '',
                groupId: null,
                recipients: [],
                loadingRecipients: false,

                get charCount() { return this.message.length; },
                get encoding() {
                    if (/[֐-׿]/.test(this.message)) return 'Hebrew/Unicode';
                    if (/[^\x00-\x7F]/.test(this.message)) return 'Unicode';
                    return 'ASCII';
                },
                get segments() {
                    const max1 = this.encoding === 'ASCII' ? 160 : 70;
                    const maxN = this.encoding === 'ASCII' ? 153 : 67;
                    const n = this.charCount;
                    if (n === 0) return 1;
                    return n <= max1 ? 1 : Math.ceil(n / maxN);
                },
                get requestPreview() {
                    const msg = this.message || '{message}';
                    const phone = '+972XXXXXXXXX';
                    return this.settings.providerType === 'SOAP'
                        ? this.buildSoapPreview(msg, phone)
                        : this.buildRestPreview(msg, phone);
                },

                buildRestPreview(msg, phone) {
                    const endpoint = this.settings.apiEndpoint || '(no endpoint configured)';
                    const method = (this.settings.httpMethod || 'POST').toUpperCase();
                    let params = [];
                    try {
                        const rows = JSON.parse(this.settings.apiParams || '[]');
                        params = rows.filter(r => r.enabled).map(r => ({
                            key: r.key,
                            value: this.resolveValue(r.value, msg, phone)
                        }));
                    } catch { }
                    const ct = this.settings.contentType || 'application/x-www-form-urlencoded';
                    let body = '';
                    if (method === 'GET') {
                        const qs = params.map(p => `${encodeURIComponent(p.key)}=${encodeURIComponent(p.value)}`).join('&');
                        return `GET ${endpoint}${qs ? '?' + qs : ''}\n\n(no body — params in query string)`;
                    }
                    if (ct.includes('json')) {
                        const obj = Object.fromEntries(params.map(p => [p.key, p.value]));
                        body = JSON.stringify(obj, null, 2);
                    } else if (ct.includes('xml')) {
                        body = params.map(p => `<${p.key}>${p.value}</${p.key}>`).join('\n');
                    } else {
                        body = params.map(p => `${p.key}=${p.value}`).join('&');
                    }
                    const headers = this.buildHeaderPreview();
                    return `${method} ${endpoint}\nContent-Type: ${ct}${headers}\n\n${body || '(no params configured)'}`;
                },

                buildSoapPreview(msg, phone) {
                    const endpoint = this.settings.apiEndpoint || '(no SOAP endpoint)';
                    const action = this.settings.soapAction || '';
                    let body = this.settings.soapBodyTemplate || '';
                    if (this.settings.soapParams) {
                        try {
                            const map = JSON.parse(this.settings.soapParams);
                            for (const [token, kw] of Object.entries(map))
                                body = body.replaceAll(`{${token}}`, this.resolveValue(kw, msg, phone));
                        } catch { }
                    } else if (body) {
                        body = body
                            .replace('{Message}', msg).replace('{Phone}', phone)
                            .replace('{Username}', '***').replace('{Password}', '***')
                            .replace('{SenderName}', this.settings.senderName || '');
                    } else {
                        body = `<Phone>${phone}</Phone>\n<Message>${msg}</Message>`;
                    }
                    return `POST ${endpoint}\nSOAPAction: "${action}"\nContent-Type: text/xml; charset=utf-8\n\n[SOAP Envelope body]\n${body}`;
                },

                buildHeaderPreview() {
                    if (!this.settings.apiHeaders) return '';
                    try {
                        const h = JSON.parse(this.settings.apiHeaders);
                        return '\n' + Object.entries(h).map(([k, v]) => `${k}: ${k.toLowerCase().includes('auth') ? '***' : v}`).join('\n');
                    } catch { return ''; }
                },

                resolveValue(keyword, msg, phone) {
                    switch ((keyword || '').toLowerCase()) {
                        case 'message': return msg;
                        case 'phone': case 'phonenumber': case 'mobile': return phone;
                        case 'username': case 'user': return '***';
                        case 'password': case 'pass': return '***';
                        case 'sender_name': case 'sendername': case 'from': return this.settings.senderName || '';
                        case 'tz': return '{TZ}';
                        case 'firstname': return '{FirstName}';
                        case 'lastname': return '{LastName}';
                        case 'sendingsystem': return this.settings.soapSendingSystem || 'SCADA';
                        case 'messagetype': return this.settings.soapMessageType || 'SmsType1';
                        default: return keyword;
                    }
                },

                async fetchRecipients(groupId) {
                    if (!groupId) { this.recipients = []; return; }
                    this.loadingRecipients = true;
                    try {
                        const res = await fetch(`/Test/Sms?handler=GroupMembers&groupId=${groupId}`);
                        if (res.ok) this.recipients = await res.json();
                        else this.recipients = [];
                    } catch { this.recipients = []; }
                    finally { this.loadingRecipients = false; }
                },

                init() {
                    const msgEl = document.getElementById('TestMessage_Message');
                    if (msgEl) {
                        this.message = msgEl.value;
                        msgEl.addEventListener('input', e => { this.message = e.target.value; });
                    }
                    const grpEl = document.getElementById('TestMessage_GroupId');
                    if (grpEl) {
                        this.groupId = grpEl.value || null;
                        if (this.groupId) this.fetchRecipients(this.groupId);
                        grpEl.addEventListener('change', e => {
                            this.groupId = e.target.value || null;
                            this.fetchRecipients(this.groupId);
                        });
                    }
                }
            };
        }
    </script>
}