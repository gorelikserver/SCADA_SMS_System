@page
@model SCADASMSSystem.Web.Pages.Test.SmsModel
@{
    ViewData["Title"] = "Test SMS";
}

@section Breadcrumb {
<div class="breadcrumb-bar">
    <div class="container-fluid px-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-page="/Index"><i class="fas fa-home me-1"></i>Overview</a></li>
                <li class="breadcrumb-item active">Delivery test</li>
            </ol>
        </nav>
    </div>
</div>
}

<div class="container-fluid admin-workspace">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800"><i class="fas fa-vial me-2"></i>Delivery test</h1>
        <a asp-page="/Settings/Provider" class="btn btn-sm btn-outline-secondary"><i class="fas fa-plug me-1"></i>Provider editor</a>
    </div>

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body">
                    <p class="small text-muted">
                        Sends a test alarm to every eligible member of a group, the same way <code>Scada_sms.bat</code> does,
                        and waits for the provider's answer for each one. Results are recorded in the audit log.
                    </p>
                    @if (Model.TestModeActive)
                    {
                        <div class="alert alert-warning py-2 small"><i class="fas fa-flask me-1"></i>Test mode is on: messages go to the in-process mock, not the provider.</div>
                    }
                    else
                    {
                        <div class="alert alert-info py-2 small"><i class="fas fa-paper-plane me-1"></i>Real SMS will be sent with the active profile @(Model.ProviderName != null ? $"'{Model.ProviderName}'" : "(none configured)").</div>
                    }
                    <form method="post" asp-page-handler="Send">
                        <div class="mb-3">
                            <label asp-for="TestMessage.GroupId" class="form-label"></label>
                            <select asp-for="TestMessage.GroupId" class="form-select" id="groupSelect"
                                    asp-items="@(new SelectList(Model.AvailableGroups, "GroupId", "GroupName"))">
                                <option value="">Select a notification team</option>
                            </select>
                            <span asp-validation-for="TestMessage.GroupId" class="text-danger small"></span>
                            <ul class="list-unstyled small mt-2 mb-0" id="groupMembers"></ul>
                        </div>
                        <div class="mb-3">
                            <label asp-for="TestMessage.Message" class="form-label"></label>
                            <textarea asp-for="TestMessage.Message" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="TestMessage.Message" class="text-danger small"></span>
                        </div>
                        <button type="submit" class="btn btn-primary" onclick="this.disabled=true; this.form.submit();">
                            <i class="fas fa-paper-plane me-1"></i>Send test alarm
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            @if (Model.Result != null)
            {
                var r = Model.Result;
                <div class="card shadow-sm @(r.Success ? "border-success" : "border-danger")">
                    <div class="card-body">
                        <h2 class="h5 @(r.Success ? "text-success" : "text-danger")">
                            @(r.Success ? $"Accepted for all {r.RecipientCount} recipient(s)"
                                : r.RecipientCount == 0 ? "No eligible recipients in this group"
                                : $"Only {r.AcceptedCount} of {r.RecipientCount} recipient(s) accepted")
                        </h2>
                        <div class="small text-muted mb-2">Alarm ID <code>@r.AlarmId</code> &mdash; same result Scada_sms.bat would get (exit @(r.Success ? "0" : "3")).</div>
                        @if (r.Recipients.Count > 0)
                        {
                            <table class="table table-sm">
                                <thead><tr><th>Phone</th><th>Result</th><th>HTTP</th><th>Attempts</th><th>Detail</th></tr></thead>
                                <tbody>
                                @foreach (var d in r.Recipients)
                                {
                                    <tr class="@(d.Accepted ? "" : "table-danger")">
                                        <td><code>@d.MaskedPhoneNumber</code></td>
                                        <td>@(d.Accepted ? "Accepted" : "Failed")</td>
                                        <td>@(d.StatusCode <= 0 ? "-" : d.StatusCode.ToString())</td>
                                        <td>@d.Attempts</td>
                                        <td class="small">@d.Message</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
    (function () {
        const select = document.getElementById('groupSelect');
        const list = document.getElementById('groupMembers');
        async function load() {
            list.innerHTML = '';
            if (!select.value) return;
            const res = await fetch('?handler=GroupMembers&groupId=' + encodeURIComponent(select.value));
            const members = await res.json();
            if (!members.length) { list.innerHTML = '<li class="text-danger">No members</li>'; return; }
            for (const m of members) {
                const li = document.createElement('li');
                li.textContent = m.name + ' ' + m.maskedPhone + (m.smsEnabled ? '' : ' (SMS off)');
                if (!m.smsEnabled) li.className = 'text-muted';
                list.appendChild(li);
            }
        }
        select.addEventListener('change', load);
        load();
    })();
</script>
}
