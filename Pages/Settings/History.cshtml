@page
@model SCADASMSSystem.Web.Pages.Settings.HistoryModel
@using SCADASMSSystem.Web.Models
@{
    ViewData["Title"] = "Settings History";
}

@section Breadcrumb {
<div class="breadcrumb-bar">
    <div class="container-fluid px-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-page="/Index"><i class="fas fa-home me-1"></i>Dashboard</a></li>
                <li class="breadcrumb-item"><a asp-page="/Settings/Index">Settings</a></li>
                <li class="breadcrumb-item active">History</li>
            </ol>
        </nav>
    </div>
</div>
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-3">
        <h1 class="h3 mb-0 text-gray-800"><i class="fas fa-history me-2"></i>Settings History</h1>
        <div class="d-flex gap-2">
            <a asp-page="/Settings/Provider" class="btn btn-sm btn-outline-secondary"><i class="fas fa-plug me-1"></i>SMS Provider</a>
            <a asp-page="/Settings/Index" class="btn btn-sm btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>Settings</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success py-2">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger py-2">@TempData["ErrorMessage"]</div>
    }

    <div class="card mb-4">
        <div class="card-header bg-white"><i class="fas fa-layer-group text-primary me-2"></i>Provider profile versions</div>
        <div class="card-body">
            <p class="small text-muted">
                Every activated profile is kept here. <strong>Restore as draft</strong> copies a version (with its stored secrets) into the draft;
                it goes live only after a real verification send and activation in the provider editor. Exports leave secrets empty.
            </p>
            @if (Model.Versions.Count == 0)
            {
                <p class="text-muted mb-0">No profile has been activated yet.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr><th>#</th><th>Profile</th><th>Activated</th><th>Verified</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var v in Model.Versions)
                            {
                                var isActive = v.Id == Model.ActiveVersionId;
                                <tr class="@(isActive ? "table-success" : "")">
                                    <td>@v.Id</td>
                                    <td>
                                        <strong>@v.ProfileName</strong> <span class="badge bg-secondary">@v.ProfileKind</span>
                                        @if (isActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        <div class="small text-muted font-monospace" title="SHA-256 of the profile">@v.ProfileHash[..Math.Min(12, v.ProfileHash.Length)]</div>
                                        @if (!string.IsNullOrEmpty(v.Note))
                                        {
                                            <div class="small text-muted fst-italic">@v.Note</div>
                                        }
                                    </td>
                                    <td class="small">@v.ActivatedAt.ToString("yyyy-MM-dd HH:mm") <div class="text-muted">@(v.ActivatedBy ?? "?")</div></td>
                                    <td class="small">
                                        @if (v.VerifiedAt != null)
                                        {
                                            @v.VerifiedAt?.ToString("yyyy-MM-dd HH:mm") <div class="text-muted">@(v.VerifiedBy ?? "?")</div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">not verified here</span>
                                        }
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <form method="post" asp-page-handler="Restore" class="d-inline"
                                              onsubmit="return confirm('@(Model.HasDraft ? "This replaces the current draft. " : "")Restore version #@v.Id as the draft? It will not be active until you verify and activate it.');">
                                            <input type="hidden" name="id" value="@v.Id" />
                                            <button class="btn btn-sm btn-outline-primary"><i class="fas fa-undo me-1"></i>Restore as draft</button>
                                        </form>
                                        <a class="btn btn-sm btn-outline-secondary" asp-page-handler="Export" asp-route-id="@v.Id"><i class="fas fa-download me-1"></i>Export</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header bg-white"><i class="fas fa-list text-secondary me-2"></i>Recent changes <span class="small text-muted">(newest first, last @HistoryModel.MaxChanges)</span></div>
        <div class="card-body">
            @if (Model.Changes.Count == 0)
            {
                <p class="text-muted mb-0">No changes recorded yet.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr><th>When</th><th>Who</th><th>Area</th><th>Action</th><th>Details</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.Changes)
                            {
                                <tr>
                                    <td class="small text-nowrap">@c.ChangedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    <td class="small">@(c.ChangedBy ?? "?")</td>
                                    <td><span class="badge @(c.Area == SettingsAreas.Provider ? "bg-primary" : "bg-secondary")">@c.Area</span></td>
                                    <td class="small text-nowrap">@c.Action</td>
                                    <td class="small">@c.Summary</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
