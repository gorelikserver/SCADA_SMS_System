                                        <div class="input-group">
                                            <input asp-for="SmsSettingsInput.RateLimit" class="form-control" type="number" min="1" max="1000" />
                                            <span class="input-group-text text-muted" style="font-size:0.8rem;">SMS</span>
                                        </div>
                                        <small class="text-muted">Max messages per rate window</small>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Rate Window</label>
                                        <div class="input-group">
                                            <input asp-for="SmsSettingsInput.RateWindow" class="form-control" type="number" min="1" />
                                            <span class="input-group-text text-muted" style="font-size:0.8rem;">sec</span>
                                        </div>
                                        <small class="text-muted">Window duration in seconds</small>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Duplicate Window</label>
                                        <div class="input-group">
                                            <input asp-for="SmsSettingsInput.DuplicateWindow" class="form-control" type="number" min="0" />
                                            <span class="input-group-text text-muted" style="font-size:0.8rem;">min</span>
                                        </div>
                                        <small class="text-muted">Block identical messages within this period</small>
                                    </div>
                                </div>
                                <hr class="section-divider">
                                <h6 class="fw-bold text-muted mb-3" style="font-size:0.8rem; text-transform:uppercase; letter-spacing:0.5px;">
                                    <i class="fas fa-network-wired me-1"></i>Connection
                                </h6>
                                <div class="row g-3">
                                    <div class="col-md-3">
                                        <label class="form-label">Timeout</label>
                                        <div class="input-group">
                                            <input asp-for="SmsSettingsInput.TimeoutSeconds" class="form-control" type="number" min="5" max="300" />
                                            <span class="input-group-text text-muted" style="font-size:0.8rem;">sec</span>
