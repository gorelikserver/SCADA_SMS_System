                                <i class="fas fa-history me-1"></i>Audit
                            </a>
                        </div>
                        <div class="col-md-3">
                            <a href="/Test/Sms" class="btn btn-outline-warning btn-sm w-100">
                                <i class="fas fa-paper-plane me-1"></i>Test SMS
                            </a>
                        </div>
                    </div>
                </div>
            </div>

        </div><!-- /right col -->
    </div><!-- /row -->
</div>

@section Scripts {
<script src="~/js/alpine.min.js" defer></script>
<script>
    function settingsApp() {
        const DYNAMIC_KEYWORDS = [
            'message','msg','text','body',
            'phone','phonenumber','mobile','number',
            'username','user','userid',
            'password','pass',
            'sender_name','sendername','sender','from',
            'tz','firstname','lastname',
            'sendingsystem','messagetype',
            // SCADA payload-derived dynamic vars (forwarded by Scada_sms.bat)
            'group_id','groupid','value','alarm_id','alarmid','priority'
        ];

        function detectType(value) {
            const v = String(value).toLowerCase().trim();
            if (DYNAMIC_KEYWORDS.includes(v)) return 'dynamic';
            if (value.trim() === '') return 'default';
            return 'static';
        }

        // Stable per-row identity. Required because <template x-for> uses :key="row._id"
        // to track rows across splice/reorder. Without a stable key, Alpine recycles DOM
        // nodes by index and clicking the delete button on row N appears to remove the
        // last row instead (and checkbox ticks bleed across rows after a remove).
        //
        // The counter is page-scoped, so we MUST re-stamp every row on load (including
        // rows restored from a localStorage draft whose _id values came from a previous
        // page-load counter). Otherwise collisions like __r1 == __r1 raise Alpine's
        // "Duplicate key on x-for" warning and crash with "Cannot read properties of
        // undefined (reading 'after')".
        let __rowIdSeq = 0;
        function nextRowId() { return '__r' + (++__rowIdSeq); }
        function stampRowIds(rows) {
            if (!Array.isArray(rows)) return rows;
            rows.forEach(r => { if (r) r._id = nextRowId(); });
            return rows;
        }
        // Back-compat alias used in a few callers below.
        const ensureRowIds = stampRowIds;

        function parseJsonToRows(jsonStr) {
            if (!jsonStr || jsonStr.trim() === '' || jsonStr.trim() === '{}') return [];
            try {
                const obj = JSON.parse(jsonStr);
                return Object.entries(obj).map(([k, v]) => {
                    const isDyn = DYNAMIC_KEYWORDS.includes(String(v).toLowerCase().trim());
                    return {
                        _id: nextRowId(),
                        enabled: true,
                        key: k,
                        value: String(v),
                        isDynamic: isDyn,
                        paramType: detectType(v)
                    };
                });
            } catch { return []; }
        }

        function rowsToJson(rows) {
            const obj = {};
            rows.forEach(r => {
                if (r.enabled && r.key.trim() !== '') obj[r.key.trim()] = r.value;
            });
            return JSON.stringify(obj);
        }

        function makeRow() {
            return { _id: nextRowId(), enabled: true, key: '', value: '', isDynamic: false, paramType: 'static' };
        }

        function q(name) { return document.querySelector('[name="' + name + '"]'); }

        return {
            rowsToJson,
            providerType: 'REST',
            httpMethod: 'POST',
            endpoint: '',
            contentType: 'application/x-www-form-urlencoded',
            paramRows: [],
            headerRows: [],
            soapParamRows: [],
            soapAction: '',
            soapAuthType: 'WSSecurity',
            soapTemplate: '',
            soapNamespaces: '',
            soapMsgType: '',
            soapSendingSys: '',
            successPattern: '',
            failurePattern: '',
            soapSuccessPattern: '',
            soapErrorPattern: '',
            restTab: 'params',
            testMode: false,
            restAuthType: 'None',

            init() {
                // 1. Load baseline from server-rendered hidden inputs
                this.providerType  = q('SmsSettingsInput.ProviderType')?.value  || 'REST';
                this.httpMethod    = q('SmsSettingsInput.HttpMethod')?.value    || 'POST';
                this.endpoint      = q('SmsSettingsInput.ApiEndpoint')?.value   || '';
                this.contentType   = q('SmsSettingsInput.ContentType')?.value   || 'application/x-www-form-urlencoded';
                this.soapAction    = q('SmsSettingsInput.SoapAction')?.value    || '';
                this.soapAuthType  = q('SmsSettingsInput.SoapAuthType')?.value  || 'WSSecurity';
                this.soapTemplate  = q('SmsSettingsInput.SoapBodyTemplate')?.value || '';
                this.soapNamespaces= q('SmsSettingsInput.SoapEnvelopeNamespaces')?.value || '';
                this.soapMsgType   = q('SmsSettingsInput.SoapMessageType')?.value    || '';
                this.soapSendingSys= q('SmsSettingsInput.SoapSendingSystem')?.value  || '';
                this.successPattern= q('SmsSettingsInput.RestSuccessPattern')?.value || '';
                this.failurePattern= q('SmsSettingsInput.RestFailurePattern')?.value || '';
                this.soapSuccessPattern = q('SmsSettingsInput.SoapSuccessPattern')?.value || '';
                this.soapErrorPattern   = q('SmsSettingsInput.SoapErrorPattern')?.value   || '';
                // TestMode: read server-rendered hidden input ("True"/"False") rendered by asp-for
                const tmEl = q('SmsSettingsInput.TestMode');
                this.testMode = tmEl ? /^(true|on|1)$/i.test(String(tmEl.value).trim()) : false;
                this.restAuthType  = q('SmsSettingsInput.RestAuthType')?.value || 'None';

                this.paramRows     = parseJsonToRows(q('SmsSettingsInput.ApiParams')?.value  || '');
                this.headerRows    = parseJsonToRows(q('SmsSettingsInput.ApiHeaders')?.value || '');
                this.soapParamRows = parseJsonToRows(q('SmsSettingsInput.SoapParams')?.value || '');
                if (!this.paramRows.length)  this.paramRows.push(makeRow());
                if (!this.headerRows.length) this.headerRows.push(makeRow());
                if (!this.soapParamRows.length) {
                    this.soapParamRows = [
                        { enabled: true,  key: 'Message',   value: 'message',     isDynamic: true, paramType: 'dynamic' },
                        { enabled: true,  key: 'Phone',     value: 'phone',       isDynamic: true, paramType: 'dynamic' },
                        { enabled: false, key: 'TZ',        value: 'tz',          isDynamic: true, paramType: 'dynamic' },
                        { enabled: false, key: 'FirstName', value: 'firstName',   isDynamic: true, paramType: 'dynamic' },
                        { enabled: false, key: 'LastName',  value: 'lastName',    isDynamic: true, paramType: 'dynamic' },
                        { enabled: false, key: 'Username',  value: 'username',    isDynamic: true, paramType: 'dynamic' },
                        { enabled: false, key: 'SenderName',value: 'sender_name', isDynamic: true, paramType: 'dynamic' },
                    ];
                }
                ensureRowIds(this.paramRows);
                ensureRowIds(this.headerRows);
                ensureRowIds(this.soapParamRows);

                // Mark mandatory rows so the UI can lock them. SCADA payload contract
                // (per Scada_sms.bat / SmsRequest DTO):
                //   * `message` is the only MANDATORY locked dynamic var (cannot disable/delete).
                //   * `group_id`, `value`, `alarm_id`, `priority` are SCADA-optional rows that
                //     are ALWAYS shown but ship disabled \u2014 admins toggle them on per gateway.
                //   * Per-recipient (phone/tz/firstName/lastName) and platform (username/
                //     password/sender_name/sendingSystem/messageType) vars are added manually
                //     via the \"Add variable\" picker dropdown.
                const restMandatory  = [{ keyword: 'message',  defaultKey: 'message' }];
                const soapMandatory  = [{ keyword: 'message',  defaultKey: 'Message' }];
                const scadaOptional  = [
                    { keyword: 'group_id', defaultKey: 'group_id' },
                    { keyword: 'value',    defaultKey: 'value' },
                    { keyword: 'alarm_id', defaultKey: 'alarm_id' },
                    { keyword: 'priority', defaultKey: 'priority' }
                ];
                const scadaOptionalSoap = [
                    { keyword: 'group_id', defaultKey: 'GroupId' },
                    { keyword: 'value',    defaultKey: 'Value' },
                    { keyword: 'alarm_id', defaultKey: 'AlarmId' },
                    { keyword: 'priority', defaultKey: 'Priority' }
                ];
                this._enforceMandatory(this.paramRows,     restMandatory, scadaOptional);
                this._enforceMandatory(this.soapParamRows, soapMandatory, scadaOptionalSoap);

                // 2. Restore unsaved draft from localStorage (Postman-style sticky state)
                //    NOTE: server-of-truth scalars are intentionally NOT restored from draft —
                //    they must reflect actual saved server state to avoid stale-draft bugs:
                //      - testMode (auto-saved on confirm)
                //      - providerType (auto-saved on switch confirm)
                //      - restAuthType / soapAuthType (security posture should not flip silently)
                try {
                    const draft = JSON.parse(localStorage.getItem('scada_settings_draft') || 'null');
                    if (draft) {
                        ['httpMethod','endpoint','contentType','soapAction',
                         'soapTemplate','soapNamespaces','soapMsgType','soapSendingSys',
                         'successPattern','failurePattern','soapSuccessPattern','soapErrorPattern']
                            .forEach(k => { if (draft[k] !== undefined) this[k] = draft[k]; });
                        if (Array.isArray(draft.paramRows)     && draft.paramRows.length)     this.paramRows     = ensureRowIds(draft.paramRows);
                        if (Array.isArray(draft.headerRows)    && draft.headerRows.length)    this.headerRows    = ensureRowIds(draft.headerRows);
                        if (Array.isArray(draft.soapParamRows) && draft.soapParamRows.length) this.soapParamRows = ensureRowIds(draft.soapParamRows);
                    }
                } catch { }
                // Strip any mandatory/scadaOptional flags from ALL rows before re-enforcing.
                // Stale drafts may have these flags set incorrectly (e.g. all rows locked).
                const stripFlags = r => { delete r.mandatory; delete r.scadaOptional; };
                this.paramRows.forEach(stripFlags);
                this.soapParamRows.forEach(stripFlags);
                this._enforceMandatory(this.paramRows,     restMandatory, scadaOptional);
                this._enforceMandatory(this.soapParamRows, soapMandatory, scadaOptionalSoap);

                // 3. Watch scalars → auto-save draft on any change
                ['providerType','httpMethod','endpoint','contentType','soapAction','soapAuthType',
                 'soapTemplate','soapNamespaces','soapMsgType','soapSendingSys',
                 'successPattern','failurePattern','soapSuccessPattern','soapErrorPattern','testMode','restAuthType']
                    .forEach(k => this.$watch(k, () => this._saveDraft()));

                // 4. Deep-watch row arrays so unticking enabled or editing key/value
                //    persists to the draft. Without this, ticks/edits get reverted on
                //    reload because the older draft (from the last add/remove) replays.
                ['paramRows','headerRows','soapParamRows']
                    .forEach(k => this.$watch(k, () => this._saveDraft(), { deep: true }));
            },

            // ── Confirmation handlers ──────────────────────────────────────────────────────────
            async requestProviderSwitch(target) {
                if (this.providerType === target) return;
                if (!window.SCADAUtils || !SCADAUtils.confirmModal) {
                    this.providerType = target;
                    this._autoSaveAfterToggle();
                    return;
                }
                const ok = await SCADAUtils.confirmModal(
                    'Switch SMS Provider to ' + target + '?',
                    'Switching the provider will change how SMS messages are delivered to your provider. ' +
                    'Make sure your ' + target + ' configuration (endpoint, params, security) is correct before saving. ' +
                    'Confirming will save settings immediately so the new provider takes effect across the system.',
                    'Switch & Save',
                    'btn-primary'
                );
                if (ok) {
                    this.providerType = target;
                    this._autoSaveAfterToggle();
                }
            },

            async requestTestModeToggle(ev) {
                const desired = !!ev.target.checked;
                if (desired === this.testMode) return;
                if (!window.SCADAUtils || !SCADAUtils.confirmModal) {
                    this.testMode = desired;
                    return;
                }
                let title, body, label, cls;
                if (desired) {
                    title = 'Enable Test Mode?';
                    body  = 'Test Mode intercepts ALL outgoing SMS through the in-process mock server. ' +
                            'No real messages will be delivered to recipients. Use only for testing.';
                    label = 'Enable Test Mode';
                    cls   = 'btn-warning';
                } else {
                    title = 'Disable Test Mode — Switch to LIVE?';
                    body  = 'WARNING: Disabling Test Mode will route SMS to the LIVE provider. ' +
                            'In a production environment this may activate the real SMS server and send real messages to recipients. Continue?';
                    label = 'Disable & Go Live';
                    cls   = 'btn-danger';
                }
                const ok = await SCADAUtils.confirmModal(title, body, label, cls);
                if (ok) {
                    this.testMode = desired;
                    // Persist immediately so navigating away and back reflects the saved value.
                    this._autoSaveAfterToggle();
                } else {
                    // revert checkbox visual state
                    ev.target.checked = this.testMode;
                }
            },

            // Submits the settings form so a critical toggle (provider / test-mode) persists
            // without forcing the user to scroll down and click Save Settings. Clears the
            // localStorage draft first so it doesn't replay over the freshly saved server value.
            _autoSaveAfterToggle() {
                try { localStorage.removeItem('scada_settings_draft'); } catch { }
                // Defer one tick so Alpine has flushed :value bindings on hidden inputs.
                setTimeout(() => {
                    const form = document.getElementById('settingsForm');
                    if (form) form.submit();
                }, 50);
            },

            _saveDraft() {
                try {
                    // Strip the page-scoped _id before persisting — it's regenerated on
                    // every load, so saving it would just risk collisions if old drafts
                    // get restored after the in-memory counter has advanced.
                    const stripIds = rows => Array.isArray(rows)
                        ? rows.map(r => { const { _id, ...rest } = r; return rest; })
                        : rows;
                    localStorage.setItem('scada_settings_draft', JSON.stringify({
                        providerType: this.providerType, httpMethod: this.httpMethod,
                        endpoint: this.endpoint, contentType: this.contentType,
                        soapAction: this.soapAction, soapAuthType: this.soapAuthType,
                        soapTemplate: this.soapTemplate, soapNamespaces: this.soapNamespaces,
                        soapMsgType: this.soapMsgType, soapSendingSys: this.soapSendingSys,
                        successPattern: this.successPattern, failurePattern: this.failurePattern,
                        soapSuccessPattern: this.soapSuccessPattern, soapErrorPattern: this.soapErrorPattern,
                        testMode: this.testMode,
                        restAuthType: this.restAuthType,
                        paramRows: stripIds(this.paramRows),
                        headerRows: stripIds(this.headerRows),
                        soapParamRows: stripIds(this.soapParamRows)
                    }));
                } catch { }
            },

            addParamRow()  { this.paramRows.push(makeRow()); this._saveDraft(); },
            removeParamRow(i)  {
                const r = this.paramRows[i];
                if (r && r.mandatory) return;
                this.paramRows.splice(i, 1);
                if (!this.paramRows.length) this.addParamRow(); else this._saveDraft();
            },
            addHeaderRow() { this.headerRows.push(makeRow()); this._saveDraft(); },
            removeHeaderRow(i) { this.headerRows.splice(i, 1); if (!this.headerRows.length) this.addHeaderRow(); else this._saveDraft(); },
            addSoapParamRow()  { this.soapParamRows.push(makeRow()); this._saveDraft(); },
            removeSoapParamRow(i) {
                const r = this.soapParamRows[i];
                if (r && r.mandatory) return;
                this.soapParamRows.splice(i, 1);
                if (!this.soapParamRows.length) this.addSoapParamRow(); else this._saveDraft();
            },

            // Insert a new dynamic row pre-filled with the chosen keyword. Used by the
            // "Add user/platform variable" picker dropdown in both REST and SOAP tables.
            addDynamicRow(rowsName, keyword) {
                if (!keyword) return;
                const target = this[rowsName];
                if (!Array.isArray(target)) return;
                target.push({ _id: nextRowId(), enabled: true, key: keyword, value: keyword, isDynamic: true, paramType: 'dynamic' });
                this._saveDraft();
            },

            // SCADA payload contract (per Scada_sms.bat & SmsRequest DTO):
            //   message       — MANDATORY (locked, cannot disable/delete)
            //   group_id      — optional, resolved server-side, available as dynamic var
            //   value         — optional measurement value
            //   alarm_id      — optional alarm correlation id
            //   priority      — optional (normal|urgent|critical)
            // Per-recipient vars (phone, tz, firstName, lastName) and platform vars
            // (username, password, sender_name, sendingSystem, messageType) are added manually
            // by the admin via the "Add variable" picker.
            _enforceMandatory(rows, mandatorySpecs, scadaOptionalSpecs) {
                mandatorySpecs.forEach(spec => {
                    const existing = rows.find(r =>
                        String(r.value || '').toLowerCase().trim() === spec.keyword);
                    if (existing) {
                        existing.mandatory = true;
                        existing.scadaOptional = false;
                        existing.enabled = true;
                        existing.isDynamic = true;
                        existing.paramType = 'dynamic';
                    } else {
                        rows.unshift({
                            _id: nextRowId(),
                            mandatory: true,
                            enabled: true,
                            key: spec.defaultKey,
                            value: spec.keyword,
                            isDynamic: true,
                            paramType: 'dynamic'
                        });
                    }
                });
                if (Array.isArray(scadaOptionalSpecs)) {
                    scadaOptionalSpecs.forEach(spec => {
                        const existing = rows.find(r =>
                            String(r.value || '').toLowerCase().trim() === spec.keyword);
                        if (existing) {
                            existing.scadaOptional = true;
                            existing.isDynamic = true;
                            // do NOT force enabled — admin may have unchecked it intentionally
                        }
                        // Do NOT auto-insert: only mark rows already present.
                        // If the user deleted a scadaOptional row it should stay gone.
                    });
                }
            },

            onValueChange(row) {
                row.isDynamic = DYNAMIC_KEYWORDS.includes(String(row.value).toLowerCase().trim());
                const auto = detectType(row.value);
                if (auto === 'dynamic') row.paramType = 'dynamic';
                else if (row.paramType === 'dynamic') row.paramType = 'static';
                this._saveDraft();
            },

            insertPlaceholder(ph) {
                const ta = document.getElementById('soapTemplateArea');
                if (!ta) return;
                const s = ta.selectionStart, e = ta.selectionEnd;
                this.soapTemplate = this.soapTemplate.substring(0, s) + ph + this.soapTemplate.substring(e);
                this.$nextTick(() => { ta.selectionStart = ta.selectionEnd = s + ph.length; ta.focus(); });
            },

            get restPreview() {
                const enabled = this.paramRows.filter(r => r.enabled && r.key.trim());
                const url = this.endpoint || 'https://…';
                if (this.httpMethod === 'GET') {
                    const qs = enabled.map(r => {
                        const k = encodeURIComponent(r.key.trim());
                        const v = r.isDynamic ? '{' + r.value + '}' : encodeURIComponent(r.value);
                        return k + '=' + v;
                    }).join('&');
                    return url + (qs ? '?' + qs : '');
                }
                const hLines = this.headerRows.filter(r => r.enabled && r.key.trim())
                    .map(r => r.key.trim() + ': ' + r.value).join('\n');
                let body = '';
                if (this.contentType === 'application/json') {
                    const obj = {};
                    enabled.forEach(r => { obj[r.key.trim()] = r.isDynamic ? '{' + r.value + '}' : r.value; });
                    body = JSON.stringify(obj, null, 2);
                } else {
                    body = enabled.map(r => {
                        const k = encodeURIComponent(r.key.trim());
                        const v = r.isDynamic ? '{' + r.value + '}' : encodeURIComponent(r.value);
                        return k + '=' + v;
                    }).join('&');
                }
                return this.httpMethod + ' ' + url + ' HTTP/1.1\n'
                    + 'Content-Type: ' + this.contentType
                    + (hLines ? '\n' + hLines : '')
                    + '\n\n' + body;
            },

            get bodyPreviewHtml() {
                const raw = this.restPreview;
                const parts = raw.split('\n\n');
                const body = parts.slice(1).join('\n\n') || '(configure params first)';
                return body.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
                    .replace(/\{([^}]+)\}/g,'<span class="pm-token">{$1}</span>');
            },

            get soapPreview() {
                const ns = this.soapNamespaces ? '\n    ' + this.soapNamespaces : '';
                let bodyContent = this.soapTemplate ||
                    '<ns1:SendSMS xmlns:ns1="http://tempuri.org/">\n  <ns1:Message>{Message}</ns1:Message>\n  <ns1:Phone>{Phone}</ns1:Phone>\n  <ns1:UserName>{Username}</ns1:UserName>\n  <ns1:Password>{Password}</ns1:Password>\n  <ns1:SenderName>{SenderName}</ns1:SenderName>\n  <ns1:MessageType>' + (this.soapMsgType || '{MessageType}') + '</ns1:MessageType>\n  <ns1:SendingSystem>' + (this.soapSendingSys || '{SendingSystem}') + '</ns1:SendingSystem>\n</ns1:SendSMS>';

                // Apply KV table mappings: dynamic keywords shown as {keyword}, static shown inline
                this.soapParamRows.filter(r => r.enabled && r.key.trim()).forEach(r => {
                    const resolved = r.isDynamic ? '{' + r.value + '}' : r.value;
                    bodyContent = bodyContent.replaceAll('{' + r.key.trim() + '}', resolved);
                });

                let secHeader = '  <soapenv:Header/>\n';
                if (this.soapAuthType === 'WSSecurity') {
                    secHeader = '  <soapenv:Header>\n    <wsse:Security xmlns:wsse="http://schemas.xmlsoap.org/ws/2002/07/secext">\n      <wsse:UsernameToken>\n        <wsse:Username>{Username}</wsse:Username>\n        <wsse:Password>{Password}</wsse:Password>\n      </wsse:UsernameToken>\n    </wsse:Security>\n  </soapenv:Header>\n';
                }

                return 'POST ' + (this.endpoint || '/') + ' HTTP/1.1\n'
                    + 'SOAPAction: "' + this.soapAction + '"\n'
                    + 'Content-Type: text/xml; charset=utf-8\n\n'
                    + '<?xml version="1.0" encoding="utf-8"?>\n'
                    + '<soapenv:Envelope\n    xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/"' + ns + '>\n'
                    + secHeader
                    + '  <soapenv:Body>\n    ' + bodyContent + '\n  </soapenv:Body>\n'
                    + '</soapenv:Envelope>';
            },

            get activePreviewHtml() {
                const raw = this.providerType === 'SOAP' ? this.soapPreview : this.restPreview;
                return raw
                    .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
                    .replace(/\{([^}]+)\}/g,'<span class="pm-token">{$1}</span>');
            }
        };
    }

    function togglePassword() {
        const f = document.getElementById('passwordField');
        const icon = document.getElementById('togglePwIcon');
        if (f.type === 'password') {
            f.type = 'text';
            icon.className = 'fas fa-eye-slash';
        } else {
            f.type = 'password';
            icon.className = 'fas fa-eye';
        }
    }

    async function confirmCleanupData() {
        if (!window.SCADAUtils || !SCADAUtils.confirmModal) {
            if (window.confirm('Delete audit records older than 90 days?'))
                document.getElementById('cleanupDataForm').submit();
            return;
        }
        const ok = await SCADAUtils.confirmModal(
            'Delete Old Audit Records',
            'This will permanently delete all SMS audit records older than 90 days. This action cannot be undone.',
            'Delete', 'btn-danger');
        if (ok) document.getElementById('cleanupDataForm').submit();
    }

    // Save button loading state + sync textarea value before submit
    document.getElementById('settingsForm').addEventListener('submit', function () {
        // Ensure the hidden textarea value is current (Alpine `:value` may lag)
        const ta = document.getElementById('soapTemplateArea');
        const htx = document.querySelector('[name="SmsSettingsInput.SoapBodyTemplate"]');
        if (ta && htx) htx.value = ta.value;
        const btn = document.getElementById('saveBtn');
        btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Saving…';
        btn.disabled = true;
    });

    // Auto-dismiss alerts
    setTimeout(() => {
        document.querySelectorAll('.alert-dismissible').forEach(el => {
            new bootstrap.Alert(el).close();
        });
    }, 6000);

    // Tooltips
    document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(el => new bootstrap.Tooltip(el));
</script>
}
