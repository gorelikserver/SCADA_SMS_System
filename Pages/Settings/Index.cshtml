                                            PCIM Object ID
                                            <span class="badge bg-warning text-dark ms-1" style="font-size:0.65rem;" data-bs-toggle="tooltip"
                                                  title="Deployment-specific. Check WinCC OA panel for the correct value.">deployment-specific</span>
                                        </label>
                                        <input asp-for="SmsSettingsInput.ScadaPcimObjectId" class="form-control font-monospace" type="number" />
                                        <small class="text-muted">Used in alarm action commands</small>
                                    </div>
                                </div>
                                <div class="mt-2">
                                    <label class="form-label">Generated Alarm Command</label>
                                    <pre class="bg-dark text-success rounded-3 p-3" style="font-size:0.75rem; white-space:pre-wrap; word-break:break-all;">'Run '+getalias('PCIMUTIL')+'Scada_sms.bat'+' "+'"+GetValue(PFWALARMNG|PCIM!<span class="text-warning">@Model.SmsSettingsInput.ScadaPcimObjectId</span>:(ThisObject).DESCRIPTION)+'"'+<span class="text-info">[GROUP_ID]</span>+' "+GetValue(PFWALARMNG|PCIM!<span class="text-warning">@Model.SmsSettingsInput.ScadaPcimObjectId</span>:(ThisObject).ALM_VALUE)+'"'</pre>
                                </div>
                                <div class="warning-box mt-2">
                                    <i class="fas fa-exclamation-triangle me-1"></i>
                                    After changing <strong>PCIM Object ID</strong>, update all alarm action scripts in WinCC OA to use the new ID.
                                </div>
                            </div>

                            <!-- TEST MODE TAB -->
                            <div class="tab-pane fade" id="pane-testmode" role="tabpanel">
                                <h6 class="fw-bold text-muted mb-3" style="font-size:0.8rem; text-transform:uppercase; letter-spacing:0.5px;">
                                    <i class="fas fa-flask me-1"></i>Test Mode — In-Process Mock SMS Server
                                </h6>

                                <div class="row g-3 mb-3">
                                    <div class="col-12">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" role="switch"
                                                   id="testModeSwitch"
                                                   :checked="testMode"
                                                   @@change="requestTestModeToggle($event)"
                                                   style="width:3em; height:1.5em;" />
                                            <label class="form-check-label ms-2 fw-semibold" for="testModeSwitch">
                                                Enable Test Mode
                                                <span x-show="testMode" class="badge bg-warning text-dark ms-2" style="font-size:.65rem;">ACTIVE</span>
                                            </label>
                                        </div>
                                        <small class="text-muted d-block mt-1">
                                            When enabled, all SMS calls are intercepted by the in-process mock — no real messages are sent.
                                            The mock simulates a ~3% failure rate.
                                        </small>
                                    </div>
                                </div>

                                @if (Model.SmsSettingsInput.TestMode)
                                {
                                    <div class="alert alert-warning border-0 rounded-3 d-flex align-items-center gap-3 mb-3">
                                        <i class="fas fa-exclamation-triangle fa-lg"></i>
                                        <div>
                                            <strong>Test Mode is ACTIVE.</strong>
                                            SMS calls go to the in-process mock, not the real provider.
                                            <a href="/mock/sms/status" target="_blank" class="alert-link ms-2">
                                                <i class="fas fa-external-link-alt me-1"></i>View mock log →
                                            </a>
                                        </div>
                                    </div>
                                }

                                <div class="info-box mb-3">
                                    <i class="fas fa-info-circle me-1"></i>
                                    Mock endpoints (active only in Test Mode):
                                    <ul class="mb-0 mt-1" style="font-size:0.85em;">
                                        <li><code>GET/POST /mock/sms/rest</code> — simulated REST response</li>
                                        <li><code>POST /mock/sms/soap</code> — simulated SOAP response</li>
                                        <li><code>GET /mock/sms/status</code> — intercepted message log (JSON)</li>
                                        <li><code>POST /mock/sms/reset</code> — reset mock counters</li>
                                    </ul>
                                </div>

                                @if (Model.SmsSettingsInput.TestMode)
                                {
