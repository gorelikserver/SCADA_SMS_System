                                                          x-text="paramRows.filter(r=>r.enabled&&r.key.trim()).length"></span>
                                                </button>
                                                <button type="button" class="pm-inner-tab"
                                                        :class="restTab==='headers'?'active':''"
                                                        @@click="restTab='headers'">
                                                    Headers
                                                    <span class="pm-tab-badge"
                                                          x-text="headerRows.filter(r=>r.enabled&&r.key.trim()).length"></span>
                                                </button>
                                                <button type="button" class="pm-inner-tab"
                                                        :class="restTab==='body'?'active':''"
                                                        @@click="restTab='body'">
                                                    Body
                                                </button>
                                                <button type="button" class="pm-inner-tab"
                                                        :class="restTab==='advanced'?'active':''"
                                                        @@click="restTab='advanced'">
                                                    Advanced
                                                </button>
                                            </div>

                                            <div class="pm-tab-content">

                                                <!-- PARAMS tab -->
                                                <div x-show="restTab==='params'">
                                                    <div class="pm-kv-table">
                                                        <div class="pm-kv-header">
                                                            <span></span><span>Key</span>
                                                            <span>Value</span><span>Type</span><span></span>
                                                        </div>
                                                        <template x-for="(row, i) in paramRows" :key="i">
                                                            <div class="pm-kv-row" :class="(!row.enabled?'pm-row-disabled ':'')+(!row.enabled||row.paramType==='default'?'pm-row-default':'')">
                                                                <input type="checkbox" x-model="row.enabled" class="pm-row-check" />
                                                                <input type="text" x-model="row.key" class="pm-kv-key" placeholder="key" />
                                                                <div class="pm-value-cell">
                                                                    <template x-if="row.isDynamic">
                                                                        <div class="d-flex align-items-center gap-1 w-100">
                                                                            <span class="pm-dynamic-pill"><i class="fas fa-bolt me-1" style="font-size:.65em;"></i><span x-text="'{'+row.value+'}'"></span></span>
                                                                            <select x-model="row.value" @@change="onValueChange(row)" class="pm-kv-val-select-sm">
                                                                                <option value="">↩ literal</option>
                                                                                <option value="message">message</option>
                                                                                <option value="phone">phone</option>
                                                                                <option value="username">username</option>
                                                                                <option value="password">password</option>
                                                                                <option value="sender_name">sender_name</option>
                                                                            </select>
                                                                        </div>
                                                                    </template>
                                                                    <template x-if="!row.isDynamic">
                                                                        <div class="d-flex align-items-center gap-1 w-100">
                                                                            <input type="text" x-model="row.value" @@input="onValueChange(row)"
                                                                                   class="pm-kv-val-input" placeholder="value" />
                                                                            <select @@change="row.value=$event.target.value;onValueChange(row);$event.target.value=''"
                                                                                    class="pm-kv-dyn-picker" title="Insert dynamic variable">
                                                                                <option value="">⚡</option>
                                                                                <option value="message">message</option>
                                                                                <option value="phone">phone</option>
                                                                                <option value="username">username</option>
                                                                                <option value="password">password</option>
                                                                                <option value="sender_name">sender_name</option>
                                                                            </select>
                                                                        </div>
                                                                    </template>
                                                                </div>
                                                                <div>
                                                                    <select x-model="row.paramType"
                                                                            class="pm-type-select"
                                                                            :class="'pm-type-'+(row.paramType||'static')"
                                                                            :title="row.paramType==='dynamic'?'Resolved from SCADA at send time':row.paramType==='static'?'Fixed literal value':'Placeholder — sent as-is'">
                                                                        <option value="dynamic" :disabled="!row.isDynamic">Dynamic</option>
                                                                        <option value="static">Static</option>
                                                                        <option value="default">Default</option>
                                                                    </select>
                                                                </div>
                                                                <button type="button" class="pm-row-del" @@click="removeParamRow(i)" title="Remove">
                                                                    <i class="fas fa-times"></i>
                                                                </button>
                                                            </div>
                                                        </template>
                                                    </div>
                                                    <!-- Type legend -->
                                                    <div class="pm-param-legend">
                                                        <span><span class="pm-legend-dot-dynamic"></span>Dynamic — resolved from SCADA at send time</span>
                                                        <span><span class="pm-legend-dot-static"></span>Static — fixed literal value</span>
                                                        <span><span class="pm-legend-dot-default"></span>Default — placeholder, sent as-is</span>
                                                        <span class="ms-auto"><i class="fas fa-info-circle me-1"></i>Uncheck row to exclude from request</span>
                                                    </div>
                                                    <button type="button" class="pm-add-row-btn" @@click="addParamRow()">
                                                        <i class="fas fa-plus me-1"></i>Add Parameter
                                                    </button>
                                                </div>

                                                <!-- HEADERS tab -->
                                                <div x-show="restTab==='headers'">
                                                    <div class="pm-kv-table">
                                                        <div class="pm-kv-header">
                                                            <span></span><span>Header Name</span><span>Value</span><span></span>
                                                        </div>
                                                        <template x-for="(row, i) in headerRows" :key="i">
                                                            <div class="pm-kv-row" :class="!row.enabled?'pm-row-disabled':''">
                                                                <input type="checkbox" x-model="row.enabled" class="pm-row-check" />
                                                                <input type="text" x-model="row.key" class="pm-kv-key" placeholder="Header-Name" />
                                                                <div class="pm-value-cell">
                                                                    <input type="text" x-model="row.value" class="pm-kv-val-input" placeholder="value" />
                                                                </div>
                                                                <button type="button" class="pm-row-del" @@click="removeHeaderRow(i)" title="Remove">
                                                                    <i class="fas fa-times"></i>
                                                                </button>
                                                            </div>
                                                        </template>
                                                    </div>
                                                    <button type="button" class="pm-add-row-btn" @@click="addHeaderRow()">
                                                        <i class="fas fa-plus me-1"></i>Add Header
                                                    </button>
                                                </div>

                                                <!-- BODY tab -->
                                                <div x-show="restTab==='body'">
                                                    <div class="d-flex align-items-center gap-4 mb-2 mt-1">
                                                        <label class="form-label mb-0 text-muted" style="font-size:.78rem;white-space:nowrap;">Content-Type</label>
                                                        <label class="pm-radio-label">
                                                            <input type="radio" x-model="contentType" value="application/x-www-form-urlencoded" />
                                                            form-urlencoded
                                                        </label>
                                                        <label class="pm-radio-label">
                                                            <input type="radio" x-model="contentType" value="application/json" />
                                                            JSON
                                                        </label>
                                                    </div>
                                                    <div class="pm-body-preview">
                                                        <div class="pm-preview-label">Body Preview</div>
                                                        <pre class="pm-preview-code" x-html="bodyPreviewHtml"></pre>
                                                    </div>
                                                </div>

                                                <!-- ADVANCED tab -->
                                                <div x-show="restTab==='advanced'">
                                                    <div class="row g-2 mt-1">
                                                        <div class="col-12">
                                                            <label class="form-label" style="font-size:.78rem;">Success Pattern <span class="text-muted fw-normal">(optional)</span></label>
                                                            <input type="text" x-model="successPattern" class="form-control form-control-sm font-monospace"
                                                                   placeholder='"success":true' />
                                                            <small class="text-muted">Response body must contain this text. Empty = any 2xx = success.</small>
                                                        </div>
                                                        <div class="col-12">
                                                            <label class="form-label" style="font-size:.78rem;">Failure Pattern <span class="text-muted fw-normal">(optional)</span></label>
                                                            <input type="text" x-model="failurePattern" class="form-control form-control-sm font-monospace"
                                                                   placeholder="error" />
                                                            <small class="text-muted">If response contains this text, treat as failure even on 2xx.</small>
                                                        </div>
                                                    </div>
                                                </div>

                                            </div><!-- /pm-tab-content -->
                                        </div><!-- /editor col -->

                                        <!-- RIGHT: live preview -->
                                        <div class="col-xl-6">
                                            <div class="pm-preview-panel">
                                                <div class="pm-preview-header">
                                                    <i class="fas fa-eye text-muted"></i>
                                                    <span>Live Request Preview</span>
                                                    <span class="ms-auto badge"
                                                          :class="httpMethod==='GET'?'bg-success':'bg-primary'"
                                                          x-text="httpMethod"></span>
                                                </div>
                                                <pre class="pm-preview-body" x-html="activePreviewHtml"></pre>
                                            </div>
                                        </div>
                                    </div>
                                </div><!-- /REST section -->

                                <!-- ═══ SOAP SECTION ═══ -->
                                <div x-show="providerType==='SOAP'" x-transition>
                                    <div class="row g-3">
                                        <!-- LEFT: editor -->
                                        <div class="col-xl-6">

                                            <!-- Endpoint -->
                                            <div class="mb-3">
                                                <label class="form-label" style="font-size:.78rem;">Endpoint URL</label>
                                                <div class="pm-request-line">
                                                    <span class="pm-method-soap">POST</span>
                                                    <input type="text" x-model="endpoint" class="pm-url-input"
                                                           placeholder="http://your-soap-service.com/service.asmx" />
                                                </div>
                                            </div>

                                            <!-- SOAPAction + Auth -->
                                            <div class="row g-2 mb-3">
                                                <div class="col-md-7">
                                                    <label class="form-label" style="font-size:.78rem;">SOAPAction Header</label>
                                                    <input type="text" x-model="soapAction" class="form-control form-control-sm font-monospace"
                                                           placeholder="http://your-provider.com/SendSMS" />
                                                </div>
                                                <div class="col-md-5">
                                                    <label class="form-label" style="font-size:.78rem;">Auth Type</label>
                                                    <select x-model="soapAuthType" class="form-select form-select-sm">
                                                        <option value="WSSecurity">WS-Security</option>
                                                        <option value="HttpBasic">HTTP Basic</option>
                                                        <option value="None">None</option>
                                                    </select>
                                                </div>
                                            </div>

                                            <!-- Credentials — shown when auth type is not None -->
                                            <div class="row g-2 mb-3" x-show="soapAuthType !== 'None'">
                                                <div class="col-md-5">
                                                    <label class="form-label" style="font-size:.78rem;">Username</label>
                                                    <input asp-for="SmsSettingsInput.Username" class="form-control form-control-sm"
                                                           placeholder="api_username" autocomplete="off" />
                                                </div>
                                                <div class="col-md-5">
                                                    <label class="form-label" style="font-size:.78rem;">Password</label>
                                                    <div class="input-group input-group-sm">
                                                        <input asp-for="SmsSettingsInput.Password" class="form-control"
                                                               id="passwordField" type="password"
                                                               placeholder="••••••••" autocomplete="new-password" />
                                                        <button class="btn btn-outline-secondary" type="button"
                                                                onclick="togglePassword()" id="togglePwBtn">
                                                            <i class="fas fa-eye" id="togglePwIcon"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label" style="font-size:.78rem;">Sender Name</label>
                                                    <input asp-for="SmsSettingsInput.SenderName" class="form-control form-control-sm"
                                                           placeholder="SCADA" maxlength="11" />
                                                </div>
                                            </div>

                                            <!-- MessageType + SendingSystem -->
                                            <div class="row g-2 mb-3">
                                                <div class="col-md-6">
                                                    <label class="form-label" style="font-size:.78rem;">MessageType</label>
                                                    <input type="text" x-model="soapMsgType" class="form-control form-control-sm"
                                                           placeholder="SmsType1" />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label" style="font-size:.78rem;">SendingSystem</label>
                                                    <input type="text" x-model="soapSendingSys" class="form-control form-control-sm"
                                                           placeholder="SCADA" />
                                                </div>
                                            </div>

                                            <!-- SOAP Placeholder Parameters (KV table, same pattern as REST) -->
                                            <div class="mb-3">
                                                <label class="form-label" style="font-size:.78rem;">
                                                    Body Parameters
                                                    <span class="text-muted fw-normal">(map template placeholders to values)</span>
                                                </label>
                                                <div class="pm-kv-table">
                                                    <div class="pm-kv-header">
                                                        <span></span><span>Placeholder</span>
                                                        <span>Value / Keyword</span><span>Type</span><span></span>
                                                    </div>
                                                    <template x-for="(row, i) in soapParamRows" :key="i">
                                                        <div class="pm-kv-row" :class="(!row.enabled?'pm-row-disabled ':'')">
                                                            <input type="checkbox" x-model="row.enabled" class="pm-row-check" />
                                                            <input type="text" x-model="row.key" class="pm-kv-key" placeholder="{Token}" />
                                                            <div class="pm-value-cell">
                                                                <template x-if="row.isDynamic">
                                                                    <div class="d-flex align-items-center gap-1 w-100">
                                                                        <span class="pm-dynamic-pill"><i class="fas fa-bolt me-1" style="font-size:.65em;"></i><span x-text="row.value"></span></span>
                                                                        <select x-model="row.value" @@change="onValueChange(row)" class="pm-kv-val-select-sm">
                                                                            <option value="">↩ literal</option>
                                                                            <option value="message">message</option>
                                                                            <option value="phone">phone</option>
                                                                            <option value="tz">tz</option>
                                                                            <option value="firstName">firstName</option>
                                                                            <option value="lastName">lastName</option>
                                                                            <option value="username">username</option>
                                                                            <option value="password">password</option>
                                                                            <option value="sender_name">sender_name</option>
                                                                            <option value="sendingSystem">sendingSystem</option>
                                                                            <option value="messageType">messageType</option>
                                                                        </select>
                                                                    </div>
                                                                </template>
                                                                <template x-if="!row.isDynamic">
                                                                    <div class="d-flex align-items-center gap-1 w-100">
                                                                        <input type="text" x-model="row.value" @@input="onValueChange(row)"
                                                                               class="pm-kv-val-input" placeholder="value or keyword" />
                                                                        <select @@change="row.value=$event.target.value;onValueChange(row);$event.target.value=''"
                                                                                class="pm-kv-dyn-picker" title="Insert dynamic variable">
                                                                            <option value="">⚡</option>
                                                                            <option value="message">message</option>
                                                                            <option value="phone">phone</option>
                                                                            <option value="tz">tz</option>
                                                                            <option value="firstName">firstName</option>
                                                                            <option value="lastName">lastName</option>
                                                                            <option value="username">username</option>
                                                                            <option value="password">password</option>
                                                                            <option value="sender_name">sender_name</option>
                                                                            <option value="sendingSystem">sendingSystem</option>
                                                                            <option value="messageType">messageType</option>
                                                                        </select>
                                                                    </div>
                                                                </template>
                                                            </div>
                                                            <div>
                                                                <select x-model="row.paramType"
                                                                        class="pm-type-select"
                                                                        :class="'pm-type-'+(row.paramType||'static')">
                                                                    <option value="dynamic" :disabled="!row.isDynamic">Dynamic</option>
                                                                    <option value="static">Static</option>
                                                                </select>
                                                            </div>
                                                            <button type="button" class="pm-row-del" @@click="removeSoapParamRow(i)" title="Remove">
                                                                <i class="fas fa-times"></i>
                                                            </button>
                                                        </div>
                                                    </template>
                                                </div>
                                                <div class="pm-param-legend">
                                                    <span><span class="pm-legend-dot-dynamic"></span>Dynamic — resolved from SCADA at send time</span>
                                                    <span><span class="pm-legend-dot-static"></span>Static — literal value injected into template</span>
                                                </div>
                                                <button type="button" class="pm-add-row-btn" @@click="addSoapParamRow()">
                                                    <i class="fas fa-plus me-1"></i>Add Placeholder
                                                </button>
                                            </div>

                                            <!-- Body template -->
                                            <div class="mb-2">
                                                <label class="form-label" style="font-size:.78rem;">
                                                    Body Template <span class="text-danger">*</span>
                                                </label>
                                                <div x-show="providerType==='SOAP' && !soapTemplate.trim()" class="warning-box mb-2" style="font-size:.8rem;">
                                                    <i class="fas fa-exclamation-triangle me-1"></i>
                                                    <strong>Body template required.</strong> Use the chips below to insert dynamic placeholders. Each SMS provider has a different XML structure &mdash; consult your provider's API docs.
                                                </div>
                                                <!-- Grouped chip bar -->
                                                <div class="mb-1 d-flex align-items-center flex-wrap gap-1" style="font-size:.7rem;">
                                                    <span class="pm-chip-group-label">SCADA Data:</span>
                                                    <button type="button" class="pm-chip pm-chip-dynamic" @@click="insertPlaceholder('{Message}')"><i class="fas fa-bolt me-1 opacity-50"></i>{Message}</button>
                                                    <button type="button" class="pm-chip pm-chip-dynamic" @@click="insertPlaceholder('{Phone}')"><i class="fas fa-bolt me-1 opacity-50"></i>{Phone}</button>
                                                    <button type="button" class="pm-chip pm-chip-dynamic" @@click="insertPlaceholder('{FirstName}')">{FirstName}</button>
                                                    <button type="button" class="pm-chip pm-chip-dynamic" @@click="insertPlaceholder('{LastName}')">{LastName}</button>
                                                    <button type="button" class="pm-chip pm-chip-dynamic" @@click="insertPlaceholder('{TZ}')">{TZ}</button>
                                                </div>
                                                <div class="mb-1 d-flex align-items-center flex-wrap gap-1" style="font-size:.7rem;">
                                                    <span class="pm-chip-group-label">Credentials:</span>
                                                    <button type="button" class="pm-chip pm-chip-credential" @@click="insertPlaceholder('{Username}')"><i class="fas fa-key me-1 opacity-50"></i>{Username}</button>
                                                    <button type="button" class="pm-chip pm-chip-credential" @@click="insertPlaceholder('{Password}')">{Password}</button>
                                                    <button type="button" class="pm-chip pm-chip-credential" @@click="insertPlaceholder('{SenderName}')">{SenderName}</button>
                                                </div>
                                                <div class="mb-2 d-flex align-items-center flex-wrap gap-1" style="font-size:.7rem;">
                                                    <span class="pm-chip-group-label">Config:</span>
                                                    <button type="button" class="pm-chip pm-chip-config" @@click="insertPlaceholder('{SendingSystem}')">{SendingSystem}</button>
                                                    <button type="button" class="pm-chip pm-chip-config" @@click="insertPlaceholder('{MessageType}')">{MessageType}</button>
                                                </div>
                                                <textarea x-model="soapTemplate" id="soapTemplateArea"
                                                          class="form-control font-monospace pm-soap-textarea" rows="7"
                                                          placeholder="&lt;!-- customize for your provider --&gt;&#10;&lt;YourAction&gt;&#10;  &lt;Phone&gt;{Phone}&lt;/Phone&gt;&#10;  &lt;Message&gt;{Message}&lt;/Message&gt;&#10;&lt;/YourAction&gt;"></textarea>
                                            </div>

                                            <!-- Extra namespaces -->
                                            <div class="mb-2">
                                                <label class="form-label" style="font-size:.78rem;">Extra Envelope Namespaces <span class="text-muted fw-normal">(optional)</span></label>
                                                <input type="text" x-model="soapNamespaces" class="form-control form-control-sm font-monospace"
                                                       placeholder='xmlns:ns1="http://myprovider.com"' />
                                            </div>

                                            <!-- Patterns -->
                                            <div class="row g-2">
                                                <div class="col-6">
                                                    <label class="form-label" style="font-size:.78rem;">Success Pattern</label>
                                                    <input type="text" x-model="soapSuccessPattern" class="form-control form-control-sm font-monospace"
                                                           placeholder="&lt;Success&gt;true&lt;/Success&gt;" />
                                                </div>
                                                <div class="col-6">
                                                    <label class="form-label" style="font-size:.78rem;">Error Tag</label>
                                                    <input type="text" x-model="soapErrorPattern" class="form-control form-control-sm font-monospace"
                                                           placeholder="&lt;ErrorMessage&gt;" />
                                                </div>
                                            </div>

                                        </div><!-- /SOAP editor col -->

                                        <!-- RIGHT: live preview -->
                                        <div class="col-xl-6">
                                            <div class="pm-preview-panel">
                                                <div class="pm-preview-header">
                                                    <i class="fas fa-file-code" style="color:#ffc107;"></i>
                                                    <span>SOAP Envelope Preview</span>
                                                    <span class="ms-auto badge bg-warning text-dark">SOAP</span>
                                                </div>
                                                <pre class="pm-preview-body" x-html="activePreviewHtml"></pre>
                                            </div>
                                        </div>
                                    </div>
                                </div><!-- /SOAP section -->

                            </div>


                            <!-- RATE & LIMITS TAB -->
                            <div class="tab-pane fade" id="pane-rate" role="tabpanel">
                                <h6 class="fw-bold text-muted mb-3" style="font-size:0.8rem; text-transform:uppercase; letter-spacing:0.5px;">
                                    <i class="fas fa-sliders-h me-1"></i>Rate Limiting
                                </h6>
                                <div class="row g-3 mb-4">
                                    <div class="col-md-3">
                                        <label class="form-label">Rate Limit</label>
                                        <div class="input-group">
                                            <input asp-for="SmsSettingsInput.RateLimit" class="form-control" type="number" min="1" max="1000" />
                                            <span class="input-group-text text-muted" style="font-size:0.8rem;">SMS</span>
                                        </div>
                                        <small class="text-muted">Max messages per rate window</small>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Rate Window</label>
                                        <div class="input-group">
                                            <input asp-for="SmsSettingsInput.RateWindow" class="form-control" type="number" min="1" />
                                            <span class="input-group-text text-muted" style="font-size:0.8rem;">sec</span>
                                        </div>
                                        <small class="text-muted">Window duration in seconds</small>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Duplicate Window</label>
                                        <div class="input-group">
                                            <input asp-for="SmsSettingsInput.DuplicateWindow" class="form-control" type="number" min="0" />
                                            <span class="input-group-text text-muted" style="font-size:0.8rem;">min</span>
                                        </div>
                                        <small class="text-muted">Block identical messages within this period</small>
                                    </div>
                                </div>
                                <hr class="section-divider">
                                <h6 class="fw-bold text-muted mb-3" style="font-size:0.8rem; text-transform:uppercase; letter-spacing:0.5px;">
                                    <i class="fas fa-network-wired me-1"></i>Connection
                                </h6>
                                <div class="row g-3">
                                    <div class="col-md-3">
                                        <label class="form-label">Timeout</label>
                                        <div class="input-group">
                                            <input asp-for="SmsSettingsInput.TimeoutSeconds" class="form-control" type="number" min="5" max="300" />
                                            <span class="input-group-text text-muted" style="font-size:0.8rem;">sec</span>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Retry Attempts</label>
                                        <div class="input-group">
                                            <input asp-for="SmsSettingsInput.RetryAttempts" class="form-control" type="number" min="0" max="10" />
                                            <span class="input-group-text text-muted" style="font-size:0.8rem;">×</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="info-box mt-3">
                                    <i class="fas fa-info-circle me-1"></i>
                                    Rate: <strong x-text="'@Model.SmsSettingsInput.RateLimit SMS / @Model.SmsSettingsInput.RateWindow sec'"></strong>.
                                    Duplicate protection blocks same message to same recipient within the window.
                                </div>
                            </div>

                            <!-- SCADA TAB -->
                            <div class="tab-pane fade" id="pane-scada" role="tabpanel">
                                <h6 class="fw-bold text-muted mb-3" style="font-size:0.8rem; text-transform:uppercase; letter-spacing:0.5px;">
                                    <i class="fas fa-microchip me-1"></i>SCADA / WinCC OA Integration
                                </h6>
                                <div class="row g-3 mb-3">
                                    <div class="col-md-3">
                                        <label class="form-label">
                                            PCIM Object ID
                                            <span class="badge bg-warning text-dark ms-1" style="font-size:0.65rem;" data-bs-toggle="tooltip"
                                                  title="Deployment-specific. Check WinCC OA panel for the correct value.">deployment-specific</span>
                                        </label>
                                        <input asp-for="SmsSettingsInput.ScadaPcimObjectId" class="form-control font-monospace" type="number" />
                                        <small class="text-muted">Used in alarm action commands</small>
                                    </div>
                                </div>
                                <div class="mt-2">
                                    <label class="form-label">Generated Alarm Command</label>
                                    <pre class="bg-dark text-success rounded-3 p-3" style="font-size:0.75rem; white-space:pre-wrap; word-break:break-all;">'Run '+getalias('PCIMUTIL')+'Scada_sms.bat'+' "+'"+GetValue(PFWALARMNG|PCIM!<span class="text-warning">@Model.SmsSettingsInput.ScadaPcimObjectId</span>:(ThisObject).DESCRIPTION)+'"'+<span class="text-info">[GROUP_ID]</span>+' "+GetValue(PFWALARMNG|PCIM!<span class="text-warning">@Model.SmsSettingsInput.ScadaPcimObjectId</span>:(ThisObject).ALM_VALUE)+'"'</pre>
                                </div>
                                <div class="warning-box mt-2">
                                    <i class="fas fa-exclamation-triangle me-1"></i>
                                    After changing <strong>PCIM Object ID</strong>, update all alarm action scripts in WinCC OA to use the new ID.
                                </div>
                            </div>

                            <!-- TEST MODE TAB -->
                            <div class="tab-pane fade" id="pane-testmode" role="tabpanel">
                                <h6 class="fw-bold text-muted mb-3" style="font-size:0.8rem; text-transform:uppercase; letter-spacing:0.5px;">
                                    <i class="fas fa-flask me-1"></i>Test Mode — In-Process Mock SMS Server
                                </h6>

                                <div class="row g-3 mb-3">
                                    <div class="col-12">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" role="switch"
                                                   asp-for="SmsSettingsInput.TestMode" id="testModeSwitch"
                                                   style="width:3em; height:1.5em;" />
                                            <label class="form-check-label ms-2 fw-semibold" for="testModeSwitch">
                                                Enable Test Mode
                                            </label>
                                        </div>
                                        <small class="text-muted d-block mt-1">
                                            When enabled, all SMS calls are intercepted by the in-process mock — no real messages are sent.
                                            The mock simulates a ~3% failure rate.
                                        </small>
                                    </div>
                                </div>

                                @if (Model.SmsSettingsInput.TestMode)
                                {
                                    <div class="alert alert-warning border-0 rounded-3 d-flex align-items-center gap-3 mb-3">
                                        <i class="fas fa-exclamation-triangle fa-lg"></i>
                                        <div>
                                            <strong>Test Mode is ACTIVE.</strong>
                                            SMS calls go to the in-process mock, not the real provider.
                                            <a href="/mock/sms/status" target="_blank" class="alert-link ms-2">
                                                <i class="fas fa-external-link-alt me-1"></i>View mock log →
                                            </a>
                                        </div>
                                    </div>
                                }

                                <div class="info-box mb-3">
                                    <i class="fas fa-info-circle me-1"></i>
                                    Mock endpoints (active only in Test Mode):
                                    <ul class="mb-0 mt-1" style="font-size:0.85em;">
                                        <li><code>GET/POST /mock/sms/rest</code> — simulated REST response</li>
                                        <li><code>POST /mock/sms/soap</code> — simulated SOAP response</li>
                                        <li><code>GET /mock/sms/status</code> — intercepted message log (JSON)</li>
                                        <li><code>POST /mock/sms/reset</code> — reset mock counters</li>
                                    </ul>
                                </div>

                                @if (Model.SmsSettingsInput.TestMode)
                                {
                                    <div class="d-flex align-items-center gap-2 mt-2">
                                        <span class="badge bg-success px-3 py-2 fs-6">
                                            <i class="fas fa-check-circle me-1"></i>Mock server ACTIVE (REST + SOAP)
                                        </span>
                                    </div>
                                    <div class="row g-2 mt-2">
                                        <div class="col-auto">
                                            <a href="/Test/Sms#mock-tester" class="btn btn-sm btn-primary">
                                                <i class="fas fa-flask me-1"></i>Open Mock Tester
                                            </a>
                                        </div>
                                        <div class="col-auto">
                                            <a href="/mock/sms/status" target="_blank" class="btn btn-sm btn-outline-secondary">
                                                <i class="fas fa-list me-1"></i>View Log (JSON)
                                            </a>
                                        </div>
                                    </div>
                                }
                            </div>

                        </div><!-- /tab-content -->

                        <hr class="section-divider">

                        <!-- Save row -->
                        <div class="d-flex align-items-center justify-content-between">
                            <span class="text-muted" style="font-size:0.8rem;">
                                <i class="fas fa-file-code me-1"></i>
                                Saves to <code>appsettings.json</code> — restart app to fully apply.
                            </span>
                            <button type="submit" class="btn btn-primary save-btn" id="saveBtn">
                                <i class="fas fa-save me-2"></i>Save Settings
                            </button>
                        </div>

                    </div><!-- /card-body -->
                </div><!-- /tab panes card -->

            </form>

            <!-- Quick Links -->
            <div class="card config-card mt-4">
                <div class="card-header bg-white">
                    <i class="fas fa-external-link-alt text-secondary me-2"></i>Quick Links
                </div>
                <div class="card-body pt-3">
                    <div class="row g-2">
                        <div class="col-md-3">
                            <a href="/Users" class="btn btn-outline-primary btn-sm w-100">
                                <i class="fas fa-users me-1"></i>Users
                            </a>
                        </div>
                        <div class="col-md-3">
                            <a href="/Groups" class="btn btn-outline-success btn-sm w-100">
                                <i class="fas fa-layer-group me-1"></i>Groups
                            </a>
                        </div>
                        <div class="col-md-3">
                            <a href="/Audit" class="btn btn-outline-info btn-sm w-100">
                                <i class="fas fa-history me-1"></i>Audit
                            </a>
                        </div>
                        <div class="col-md-3">
                            <a href="/Test/Sms" class="btn btn-outline-warning btn-sm w-100">
                                <i class="fas fa-paper-plane me-1"></i>Test SMS
                            </a>
                        </div>
                    </div>
                </div>
            </div>

        </div><!-- /right col -->
    </div><!-- /row -->
</div>

@section Scripts {
<script src="~/js/alpine.min.js" defer></script>
<script>
    function settingsApp() {
        const DYNAMIC_KEYWORDS = [
            'message','msg','text','body',
            'phone','phonenumber','mobile','number',
            'username','user','userid',
            'password','pass',
            'sender_name','sendername','sender','from',
            'tz','firstname','lastname',
            'sendingsystem','messagetype'
        ];

        function detectType(value) {
            const v = String(value).toLowerCase().trim();
            if (DYNAMIC_KEYWORDS.includes(v)) return 'dynamic';
            if (value.trim() === '') return 'default';
            return 'static';
        }

        function parseJsonToRows(jsonStr) {
            if (!jsonStr || jsonStr.trim() === '' || jsonStr.trim() === '{}') return [];
            try {
                const obj = JSON.parse(jsonStr);
                return Object.entries(obj).map(([k, v]) => {
                    const isDyn = DYNAMIC_KEYWORDS.includes(String(v).toLowerCase().trim());
                    return {
                        enabled: true,
                        key: k,
                        value: String(v),
                        isDynamic: isDyn,
                        paramType: detectType(v)
                    };
                });
            } catch { return []; }
        }

        function rowsToJson(rows) {
            const obj = {};
            rows.forEach(r => {
                if (r.enabled && r.key.trim() !== '') obj[r.key.trim()] = r.value;
            });
            return JSON.stringify(obj);
        }

        function makeRow() {
            return { enabled: true, key: '', value: '', isDynamic: false, paramType: 'static' };
        }

        function q(name) { return document.querySelector('[name="' + name + '"]'); }

        return {
            providerType: 'REST',
            httpMethod: 'POST',
            endpoint: '',
            contentType: 'application/x-www-form-urlencoded',
            paramRows: [],
            headerRows: [],
            soapParamRows: [],
            soapAction: '',
            soapAuthType: 'WSSecurity',
            soapTemplate: '',
            soapNamespaces: '',
            soapMsgType: '',
            soapSendingSys: '',
            successPattern: '',
            failurePattern: '',
            soapSuccessPattern: '',
            soapErrorPattern: '',
            restTab: 'params',

            init() {
                this.providerType  = q('SmsSettingsInput.ProviderType')?.value  || 'REST';
                this.httpMethod    = q('SmsSettingsInput.HttpMethod')?.value    || 'POST';
                this.endpoint      = q('SmsSettingsInput.ApiEndpoint')?.value   || '';
                this.contentType   = q('SmsSettingsInput.ContentType')?.value   || 'application/x-www-form-urlencoded';
                this.soapAction    = q('SmsSettingsInput.SoapAction')?.value    || '';
                this.soapAuthType  = q('SmsSettingsInput.SoapAuthType')?.value  || 'WSSecurity';
                this.soapTemplate  = q('SmsSettingsInput.SoapBodyTemplate')?.value || '';
                this.soapNamespaces= q('SmsSettingsInput.SoapEnvelopeNamespaces')?.value || '';
                this.soapMsgType   = q('SmsSettingsInput.SoapMessageType')?.value    || '';
                this.soapSendingSys= q('SmsSettingsInput.SoapSendingSystem')?.value  || '';
                this.successPattern= q('SmsSettingsInput.RestSuccessPattern')?.value || '';
                this.failurePattern= q('SmsSettingsInput.RestFailurePattern')?.value || '';
                this.soapSuccessPattern = q('SmsSettingsInput.SoapSuccessPattern')?.value || '';
                this.soapErrorPattern   = q('SmsSettingsInput.SoapErrorPattern')?.value   || '';

                this.paramRows     = parseJsonToRows(q('SmsSettingsInput.ApiParams')?.value  || '');
                this.headerRows    = parseJsonToRows(q('SmsSettingsInput.ApiHeaders')?.value || '');
                this.soapParamRows = parseJsonToRows(q('SmsSettingsInput.SoapParams')?.value || '');
                if (!this.paramRows.length)  this.paramRows.push(makeRow());
                if (!this.headerRows.length) this.headerRows.push(makeRow());
                if (!this.soapParamRows.length) {
                    // Default SOAP placeholder set — user can adjust as needed
                    this.soapParamRows = [
                        { enabled: true,  key: 'Message',   value: 'message',     isDynamic: true, paramType: 'dynamic' },
                        { enabled: true,  key: 'Phone',     value: 'phone',       isDynamic: true, paramType: 'dynamic' },
                        { enabled: false, key: 'TZ',        value: 'tz',          isDynamic: true, paramType: 'dynamic' },
                        { enabled: false, key: 'FirstName', value: 'firstName',   isDynamic: true, paramType: 'dynamic' },
                        { enabled: false, key: 'LastName',  value: 'lastName',    isDynamic: true, paramType: 'dynamic' },
                        { enabled: false, key: 'Username',  value: 'username',    isDynamic: true, paramType: 'dynamic' },
                        { enabled: false, key: 'SenderName',value: 'sender_name', isDynamic: true, paramType: 'dynamic' },
                    ];
                }
            },

            addParamRow()  { this.paramRows.push(makeRow()); },
            removeParamRow(i)  { this.paramRows.splice(i, 1); if (!this.paramRows.length) this.addParamRow(); },
            addHeaderRow() { this.headerRows.push(makeRow()); },
            removeHeaderRow(i) { this.headerRows.splice(i, 1); if (!this.headerRows.length) this.addHeaderRow(); },
            addSoapParamRow()  { this.soapParamRows.push(makeRow()); },
            removeSoapParamRow(i) { this.soapParamRows.splice(i, 1); if (!this.soapParamRows.length) this.addSoapParamRow(); },

            onValueChange(row) {
                row.isDynamic = DYNAMIC_KEYWORDS.includes(String(row.value).toLowerCase().trim());
                // Auto-update type when value changes
                const auto = detectType(row.value);
                if (auto === 'dynamic') row.paramType = 'dynamic';
                else if (row.paramType === 'dynamic') row.paramType = 'static'; // was dynamic, now literal
            },

            insertPlaceholder(ph) {
                const ta = document.getElementById('soapTemplateArea');
                if (!ta) return;
                const s = ta.selectionStart, e = ta.selectionEnd;
                this.soapTemplate = this.soapTemplate.substring(0, s) + ph + this.soapTemplate.substring(e);
                this.$nextTick(() => { ta.selectionStart = ta.selectionEnd = s + ph.length; ta.focus(); });
            },

            serializeToHiddenInputs() {
                const provider = this.providerType;
                const testMode = q('SmsSettingsInput.TestMode')?.checked;
                const confirmMsg = `Save settings?\n\nProvider: ${provider}${testMode ? '\nTest Mode: ON' : ''}`;
                if (!confirm(confirmMsg)) return false;

                function sync(name, val) { const el = q(name); if (el) el.value = val; }
                sync('SmsSettingsInput.ApiParams',              rowsToJson(this.paramRows));
                sync('SmsSettingsInput.ApiHeaders',             rowsToJson(this.headerRows));
                sync('SmsSettingsInput.SoapParams',             rowsToJson(this.soapParamRows));
                sync('SmsSettingsInput.ProviderType',           this.providerType);
                sync('SmsSettingsInput.ApiEndpoint',            this.endpoint);
                sync('SmsSettingsInput.HttpMethod',             this.httpMethod);
                sync('SmsSettingsInput.ContentType',            this.contentType);
                sync('SmsSettingsInput.SoapAction',             this.soapAction);
                sync('SmsSettingsInput.SoapAuthType',           this.soapAuthType);
                sync('SmsSettingsInput.SoapBodyTemplate',       this.soapTemplate);
                sync('SmsSettingsInput.SoapEnvelopeNamespaces', this.soapNamespaces);
                sync('SmsSettingsInput.SoapMessageType',        this.soapMsgType);
                sync('SmsSettingsInput.SoapSendingSystem',      this.soapSendingSys);
                sync('SmsSettingsInput.RestSuccessPattern',     this.successPattern);
                sync('SmsSettingsInput.RestFailurePattern',     this.failurePattern);
                sync('SmsSettingsInput.SoapSuccessPattern',     this.soapSuccessPattern);
                sync('SmsSettingsInput.SoapErrorPattern',       this.soapErrorPattern);
            },

            get restPreview() {
                const enabled = this.paramRows.filter(r => r.enabled && r.key.trim());
                const url = this.endpoint || 'https://…';
                if (this.httpMethod === 'GET') {
                    const qs = enabled.map(r => {
                        const k = encodeURIComponent(r.key.trim());
                        const v = r.isDynamic ? '{' + r.value + '}' : encodeURIComponent(r.value);
                        return k + '=' + v;
                    }).join('&');
                    return url + (qs ? '?' + qs : '');
                }
                const hLines = this.headerRows.filter(r => r.enabled && r.key.trim())
                    .map(r => r.key.trim() + ': ' + r.value).join('\n');
                let body = '';
                if (this.contentType === 'application/json') {
                    const obj = {};
                    enabled.forEach(r => { obj[r.key.trim()] = r.isDynamic ? '{' + r.value + '}' : r.value; });
                    body = JSON.stringify(obj, null, 2);
                } else {
                    body = enabled.map(r => {
                        const k = encodeURIComponent(r.key.trim());
                        const v = r.isDynamic ? '{' + r.value + '}' : encodeURIComponent(r.value);
                        return k + '=' + v;
                    }).join('&');
                }
                return this.httpMethod + ' ' + url + ' HTTP/1.1\n'
                    + 'Content-Type: ' + this.contentType
                    + (hLines ? '\n' + hLines : '')
                    + '\n\n' + body;
            },

            get bodyPreviewHtml() {
                const raw = this.restPreview;
                const parts = raw.split('\n\n');
                const body = parts.slice(1).join('\n\n') || '(configure params first)';
                return body.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
                    .replace(/\{([^}]+)\}/g,'<span class="pm-token">{$1}</span>');
            },

            get soapPreview() {
                const ns = this.soapNamespaces ? '\n    ' + this.soapNamespaces : '';
                const bodyContent = this.soapTemplate ||
                    '<ns1:SendSMS xmlns:ns1="http://tempuri.org/">\n  <ns1:Message>{Message}</ns1:Message>\n  <ns1:Phone>{Phone}</ns1:Phone>\n  <ns1:UserName>{Username}</ns1:UserName>\n  <ns1:Password>{Password}</ns1:Password>\n  <ns1:SenderName>{SenderName}</ns1:SenderName>\n  <ns1:MessageType>' + (this.soapMsgType || '{MessageType}') + '</ns1:MessageType>\n  <ns1:SendingSystem>' + (this.soapSendingSys || '{SendingSystem}') + '</ns1:SendingSystem>\n</ns1:SendSMS>';

                let secHeader = '  <soapenv:Header/>\n';
                if (this.soapAuthType === 'WSSecurity') {
                    secHeader = '  <soapenv:Header>\n    <wsse:Security xmlns:wsse="http://schemas.xmlsoap.org/ws/2002/07/secext">\n      <wsse:UsernameToken>\n        <wsse:Username>{Username}</wsse:Username>\n        <wsse:Password>{Password}</wsse:Password>\n      </wsse:UsernameToken>\n    </wsse:Security>\n  </soapenv:Header>\n';
                }

                return 'POST ' + (this.endpoint || '/') + ' HTTP/1.1\n'
                    + 'SOAPAction: "' + this.soapAction + '"\n'
                    + 'Content-Type: text/xml; charset=utf-8\n\n'
                    + '<?xml version="1.0" encoding="utf-8"?>\n'
                    + '<soapenv:Envelope\n    xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/"' + ns + '>\n'
                    + secHeader
                    + '  <soapenv:Body>\n    ' + bodyContent + '\n  </soapenv:Body>\n'
                    + '</soapenv:Envelope>';
            },

            get activePreviewHtml() {
                const raw = this.providerType === 'SOAP' ? this.soapPreview : this.restPreview;
                return raw
                    .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
                    .replace(/\{([^}]+)\}/g,'<span class="pm-token">{$1}</span>');
            }
        };
    }

    function togglePassword() {
        const f = document.getElementById('passwordField');
        const icon = document.getElementById('togglePwIcon');
        if (f.type === 'password') {
            f.type = 'text';
            icon.className = 'fas fa-eye-slash';
        } else {
            f.type = 'password';
            icon.className = 'fas fa-eye';
        }
    }

    // Save button loading state
    document.getElementById('settingsForm').addEventListener('submit', function () {
        const btn = document.getElementById('saveBtn');
        btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Saving…';
        btn.disabled = true;
    });

    // Auto-dismiss alerts
    setTimeout(() => {
        document.querySelectorAll('.alert-dismissible').forEach(el => {
            new bootstrap.Alert(el).close();
        });
    }, 6000);

    // Tooltips
    document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(el => new bootstrap.Tooltip(el));
</script>
}
