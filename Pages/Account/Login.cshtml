@page
@model SCADASMSSystem.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="row justify-content-center mt-5 auth-workspace">
    <div class="col-12 col-sm-8 col-md-5 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <span class="workspace-kicker">AlarmBridge</span>
                <h1 class="h4 mt-2 mb-2"><i class="fas fa-lock me-2"></i>Operator sign in</h1>
                <p class="text-muted small mb-4">Access alarm routing and delivery operations.</p>
                @if (Model.Error != null)
                {
                    <div class="alert alert-danger py-2">@Model.Error</div>
                }
                <form method="post">
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div class="mb-3">
                        <label asp-for="UserName" class="form-label">User name</label>
                        <input asp-for="UserName" class="form-control" autocomplete="username" autofocus />
                        <span asp-validation-for="UserName" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Password</label>
                        <input asp-for="Password" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Sign in</button>
                </form>
            </div>
        </div>
    </div>
</div>
