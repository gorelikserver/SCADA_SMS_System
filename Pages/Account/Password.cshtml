@page
@model SCADASMSSystem.Web.Pages.Account.PasswordModel
@{
    ViewData["Title"] = T["Change password"];
}

<div class="row justify-content-center mt-4 auth-workspace">
    <div class="col-12 col-sm-8 col-md-5 card auth-card p-4">
        <h1 class="h4 mb-3"><i class="fas fa-key me-2"></i>@T["Change password"]</h1>
        @if (Model.Done)
        {
            <div class="alert alert-success py-2">@T["Password changed."]</div>
        }
        @if (Model.Error != null)
        {
            <div class="alert alert-danger py-2">@Model.Error</div>
        }
        <form method="post">
            <div class="mb-3">
                <label asp-for="CurrentPassword" class="form-label">@T["Current password"]</label>
                <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
            </div>
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label">@string.Format(T["New password (at least {0} characters)"], SCADASMSSystem.Web.Services.AccountService.MinPasswordLength)</label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label">@T["Confirm new password"]</label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary">@T["Change password"]</button>
        </form>
    </div>
</div>
