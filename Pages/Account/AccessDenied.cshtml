@page
@{
    ViewData["Title"] = "Access denied";
}

<div class="container mt-5">
    <div class="alert alert-warning">
        <h1 class="h5"><i class="fas fa-ban me-2"></i>Access denied</h1>
        <p class="mb-0">Your account (@User.Identity?.Name) can view the dashboard, alerts and audit log. Ask an admin to change settings, users, groups or alarms.</p>
    </div>
    <a asp-page="/Index" class="btn btn-outline-primary">Back to dashboard</a>
</div>
