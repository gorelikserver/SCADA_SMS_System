@page
@model SCADASMSSystem.Web.Pages.Groups.IndexModel
@{
    ViewData["Title"] = "Notification Teams";
}

@section Breadcrumb {
<div class="breadcrumb-bar">
    <div class="container-fluid px-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-page="/Index"><i class="fas fa-gauge-high me-1"></i>Overview</a></li>
                <li class="breadcrumb-item active">Notification Teams</li>
            </ol>
        </nav>
    </div>
</div>
}

<div class="directory-workspace">
    <!-- Page Heading -->
    <header class="overview-heading">
        <div><p class="overview-kicker">Routing</p><h1>Notification teams</h1><p>Organize recipients into the teams targeted by SCADA routing rules.</p></div>
        <a href="/Groups/Create" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i>Create team
        </a>
    </header>

    <!-- Toast triggers from server messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <span class="d-none" data-toast-success="@TempData["SuccessMessage"]"></span>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <span class="d-none" data-toast-error="@TempData["ErrorMessage"]"></span>
    }

    <!-- Search and Filter Card -->
    <section class="directory-filter-panel">
        <div class="panel-heading">
            <div><p class="panel-eyebrow">Team directory</p><h2>Find notification teams</h2></div><span class="directory-count">@Model.Groups.Count() shown</span>
        </div>
        <div class="directory-filter-body">
            <form method="get" class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Search</label>
                    <input type="text" class="form-control" name="searchTerm" 
                           value="@Model.SearchTerm" placeholder="Search by team name">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Filter</label>
                    <select name="statusFilter" class="form-select">
                        <option value="">All teams</option>
                        <option value="active" selected="@(Model.StatusFilter == "active")">Ready (has recipients)</option>
                        <option value="empty" selected="@(Model.StatusFilter == "empty")">Needs recipients</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary me-2" id="filterBtn">
                        <i class="fas fa-search"></i> Search
                    </button>
                    <a href="/Groups" class="btn btn-outline-secondary me-2">
                        <i class="fas fa-times"></i> Clear
                    </a>
                </div>
            </form>
        </div>
    </section>

    <!-- Groups Statistics Row -->
    <section class="directory-metrics" aria-label="Team readiness">
        <div><span>Total teams</span><strong>@Model.Groups.Count()</strong><small>Matching current filters</small></div>
        <div class="is-ready"><span>Ready teams</span><strong>@Model.Groups.Count(g => g.MemberCount > 0)</strong><small>At least one recipient</small></div>
        <div class="is-warning"><span>Needs recipients</span><strong>@Model.Groups.Count(g => g.MemberCount == 0)</strong><small>An alarm would reach nobody</small></div>
        <div><span>Team memberships</span><strong>@Model.Groups.Sum(g => g.MemberCount)</strong><small>Across matching teams</small></div>
    </section>

    <!-- Groups Data Table -->
    <div class="card directory-table-panel mb-4">
        <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
            <h2 class="h6 m-0 fw-bold">Team directory</h2>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table directory-table" id="groupsTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>Notification team</th>
                            <th>Routing readiness</th>
                            <th>Created</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var groupItem in Model.Groups)
                        {
                            <tr class="@(groupItem.MemberCount == 0 ? "needs-attention" : "")">
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="me-3">
                                            <span class="team-avatar"><i class="fas fa-people-group"></i></span>
                                        </div>
                                        <div>
                                            <div class="fw-semibold" dir="auto">@groupItem.Group.GroupName</div>
                                            <small class="text-muted">Team #@groupItem.Group.GroupId</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="delivery-state @(groupItem.MemberCount > 0 ? "state-good" : "state-warning")">
                                        <i class="fas @(groupItem.MemberCount > 0 ? "fa-check" : "fa-triangle-exclamation")"></i>@(groupItem.MemberCount > 0 ? $"{groupItem.MemberCount} recipient{(groupItem.MemberCount == 1 ? "" : "s")}" : "No recipients")
                                    </span>
                                </td>
                                <td>
                                    <small class="text-muted">
                                        @groupItem.Group.CreatedAt.ToString("MMM dd, yyyy")
                                        <br>
                                        <span class="text-muted">@groupItem.Group.CreatedAt.ToString("HH:mm")</span>
                                    </small>
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a href="/Groups/Edit/@groupItem.Group.GroupId" class="btn btn-sm btn-outline-primary" title="Edit notification team">
                                            <i class="fas fa-edit me-1"></i>Edit team
                                        </a>
                                        <div class="btn-group" role="group">
                                            <button class="btn btn-sm btn-outline-info dropdown-toggle" type="button" 
                                                    data-bs-toggle="dropdown" aria-expanded="false" title="More Actions">
                                                <i class="fas fa-ellipsis-h"></i>
                                            </button>
                                            <ul class="dropdown-menu">
                                                <li>
                                                    <a class="dropdown-item" href="/Audit?groupId=@groupItem.Group.GroupId">
                                                        <i class="fas fa-history me-2"></i>Delivery history
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="dropdown-item" href="#" onclick="sendTestSmsToGroup(@groupItem.Group.GroupId, '@groupItem.Group.GroupName')">
                                                        <i class="fas fa-vial me-2"></i>Run delivery test
                                                    </a>
                                                </li>
                                                <li><hr class="dropdown-divider"></li>
                                                <li>
                                                    <form method="post" asp-page-handler="Delete" asp-route-groupId="@groupItem.Group.GroupId" class="delete-group-form">
                                                        <button type="button" class="dropdown-item text-danger"
                                                                data-group-name="@groupItem.Group.GroupName"
                                                                onclick="confirmDeleteGroup(this)">
                                                            <i class="fas fa-trash me-2"></i>Delete team
                                                        </button>
                                                    </form>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (!Model.Groups.Any())
                {
                    <div class="text-center py-5">
                        <div class="mb-3">
                            <i class="fas fa-layer-group fa-3x text-gray-300"></i>
                        </div>
                        <h5 class="text-gray-500">No notification teams found</h5>
                        <p class="text-gray-400">
                            @if (!string.IsNullOrWhiteSpace(Model.SearchTerm) || !string.IsNullOrWhiteSpace(Model.StatusFilter))
                            {
                                <text>No teams match the current filters.</text>
                            }
                            else
                            {
                                <text>Create a team before assigning it to a SCADA routing rule.</text>
                            }
                        </p>
                        <a href="/Groups/Create" class="btn btn-primary">
                            <i class="fas fa-plus me-2"></i>Create first team
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Show server-side messages as toasts
            document.querySelectorAll('[data-toast-success]').forEach(el =>
                SCADAUtils.showToast('<i class="fas fa-check-circle me-2"></i>' + el.dataset.toastSuccess, 'success'));
            document.querySelectorAll('[data-toast-error]').forEach(el =>
                SCADAUtils.showToast('<i class="fas fa-exclamation-circle me-2"></i>' + el.dataset.toastError, 'danger'));

            // Filter button loading state
            const filterForm = document.querySelector('form[method="get"]');
            const filterBtn = document.getElementById('filterBtn');
            if (filterForm && filterBtn) {
                filterForm.addEventListener('submit', () =>
                    SCADAUtils.setButtonLoading(filterBtn, true, 'Searching...'));
            }
        });

        async function confirmDeleteGroup(btn) {
            const groupName = btn.dataset.groupName;
            const confirmed = await SCADAUtils.confirmModal(
                'Delete Group',
                `Delete "${groupName}"? All members will be removed from the group (users themselves won't be deleted).`,
                'Delete Group'
            );
            if (confirmed) {
                btn.closest('form').submit();
            }
        }

        async function sendTestSmsToGroup(groupId, groupName) {
            const confirmed = await SCADAUtils.confirmModal(
                'Send Test SMS',
                `Send a test SMS to all members of "${groupName}"?`,
                'Send SMS',
                'btn-primary'
            );
            if (confirmed) {
                SCADAUtils.showToast(`Test SMS queued for group: ${groupName}`, 'info');
            }
        }
    </script>
}
