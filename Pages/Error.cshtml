@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="container error-workspace">
<div class="error-panel">
<i class="fas fa-triangle-exclamation"></i>
<h1>We couldn't complete that request</h1>
<p>AlarmBridge encountered an unexpected problem. Try again, or give the request ID below to your administrator.</p>

@if (Model.ShowRequestId)
{
    <p class="request-id"><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
}
<a asp-page="/Index" class="btn btn-primary">Return to overview</a>
</div>
</div>
