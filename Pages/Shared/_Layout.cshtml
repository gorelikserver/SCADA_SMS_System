<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AlarmBridge</title>
    
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="~/favicon.ico">
    <link rel="apple-touch-icon" sizes="180x180" href="~/img/logo.jpg">
    <link rel="icon" type="image/png" sizes="32x32" href="~/favicon.ico">
    <link rel="icon" type="image/png" sizes="16x16" href="~/favicon.ico">
    
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SCADASMSSystem.Web.styles.css" asp-append-version="true" />
    <!-- Font Awesome for icons - LOCAL VERSION for air-gapped deployment -->
    <link rel="stylesheet" href="~/css/all.min.css" asp-append-version="true" />
    
    @await RenderSectionAsync("Styles", required: false)
    
</head>
@{
    var _page = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    bool _isActive(string prefix) => _page.StartsWith(prefix, StringComparison.OrdinalIgnoreCase);
    string _navCls(string prefix) => _isActive(prefix) ? "nav-link active" : "nav-link";
    var _signedIn = User.Identity?.IsAuthenticated == true;
    var _isAdmin = User.IsInRole(SCADASMSSystem.Web.Models.AccountRoles.Admin);
}
<body>
    <header>
        <nav class="navbar navbar-expand-xl app-navbar mb-0" aria-label="Primary navigation">
            <div class="container-fluid px-4">
                <a class="navbar-brand" asp-area="" asp-page="/Index">
                    <span class="brand-mark" aria-hidden="true"><i class="fas fa-tower-broadcast"></i></span>
                    <span class="brand-copy"><strong>AlarmBridge</strong><small>SCADA notification gateway</small></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    @if (_signedIn)
                    {
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="@_navCls("/")" asp-area="" asp-page="/Index">
                                <i class="fas fa-gauge-high me-1"></i>Overview
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="@_navCls("/Alerts")" asp-area="" asp-page="/Alerts/Index">
                                <i class="fas fa-triangle-exclamation me-1"></i>Delivery Alerts
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="@_navCls("/Audit")" asp-area="" asp-page="/Audit/Index">
                                <i class="fas fa-clock-rotate-left me-1"></i>Delivery History
                            </a>
                        </li>
                        @if (_isAdmin)
                        {
                            <li class="nav-item">
                                <a class="@_navCls("/Users")" asp-area="" asp-page="/Users/Index">
                                    <i class="fas fa-address-book me-1"></i>Recipients
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@_navCls("/Groups")" asp-area="" asp-page="/Groups/Index">
                                    <i class="fas fa-people-group me-1"></i>Notification Teams
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@_navCls("/Alarms")" asp-area="" asp-page="/Alarms/ManageGroups">
                                    <i class="fas fa-route me-1"></i>Routing Rules
                                </a>
                            </li>
                        }
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @(_isActive("/Settings")||_isActive("/Test")||_isActive("/Calendar")||_isActive("/About")||_isActive("/Help") ? "active" : "")"
                               href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-sliders me-1"></i>System
                            </a>
                            <ul class="dropdown-menu shadow-sm border-0">
                                @if (_isAdmin)
                                {
                                    <li><h6 class="dropdown-header">Configuration</h6></li>
                                    <li><a class="dropdown-item @(_isActive("/Settings") ? "active" : "")" asp-page="/Settings/Index"><i class="fas fa-plug me-2 text-muted"></i>Integrations &amp; settings</a></li>
                                    <li><a class="dropdown-item @(_isActive("/Test") ? "active" : "")" asp-page="/Test/Sms"><i class="fas fa-vial me-2 text-muted"></i>Delivery test</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                }
                                <li>
                                    <a class="dropdown-item @(_isActive("/Calendar") ? "active" : "")" asp-area="" asp-page="/Calendar/Index">
                                        <i class="fas fa-calendar-alt me-2 text-muted"></i>Schedules &amp; holidays
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item @(_isActive("/Help") ? "active" : "")" asp-area="" asp-page="/Help/Integration">
                                        <i class="fas fa-book me-2 text-muted"></i>Integration guide
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item @(_isActive("/About") ? "active" : "")" asp-area="" asp-page="/About">
                                        <i class="fas fa-info-circle me-2 text-muted"></i>About
                                    </a>
                                </li>
                            </ul>
                        </li>
                        @if (_isAdmin && Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT") == "Development")
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-warning" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-bug me-1"></i>Debug
                                </a>
                                <ul class="dropdown-menu shadow-sm border-0">
                                    <li><a class="dropdown-item" asp-page="/Debug/AuditDiagnostics"><i class="fas fa-stethoscope me-2 text-muted"></i>Audit Diagnostics</a></li>
                                    <li><a class="dropdown-item" asp-page="/Debug/AuditFix"><i class="fas fa-tools me-2 text-muted"></i>Audit Data Fix</a></li>
                                    <li><a class="dropdown-item" asp-page="/Debug/TestAudit"><i class="fas fa-database me-2 text-muted"></i>Test Audit</a></li>
                                    <li><a class="dropdown-item" asp-page="/Debug/SoapLog"><i class="fas fa-code me-2 text-muted"></i>SOAP XML Log</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-user-circle me-1"></i>@User.Identity!.Name
                                <span class="badge bg-light text-muted border ms-1">@(_isAdmin ? "Admin" : "Viewer")</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                <li><a class="dropdown-item" asp-page="/Account/Password"><i class="fas fa-key me-2 text-muted"></i>Change password</a></li>
                                @if (_isAdmin)
                                {
                                    <li><a class="dropdown-item" asp-page="/Account/Manage"><i class="fas fa-user-shield me-2 text-muted"></i>Accounts</a></li>
                                }
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form method="post" asp-page="/Account/Login" asp-page-handler="Logout" class="px-3">
                                        <button type="submit" class="btn btn-sm btn-outline-secondary w-100"><i class="fas fa-sign-out-alt me-1"></i>Sign out</button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    </ul>
                    }
                </div>
            </div>
        </nav>
        @if (_signedIn)
        {
            @await Component.InvokeAsync("SystemAlerts")
        }
        @await RenderSectionAsync("Breadcrumb", required: false)
    </header>
    <div class="app-content container-fluid">
        <main role="main" class="pb-3" id="main-content">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-5">
        <div class="container-fluid">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <div class="d-flex align-items-center">
                        <span class="brand-mark brand-mark-sm" aria-hidden="true"><i class="fas fa-tower-broadcast"></i></span>
                        <span>&copy; 2026 AlarmBridge</span>
                    </div>
                </div>
                <div class="col-md-6 text-end">
                    <a asp-area="" asp-page="/About" class="text-decoration-none">About</a>
                    <span class="mx-2">•</span>
                    <a href="/health" class="text-decoration-none" target="_blank">System Status</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Global toast container -->
    <div id="toastContainer" class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index:1100"></div>

    <!-- Global confirm modal -->
    <div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold text-danger" id="confirmModalTitle"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-muted" id="confirmModalBody"></div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times me-1"></i>Cancel
                    </button>
                    <button type="button" class="btn btn-danger" id="confirmModalOk">
                        <i class="fas fa-trash me-1"></i>Delete
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/main.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
