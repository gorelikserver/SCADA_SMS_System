@page
@model SCADASMSSystem.Web.Pages.Alarms.ManageGroupsModel
@{
    ViewData["Title"] = "Routing Rules";
    var visibleAlarms = Model.AlarmAssignments.ToList();
    var mappedAlarms = visibleAlarms.Count(alarm => alarm.AssignedGroups != null && alarm.AssignedGroups.Any());
    var unmappedAlarms = visibleAlarms.Count - mappedAlarms;
    var availableTeams = Model.AllGroups.Count();
}

@section Breadcrumb {
<div class="breadcrumb-bar">
    <div class="container-fluid px-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-page="/Index"><i class="fas fa-home me-1"></i>Overview</a></li>
                <li class="breadcrumb-item active">Routing Rules</li>
            </ol>
        </nav>
    </div>
</div>
}

<div class="container-fluid py-4 routing-workspace">
    <div class="row">
        <div class="col-12">
            <div class="workspace-heading">
                <div>
                    <span class="workspace-kicker">Routing</span>
                    <h1>Routing rules</h1>
                    <p>Connect every SCADA alarm to the notification teams responsible for receiving its SMS alerts.</p>
                </div>
                <a asp-page="/Groups/Index" class="btn btn-outline-primary">
                    <i class="fas fa-users me-2"></i>Notification teams
                </a>
            </div>

            <!-- Toast triggers from server messages -->
            @if (TempData["SuccessMessage"] != null)
            {
                <span class="d-none" data-toast-success="@TempData["SuccessMessage"]"></span>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <span class="d-none" data-toast-error="@TempData["ErrorMessage"]"></span>
            }

            <div class="routing-metrics" aria-label="Routing summary">
                <div><span>Matching alarms</span><strong>@Model.TotalItems</strong><small>Across this search</small></div>
                <div class="is-ready"><span>Routed on this page</span><strong>@mappedAlarms</strong><small>SMS teams assigned</small></div>
                <div class="is-warning"><span>Delivery risks</span><strong>@unmappedAlarms</strong><small>Unmapped on this page</small></div>
                <div><span>Available teams</span><strong>@availableTeams</strong><small>Ready to receive routes</small></div>
            </div>

            <div class="routing-filter-panel">
                <div class="panel-heading">
                    <div><span>Find a route</span><strong>Search SCADA alarms</strong></div>
                </div>
                <div class="routing-filter-body">
                    <form method="get" class="row g-3">
                        <div class="col-md-7">
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="fas fa-search"></i>
                                </span>
                                <input type="text" 
                                       class="form-control" 
                                       name="searchTerm" 
                                       value="@Model.SearchTerm" 
                                       placeholder="Search block, alarm ID or description" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <select name="pageSize" class="form-select" onchange="this.form.submit()">
                                <option value="10" selected="@(Model.PageSize == 10)">10 per page</option>
                                <option value="25" selected="@(Model.PageSize == 25)">25 per page</option>
                                <option value="50" selected="@(Model.PageSize == 50)">50 per page</option>
                                <option value="100" selected="@(Model.PageSize == 100)">100 per page</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="fas fa-search me-2"></i>Search
                            </button>
                        </div>
                        <input type="hidden" name="page" value="1" />
                    </form>
                </div>
            </div>

            <div class="card routing-table-panel">
                <div class="card-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="fas fa-route me-2"></i>
                            Alarm routes
                        </h5>
                        <span class="badge bg-primary">
                            Showing @visibleAlarms.Count of @Model.TotalItems
                            @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                            {
                                <text>(filtered)</text>
                            }
                        </span>
                    </div>
                </div>
                <div class="card-body p-0">
                    @if (!Model.AlarmAssignments.Any())
                    {
                        <div class="alert alert-info m-4">
                            <i class="fas fa-info-circle me-2"></i>
                            No alarm routes found. @(!string.IsNullOrWhiteSpace(Model.SearchTerm) ? "Try a different search term." : "")
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover routing-table mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 15%;">SCADA alarm</th>
                                        <th style="width: 15%;">Alarm ID</th>
                                        <th style="width: 25%;">Description</th>
                                        <th style="width: 20%;">Notification teams</th>
                                        <th style="width: 15%;">Last changed</th>
                                        <th style="width: 10%;" class="text-center">Route</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var alarm in Model.AlarmAssignments)
                                    {
                                        <tr class="@(alarm.AssignedGroups == null || !alarm.AssignedGroups.Any() ? "route-unmapped" : "")">
                                            <td>
                                                <span class="block-name" dir="auto">@alarm.BlockName</span>
                                                @if (!alarm.IsActive)
                                                {
                                                    <span class="badge bg-secondary ms-2">Inactive</span>
                                                }
                                            </td>
                                            <td>
                                                <code>@(alarm.AlarmId ?? "N/A")</code>
                                            </td>
                                            <td>
                                                <small class="text-muted" dir="auto">
                                                    @(alarm.AlarmDescription ?? "No description")
                                                </small>
                                            </td>
                                            <td>
                                                @if (alarm.AssignedGroups != null && alarm.AssignedGroups.Any())
                                                {
                                                    foreach (var group in alarm.AssignedGroups)
                                                    {
                                                        <span class="route-team-chip" dir="auto">
                                                            <i class="fas fa-users me-1"></i>
                                                            @group.GroupName
                                                        </span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="route-unmapped-label">
                                                        <i class="fas fa-exclamation-triangle me-1"></i>
                                                        No notification teams
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                @if (alarm.LastModified.HasValue)
                                                {
                                                    <small>
                                                        @alarm.LastModified.Value.ToString("dd/MM/yyyy HH:mm")
                                                        @if (!string.IsNullOrWhiteSpace(alarm.ModifiedBy))
                                                        {
                                                            <br /><span class="text-muted">by @alarm.ModifiedBy</span>
                                                        }
                                                    </small>
                                                }
                                                else
                                                {
                                                    <small class="text-muted">Never modified</small>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <button type="button" 
                                                        class="btn btn-sm btn-primary" 
                                                        data-bs-toggle="modal" 
                                                        data-bs-target="#manageGroupModal"
                                                        onclick="openManageGroupModal(@alarm.BlockId, '@alarm.BlockName', [@string.Join(",", alarm.AssignedGroupIds)])">
                                                    <i class="fas fa-edit me-1"></i>
                                                    Edit route
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination -->
                        @if (Model.TotalPages > 1)
                        {
                            <div class="card-footer">
                                <nav aria-label="Alarm pagination">
                                    <ul class="pagination justify-content-center mb-0">
                                        <!-- First Page -->
                                        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                            <a class="page-link" href="?page=1&pageSize=@Model.PageSize@(string.IsNullOrWhiteSpace(Model.SearchTerm) ? "" : "&searchTerm=" + Uri.EscapeDataString(Model.SearchTerm))" aria-label="First">
                                                <span aria-hidden="true">&laquo;&laquo;</span>
                                            </a>
                                        </li>

                                        <!-- Previous Page -->
                                        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                            <a class="page-link" href="?page=@(Model.CurrentPage - 1)&pageSize=@Model.PageSize@(string.IsNullOrWhiteSpace(Model.SearchTerm) ? "" : "&searchTerm=" + Uri.EscapeDataString(Model.SearchTerm))" aria-label="Previous">
                                                <span aria-hidden="true">&laquo;</span>
                                            </a>
                                        </li>

                                        <!-- Page Numbers -->
                                        @{
                                            var startPage = Math.Max(1, Model.CurrentPage - 2);
                                            var endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
                                        }

                                        @if (startPage > 1)
                                        {
                                            <li class="page-item disabled">
                                                <span class="page-link">...</span>
                                            </li>
                                        }

                                        @for (var i = startPage; i <= endPage; i++)
                                        {
                                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                                <a class="page-link" href="?page=@i&pageSize=@Model.PageSize@(string.IsNullOrWhiteSpace(Model.SearchTerm) ? "" : "&searchTerm=" + Uri.EscapeDataString(Model.SearchTerm))">@i</a>
                                            </li>
                                        }

                                        @if (endPage < Model.TotalPages)
                                        {
                                            <li class="page-item disabled">
                                                <span class="page-link">...</span>
                                            </li>
                                        }

                                        <!-- Next Page -->
                                        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                            <a class="page-link" href="?page=@(Model.CurrentPage + 1)&pageSize=@Model.PageSize@(string.IsNullOrWhiteSpace(Model.SearchTerm) ? "" : "&searchTerm=" + Uri.EscapeDataString(Model.SearchTerm))" aria-label="Next">
                                                <span aria-hidden="true">&raquo;</span>
                                            </a>
                                        </li>

                                        <!-- Last Page -->
                                        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                            <a class="page-link" href="?page=@Model.TotalPages&pageSize=@Model.PageSize@(string.IsNullOrWhiteSpace(Model.SearchTerm) ? "" : "&searchTerm=" + Uri.EscapeDataString(Model.SearchTerm))" aria-label="Last">
                                                <span aria-hidden="true">&raquo;&raquo;</span>
                                            </a>
                                        </li>
                                    </ul>
                                </nav>
                                <div class="text-center mt-2">
                                    <small class="text-muted">
                                        Page @Model.CurrentPage of @Model.TotalPages 
                                        (Showing @((Model.CurrentPage - 1) * Model.PageSize + 1)-@Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalItems) of @Model.TotalItems alarms)
                                    </small>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="manageGroupModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header routing-modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-route me-2"></i>
                    Edit routing rule
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="BulkUpdate" id="manageGroupForm">
                <div class="modal-body">
                    <input type="hidden" name="blockId" id="modalBlockId" />
                    
                    <div class="alert alert-info routing-rule-summary">
                        <i class="fas fa-bell me-2"></i>
                        <strong>SCADA alarm:</strong> <span id="modalBlockName" dir="auto"></span>
                        <br />
                        <small>Select the notification teams that should receive SMS alerts when this alarm is triggered.</small>
                    </div>

                    <h6 class="mb-3">Notification teams</h6>
                    
                    <div class="list-group" id="groupCheckboxList">
                        @foreach (var group in Model.AllGroups)
                        {
                            <label class="list-group-item list-group-item-action routing-team-option">
                                <div class="d-flex align-items-center">
                                    <input class="form-check-input me-2 group-checkbox" 
                                           type="checkbox" 
                                           name="selectedGroupCheckbox" 
                                           value="@group.GroupId" />
                                    <div class="flex-grow-1">
                                        <strong dir="auto">@group.GroupName</strong>
                                        <br />
                                        <small class="text-muted">
                                            <i class="fas fa-users me-1"></i>
                                            @group.GroupMembers.Count() member(s)
                                        </small>
                                    </div>
                                </div>
                            </label>
                        }
                    </div>

                    @if (!Model.AllGroups.Any())
                    {
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            No notification teams are available. Create a team before assigning this route.
                        </div>
                    }

                    <div class="mt-3">
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="clearAllGroups()">
                            <i class="fas fa-times-circle me-1"></i>
                            Remove all teams
                        </button>
                        <small class="routing-danger-note ms-2">
                            <i class="fas fa-exclamation-triangle"></i>
                            SMS delivery will be disabled for this alarm. Other alarm actions remain unchanged.
                        </small>
                    </div>

                    <input type="hidden" name="selectedGroups" id="selectedGroupsInput" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times me-2"></i>Cancel
                    </button>
                    <button type="button" class="btn btn-primary" id="saveGroupsBtn"
                            onclick="prepareGroupSubmission(event)">
                        <i class="fas fa-save me-2"></i>Save routing rule
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openManageGroupModal(blockId, blockName, currentGroupIds) {
            // Set modal title and hidden field
            document.getElementById('modalBlockId').value = blockId;
            document.getElementById('modalBlockName').textContent = blockName;

            // Select the current group checkboxes
            var checkboxes = document.querySelectorAll('.group-checkbox');
            checkboxes.forEach(function(checkbox) {
                var groupId = parseInt(checkbox.value);
                checkbox.checked = currentGroupIds.includes(groupId);
            });
        }

        function clearAllGroups() {
            // Uncheck all checkboxes
            var checkboxes = document.querySelectorAll('.group-checkbox');
            checkboxes.forEach(function(checkbox) {
                checkbox.checked = false;
            });
            
            // Highlight that all teams were cleared
            var alertDiv = document.querySelector('#manageGroupModal .alert-info');
            alertDiv.classList.remove('alert-info');
            alertDiv.classList.add('alert-warning');
            alertDiv.innerHTML = '<i class="fas fa-exclamation-triangle me-2"></i><strong>SMS delivery will be disabled for this alarm.</strong><br /><small>No notification teams are selected. Other alarm actions remain unchanged.</small>';
            
            // Reset after 3 seconds
            setTimeout(function() {
                alertDiv.classList.remove('alert-warning');
                alertDiv.classList.add('alert-info');
                alertDiv.innerHTML = '<i class="fas fa-bell me-2"></i><strong>SCADA alarm:</strong> <span id="modalBlockName" dir="auto">' +
                    document.getElementById('modalBlockName').textContent +
                    '</span><br /><small>Select the notification teams that should receive SMS alerts when this alarm is triggered.</small>';
            }, 3000);
        }

        async function prepareGroupSubmission(e) {
            e.preventDefault();
            var checkedBoxes = document.querySelectorAll('.group-checkbox:checked');
            var selectedGroupIds = Array.from(checkedBoxes).map(cb => cb.value);
            document.getElementById('selectedGroupsInput').value = selectedGroupIds.join(',');

            if (selectedGroupIds.length === 0) {
                const confirmed = await SCADAUtils.confirmModal(
                    'Disable SMS delivery?',
                    'No notification teams are selected. Saving will disable SMS delivery for this alarm; other alarm actions will remain unchanged.',
                    'Disable SMS delivery',
                    'btn-warning'
                );
                if (!confirmed) return;
            }

            const saveBtn = document.getElementById('saveGroupsBtn');
            SCADAUtils.setButtonLoading(saveBtn, true, 'Saving...');
            document.getElementById('manageGroupForm').submit();
        }

        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('[data-toast-success]').forEach(el =>
                SCADAUtils.showToast('<i class="fas fa-check-circle me-2"></i>' + el.dataset.toastSuccess, 'success'));
            document.querySelectorAll('[data-toast-error]').forEach(el =>
                SCADAUtils.showToast('<i class="fas fa-exclamation-circle me-2"></i>' + el.dataset.toastError, 'danger'));
        });
    </script>
}
